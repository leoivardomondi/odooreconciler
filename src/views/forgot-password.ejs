<%- include('partials/head') %>

<main class="container py-5" style="max-width: 560px;">
  <div class="card shadow-sm border-0 app-card">
    <div class="card-body p-4 p-lg-5">
      <p class="eyebrow">Account recovery</p>
      <h1 class="h2 mb-2">Reset your password</h1>
      <p class="text-secondary mb-4">We will verify your work email before allowing a new password.</p>
      <%- include('partials/alerts', { status, validationErrors }) %>

      <% if (!form.codeSent) { %>
        <form method="post" action="/auth/request-password-reset" data-disable-submit="true" data-loading-message="Sending reset code..." class="vstack gap-3">
          <div>
            <label class="form-label" for="resetEmail">Work email</label>
            <input id="resetEmail" type="email" class="form-control" name="email" value="<%= form.email %>" autocomplete="email" required />
          </div>
          <button class="btn btn-primary" type="submit">Send Reset Code</button>
        </form>
      <% } else { %>
        <form method="post" action="/auth/reset-password" data-disable-submit="true" data-loading-message="Changing password..." class="vstack gap-3">
          <input type="hidden" name="email" value="<%= form.email %>" />
          <div>
            <label class="form-label" for="resetCode">Six-digit email code</label>
            <input id="resetCode" class="form-control" name="otpCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required />
          </div>
          <div>
            <label class="form-label" for="newPassword">New password</label>
            <input id="newPassword" type="password" class="form-control" name="password" minlength="8" autocomplete="new-password" required />
          </div>
          <div>
            <label class="form-label" for="newPasswordConfirmation">Confirm new password</label>
            <input id="newPasswordConfirmation" type="password" class="form-control" name="passwordConfirmation" minlength="8" autocomplete="new-password" required />
          </div>
          <button class="btn btn-primary" type="submit">Change Password</button>
        </form>
      <% } %>

      <a href="/login" class="btn btn-link px-0 mt-3">Back to sign in</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
