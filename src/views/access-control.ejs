<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const eventStatusClass = (event) => event.eventType === 'logout' ? 'secondary' : event.success ? 'success' : 'danger';
%>

<main class="container py-4 py-lg-5">
  <section class="hero-panel mb-4">
    <div>
      <p class="eyebrow">Security</p>
      <h1 class="display-6 mb-2">Access Control</h1>
      <p class="lead text-secondary mb-0">Select one user, edit their access points, then save once at the bottom.</p>
    </div>
    <div class="meta-card">
      <span class="meta-label">Approved users</span>
      <strong><%= users.length %></strong>
      <div class="small text-secondary mt-2">Feature-based access and account activity.</div>
    </div>
  </section>

  <form method="post" action="/settings/access/sync-names" class="d-flex justify-content-end mb-3" data-disable-submit="true" data-loading-message="Saving Odoo employee names locally...">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
    <button type="submit" class="btn btn-outline-primary">Sync User Names from Odoo</button>
  </form>

  <%- include('partials/alerts', { status, validationErrors }) %>

  <div class="card shadow-sm border-0 app-card mb-4">
    <div class="card-body p-4">
      <form method="get" action="/settings/access" class="row g-3 align-items-end">
        <div class="col-lg-9">
          <label class="form-label" for="accessUserSelect">Select user to edit</label>
          <select id="accessUserSelect" class="form-select" name="user" onchange="this.form.submit()">
            <option value="">Add a new user</option>
            <% users.forEach((user) => { %>
              <option value="<%= user.email %>" <%= selectedEmail === user.email ? 'selected' : '' %>><%= user.email %> — <%= getAuthRoleLabel(user.role) %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-lg-3 d-grid">
          <button class="btn btn-outline-primary" type="submit">Open User</button>
        </div>
      </form>
      <% if (selectedUser) { %>
        <div class="small text-secondary mt-3">
          Last online: <strong><%= lastSeenByEmail[selectedUser.email] ? formatDateTime(lastSeenByEmail[selectedUser.email]) : 'Never' %></strong>
          · Password: <strong><%= selectedUser.hasPassword ? 'Set' : 'Not set' %></strong>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-card">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
        <div>
          <h2 class="h4 mb-1"><%= selectedUser ? 'Edit User Access' : 'Add New User' %></h2>
          <p class="text-secondary mb-0"><%= selectedUser ? selectedUser.email : 'Create an approved account and assign its access points.' %></p>
        </div>
        <% if (selectedUser && authUser && authUser.role === 'admin') { %>
          <form method="post" action="/settings/access/login-as">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
            <input type="hidden" name="email" value="<%= selectedUser.email %>" />
            <button type="submit" class="btn btn-outline-secondary">Login As User</button>
          </form>
        <% } %>
      </div>

      <form method="post" action="/settings/access" class="vstack gap-4" data-disable-submit="true" data-loading-message="Saving user access...">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
        <div class="row g-3">
          <div class="col-lg-8">
            <label class="form-label">Work Email</label>
            <input type="email" class="form-control" name="email" value="<%= form.email %>" <%= selectedUser ? 'readonly' : '' %> required />
          </div>
          <div class="col-lg-4">
            <label class="form-label">Role</label>
            <select class="form-select" name="role">
              <option value="user" <%= form.role === 'user' ? 'selected' : '' %>>User</option>
              <option value="admin" <%= form.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
        </div>

        <div>
          <label class="form-label d-block">Access Points</label>
          <div class="row g-2">
            <% availableApps.forEach((app) => { %>
              <div class="col-sm-6 col-lg-4">
                <label class="border rounded-3 p-3 d-flex gap-2 align-items-center h-100 bg-light" for="access-app-<%= app %>">
                  <input id="access-app-<%= app %>" class="form-check-input mt-0" type="checkbox" name="apps" value="<%= app %>" <%= (form.apps || []).includes(app) ? 'checked' : '' %> />
                  <span class="fw-medium"><%= app %></span>
                </label>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="row g-3 align-items-end">
          <div class="col-lg-8">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" name="password" minlength="<%= passwordMinLength %>" autocomplete="new-password" placeholder="<%= selectedUser && selectedUser.hasPassword ? 'Leave blank to keep current password' : 'Set password' %>" />
            <div class="form-text">Use at least <%= passwordMinLength %> characters. Leave blank to keep the existing password.</div>
          </div>
          <div class="col-lg-4">
            <div class="form-check form-switch border rounded-3 p-3 ps-5">
              <input class="form-check-input" type="checkbox" name="active" id="accessActive" <%= form.active ? 'checked' : '' %> />
              <label class="form-check-label fw-medium" for="accessActive">Account active</label>
            </div>
          </div>
        </div>

        <div class="border-top pt-4 d-flex justify-content-end">
          <button type="submit" class="btn btn-primary px-4">Save User Access</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-card mt-4">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
          <h2 class="h5 mb-1">User Activity</h2>
          <p class="text-secondary small mb-0">Sign-ins, sign-outs, page access, submissions, password resets, IP addresses, and last activity.</p>
        </div>
        <span class="badge text-bg-light"><%= loginEvents.length %> recent event(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table align-middle mobile-card-table">
          <thead><tr><th>Time</th><th>User</th><th>Event</th><th>IP</th><th>Location</th><th>Detail</th></tr></thead>
          <tbody>
            <% if (!loginEvents.length) { %><tr><td colspan="6" class="text-secondary text-center py-4">No user activity recorded yet.</td></tr><% } %>
            <% loginEvents.forEach((event) => { %>
              <tr>
                <td data-label="Time"><strong><%= formatDateTime(event.createdAt) %></strong></td>
                <td data-label="User"><strong><%= event.email ? (displayNamesByEmail[event.email] || event.email) : 'Unknown user' %></strong><% if (event.email && displayNamesByEmail[event.email]) { %><div class="small text-muted"><%= event.email %></div><% } %></td>
                <td data-label="Event"><span class="badge text-bg-<%= eventStatusClass(event) %>"><%= event.eventType %></span></td>
                <td data-label="IP"><code><%= event.ipAddress || 'unknown' %></code></td>
                <td data-label="Location"><%= event.locationLabel || 'Unknown' %></td>
                <td data-label="Detail"><span title="<%= event.userAgent || '' %>"><%= event.detail || '—' %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
