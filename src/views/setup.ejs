<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container py-4 py-lg-5">
  <section class="hero-panel mb-4">
    <div>
      <p class="eyebrow">Setup</p>
      <h1 class="display-6 mb-2">Connect any Odoo 19 instance without hardcoding</h1>
      <p class="lead text-secondary mb-0">
        Store credentials securely, test the JSON-2 connection, and keep the rest of the app driven from these settings.
      </p>
    </div>
    <div class="hero-meta">
      <div class="meta-card">
        <span class="meta-label">Saved Base URL</span>
        <strong><%= maskedOdoo.baseUrl || 'Not configured yet' %></strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Stored API Key</span>
        <strong><%= form.hasStoredApiKey ? 'Available' : 'Not stored' %></strong>
      </div>
    </div>
  </section>

  <%- include('partials/alerts', { status, validationErrors }) %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0 app-card">
        <div class="card-body p-4">
          <form method="post" action="/setup" class="row g-3" autocomplete="off">
            <div class="col-12">
              <label class="form-label">Odoo Base URL</label>
              <input
                type="url"
                class="form-control"
                name="baseUrl"
                value="<%= form.baseUrl %>"
                placeholder="https://your-odoo-domain.com"
                required
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Database</label>
              <input
                type="text"
                class="form-control"
                name="database"
                value="<%= form.database %>"
                placeholder="Leave blank if not required"
              />
              <div class="form-text">Sent as <code>X-Odoo-Database</code> when provided.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input
                type="text"
                class="form-control"
                name="username"
                value="<%= form.username %>"
                placeholder="api.user@example.com"
                required
              />
            </div>
            <div class="col-12">
              <label class="form-label">API Key</label>
              <input
                type="password"
                class="form-control"
                name="apiKey"
                data-clear-sensitive-field="true"
                autocomplete="new-password"
                autocapitalize="off"
                spellcheck="false"
                placeholder="<%= form.hasStoredApiKey ? 'Leave blank to keep the stored API key' : 'Paste a new Odoo API key' %>"
              />
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearStoredApiKey" id="clearStoredApiKey" <%= form.clearStoredApiKey ? 'checked' : '' %> />
                <label class="form-check-label" for="clearStoredApiKey">
                  Clear stored API key
                </label>
              </div>
              <div class="form-text">The API key is encrypted at rest using <code>APP_ENCRYPTION_KEY</code>.</div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
              <button type="submit" class="btn btn-primary px-4">Save Setup</button>
              <button
                type="submit"
                class="btn btn-outline-secondary"
                formaction="/setup/test-connection"
                formmethod="post"
              >
                Test Connection
              </button>
              <a href="/dashboard" class="btn btn-link text-decoration-none">Open Dashboard</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm border-0 app-card h-100">
        <div class="card-body p-4">
          <h2 class="h5 mb-3">Current Status</h2>
          <dl class="row small mb-4">
            <dt class="col-5 text-secondary">Status</dt>
            <dd class="col-7"><span class="badge text-bg-<%= connection.status === 'success' ? 'success' : connection.status === 'error' ? 'danger' : 'secondary' %>"><%= connection.status %></span></dd>
            <dt class="col-5 text-secondary">Checked</dt>
            <dd class="col-7"><%= formatDateTime(connection.checkedAt) %></dd>
            <dt class="col-5 text-secondary">Version</dt>
            <dd class="col-7"><%= connection.version || '—' %></dd>
          </dl>

          <h3 class="h6 text-uppercase text-secondary">Why this page matters</h3>
          <ul class="list-unstyled small mb-0 soft-list">
            <li>Every Odoo connection value is editable from the UI.</li>
            <li>Nothing in the app is tied to one server, database, or custom field name.</li>
            <li>Once this passes, Sales Order search and extraction are ready to use.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
