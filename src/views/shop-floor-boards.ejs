    var requirementsContainer = document.getElementById('customerRequirementsContainer');
    var requirementsList = document.getElementById('customerRequirementsList');

    function clearRequirements() {
      if (requirementsContainer) {
        requirementsContainer.classList.add('d-none');
      }
      if (requirementsList) {
        requirementsList.innerHTML = '';
      }
    }

    function fetchRequirements(partnerId) {
      clearRequirements();
      
      fetch('/shop-floor/boards/requirements?partner_id=' + partnerId)
        .then(function(res) {
          if (!res.ok) throw new Error('Failed to fetch');
          return res.json();
        })
        .then(function(data) {
          if (data && data.length > 0) {
            requirementsContainer.classList.remove('d-none');
            data.forEach(function(req) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'btn btn-white border text-start p-2 rounded-3 w-100 requirement-btn';
              btn.style.fontSize = '0.82rem';
              btn.style.transition = 'all 0.2s';
              btn.style.backgroundColor = '#ffffff';
              btn.style.borderColor = '#cbd5e1';
              btn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.05)';
              
              btn.setAttribute('data-product-id', req.productId);
              btn.setAttribute('data-product-name', req.productName);
              btn.setAttribute('data-qty', req.qtyMissing);

              btn.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="fw-bold text-dark" style="font-size: 0.8rem;">${req.moName}</span>
                  <span class="badge rounded-pill px-2 py-1" style="background-color: #e0e7ff; color: #4f46e5; font-size: 0.68rem; font-weight: 600;">
                    Needs ${req.qtyMissing} units
                  </span>
                </div>
                <div class="text-muted small mb-1" style="font-size: 0.78rem;">
                  <strong>Required Board:</strong> ${req.productName}
                </div>
                <div class="text-indigo fw-semibold mt-1 d-flex align-items-center gap-1" style="font-size: 0.74rem; text-decoration: underline; color: #4f46e5;">
                  <span>⚡</span> Click to auto-fill this Board Type & Qty
                </div>
              `;

              btn.addEventListener('click', function() {
                // Populate product select combobox
                var productList = document.getElementById('productList');
                var productItem = Array.from(productList.querySelectorAll('.combobox-item')).find(function(item) {
                  return item.getAttribute('data-id') === String(req.productId);
                });

                if (productItem) {
                  var productInput = document.getElementById('productSearch');
                  var productHidden = document.getElementById('productSelect');
                  
                  productHidden.value = req.productId;
                  productInput.value = req.productName;
                  productInput.classList.remove('is-invalid');
                  
                  productList.querySelectorAll('.combobox-item').forEach(function(i) {
                    i.classList.remove('selected');
                  });
                  productItem.classList.add('selected');

                  // Populate quantity
                  var qtyInput = document.getElementById('intakeQty');
                  if (qtyInput) {
                    qtyInput.value = req.qtyMissing;
                    qtyInput.classList.remove('is-invalid');
                  }

                  // Update stock display helper
                  var available = parseFloat(productItem.getAttribute('data-qty') || '0');
                  var stockHelp = document.getElementById('qtyCurrentStock');
                  if (stockHelp) {
                    stockHelp.innerHTML = '<strong>Current stock in Odoo:</strong> ' + available + ' units. Your intake will add to this.';
                    stockHelp.style.color = '#475569';
                    stockHelp.style.display = 'block';
                  }
                } else {
                  // Fallback: If not in categories, populate search input and hidden value anyway
                  var productInput = document.getElementById('productSearch');
                  var productHidden = document.getElementById('productSelect');
                  
                  productHidden.value = req.productId;
                  productInput.value = req.productName;
                  productInput.classList.remove('is-invalid');

                  var qtyInput = document.getElementById('intakeQty');
                  if (qtyInput) {
                    qtyInput.value = req.qtyMissing;
                    qtyInput.classList.remove('is-invalid');
                  }
                }
              });

              requirementsList.appendChild(btn);
            });
          }
        })
        .catch(function(err) {
          console.error('Failed to load board requirements:', err);
        });
    }

    // Auto-fill form from Stock Needed records
    document.querySelectorAll('.auto-fill-stock-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var client = btn.getAttribute('data-client') || '';
        var partnerId = btn.getAttribute('data-partner-id') || '';
        var component = btn.getAttribute('data-component') || '';
        var productId = btn.getAttribute('data-product-id') || '';
        var qty = btn.getAttribute('data-qty') || '';

        // 1. Populate Client
        var partnerSearch = document.getElementById('partnerSearch');
        var partnerSelect = document.getElementById('partnerSelect');
        var partnerName = document.getElementById('partnerName');

        if (partnerSearch && partnerSelect) {
          partnerSearch.value = client;
          if (partnerName) partnerName.value = client;
          partnerSelect.value = partnerId;
          partnerSearch.classList.remove('is-invalid');
          var partnerFeedback = document.getElementById('partnerFeedback');
          if (partnerFeedback) partnerFeedback.style.display = 'none';

          // If partnerId was missing in alert data, look it up from client list
          if (!partnerId) {
            var partnerMatch = Array.from(document.querySelectorAll('#partnerList .combobox-item')).find(function(item) {
              var name = item.getAttribute('data-name') || item.textContent.trim();
              return name.toLowerCase() === client.toLowerCase();
            });
            if (partnerMatch) {
              partnerId = partnerMatch.getAttribute('data-id') || '';
              partnerSelect.value = partnerId;
            }
          }

          if (partnerId) {
