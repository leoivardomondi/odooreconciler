      } else {
        clearRequirements();
      }
    });
    
    var qtyInput = document.getElementById('intakeQty');
    var stockHelp = document.getElementById('qtyCurrentStock');
    
    setupCombobox('productCombobox', 'productSearch', 'productSelect', 'productList', function(selectedItem) {
      var productName = document.getElementById('productName');
      if (productName) productName.value = selectedItem ? (selectedItem.querySelector('.product-name')?.textContent.trim() || selectedItem.textContent.trim()) : '';
