          }
        }

        // 2. Populate Board Type
        var productSearch = document.getElementById('productSearch');
        var productSelect = document.getElementById('productSelect');
        var productName = document.getElementById('productName');
        var productList = document.getElementById('productList');

        if (productSearch && productSelect) {
          productSearch.value = component;
          if (productName) productName.value = component;
          productSelect.value = productId;
          productSearch.classList.remove('is-invalid');
          var productFeedback = document.getElementById('productFeedback');
          if (productFeedback) productFeedback.style.display = 'none';

          var productItem = null;
          if (productList) {
            var items = Array.from(productList.querySelectorAll('.combobox-item'));
            if (productId) {
              productItem = items.find(function(i) {
                return i.getAttribute('data-id') === String(productId);
              });
            }
            if (!productItem && component) {
              productItem = items.find(function(i) {
                var nameSpan = i.querySelector('.product-name');
                var text = nameSpan ? nameSpan.textContent.trim() : i.textContent.trim();
                return text.toLowerCase() === component.toLowerCase();
              });
            }

            if (productItem) {
              items.forEach(function(i) { i.classList.remove('selected'); });
              productItem.classList.add('selected');
              productSelect.value = productItem.getAttribute('data-id');

              var available = parseFloat(productItem.getAttribute('data-qty') || '0');
              var stockHelp = document.getElementById('qtyCurrentStock');
              if (stockHelp) {
                stockHelp.innerHTML = '<strong>Current stock in Odoo:</strong> ' + available + ' units. Your intake will add to this.';
                stockHelp.style.color = '#475569';
                stockHelp.style.display = 'block';
              }
            }
          }
        }

        // 3. Populate Quantity (Strictly whole boards only)
        var intakeQty = document.getElementById('intakeQty');
        if (intakeQty) {
          var cleanQty = Math.max(1, Math.round(parseFloat(qty || '1')));
          intakeQty.value = cleanQty;
          intakeQty.classList.remove('is-invalid');
          var qtyFeedback = document.getElementById('qtyFeedback');
          if (qtyFeedback) qtyFeedback.style.display = 'none';
        }

        // 4. Visual feedback: Pulse highlight on inputs
        [partnerSearch, productSearch, intakeQty].forEach(function(el) {
          if (el) {
            el.style.transition = 'background-color 0.3s, box-shadow 0.3s';
            el.style.backgroundColor = '#ecfdf5';
            el.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.25)';
            setTimeout(function() {
              el.style.backgroundColor = '';
              el.style.boxShadow = '';
            }, 1500);
          }
        });

        // 5. Button feedback
        var originalContent = btn.innerHTML;
        btn.innerHTML = '<span>✓ Populated!</span>';
        btn.style.background = '#15803d';
        setTimeout(function() {
          btn.innerHTML = originalContent;
          btn.style.background = '#16a34a';
        }, 1200);

        // 6. Smooth scroll to the intake form
        var intakeForm = document.getElementById('intakeForm');
        if (intakeForm) {
          intakeForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });


    // Auto-focus smoothly on still undone logs if any exist
    function focusOnStillUndoneLogs() {
      if (window.location.hash && window.location.hash !== '#stockNeededSection') return;
      var firstUndone = document.querySelector('.stock-alert-item.item-undone');
      if (firstUndone) {
        firstUndone.scrollIntoView({ behavior: 'smooth', block: 'center' });
        firstUndone.style.transition = 'background-color 0.5s ease';
        firstUndone.style.backgroundColor = 'rgba(254, 215, 170, 0.45)';
        setTimeout(function() {
          firstUndone.style.backgroundColor = '';
        }, 2200);
      }
    }
    focusOnStillUndoneLogs();

    // Form submission spinner state & validation overrides
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Background poller for board logs syncing with Odoo
    var pendingLogIds = new Set();
    var pollInterval = null;

    function trackPendingBoardLog(id) {
      if (!id) return;
      pendingLogIds.add(String(id));
      if (!pollInterval) {
        pollInterval = window.setInterval(pollPendingBoardLogs, 3500);
      }
    }

    async function pollPendingBoardLogs() {
      if (pendingLogIds.size === 0) {
        if (pollInterval) {
          window.clearInterval(pollInterval);
          pollInterval = null;
        }
        return;
      }
      var ids = Array.from(pendingLogIds).join(',');
      try {
        var res = await fetch('/shop-floor/board-intake/status?ids=' + encodeURIComponent(ids));
        if (!res.ok) return;
        var data = await res.json();
        if (!data.ok || !Array.isArray(data.entries)) return;
        data.entries.forEach(function(entry) {
          if (!entry || !entry.id) return;
          var badge = document.querySelector('[data-board-log-status="' + entry.id + '"]');
          if (badge) {
            if (entry.status === 'synced') {
              badge.className = 'badge rounded-pill bg-success-subtle text-success';
              badge.textContent = 'Synced to Odoo';
              var retryForm = document.querySelector('.board-retry-form[data-intake-id="' + entry.id + '"]');
              if (retryForm) retryForm.remove();
              pendingLogIds.delete(String(entry.id));

              // Also update any matching locked alert items to indicate completion
              var syncedPartnerName = (entry.customer_name || '').toLowerCase().trim();
              var syncedProductName = (entry.product_name || '').toLowerCase().trim();
              document.querySelectorAll('.stock-alert-item.item-syncing-locked').forEach(function(itemEl) {
                var client = (itemEl.getAttribute('data-client') || '').toLowerCase().trim();
                var comp = (itemEl.getAttribute('data-component') || '').toLowerCase().trim();
                if (syncedPartnerName && client && (client.includes(syncedPartnerName) || syncedPartnerName.includes(client)) &&
                    syncedProductName && comp && (comp.includes(syncedProductName) || syncedProductName.includes(comp))) {
                  var actionContainer = itemEl.querySelector('.action-container');
                  if (actionContainer) {
                    actionContainer.innerHTML = '<span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size:0.72rem">✓ Synced &amp; Reserved</span>';
                  }
                }
              });
            } else if (entry.status === 'failed') {
              badge.className = 'badge rounded-pill bg-danger-subtle text-danger';
              badge.textContent = 'Sync failed';
              badge.title = entry.error_message || '';
              pendingLogIds.delete(String(entry.id));
            } else if (entry.status === 'reverted') {
              badge.className = 'badge rounded-pill bg-secondary-subtle text-secondary';
              badge.textContent = 'Reverted in Odoo';
              pendingLogIds.delete(String(entry.id));

              // Update the revert button/form to completed state
              var revertForm = document.querySelector('.board-revert-form[data-intake-id="' + entry.id + '"]');
              if (revertForm) {
                revertForm.innerHTML = '<span class="badge rounded-pill bg-secondary-subtle text-secondary border px-2.5 py-1" style="font-size:0.75rem">✓ Reverted</span>';
              }
              var card = badge.closest('.border.rounded-4') || badge.closest('.card') || badge.parentElement.parentElement;
              if (card) {
                card.style.opacity = '0.65';
              }
            } else if (entry.status === 'reverting') {
              badge.className = 'badge rounded-pill bg-warning-subtle text-warning-emphasis';
              badge.textContent = 'Reverting in background...';
            }
          }
        });
      } catch (_e) {}
    }

    // Check on page load for any pending logs and dynamically hydrate recent list from MySQL
    document.querySelectorAll('[data-board-log-status]').forEach(function(el) {
      var txt = (el.textContent || '').trim();
      if (txt === 'Syncing' || txt === 'Syncing to Odoo' || txt === 'Reverting') {
        var id = el.getAttribute('data-board-log-status');
        if (id) trackPendingBoardLog(id);
      }
    });

    async function hydrateRecentBoardLogsOnLoad() {
      try {
        var res = await fetch('/shop-floor/board-intake/status');
        if (!res.ok) return;
        var data = await res.json();
        if (!data.ok || !Array.isArray(data.entries) || data.entries.length === 0) return;
        
        var list = document.getElementById('recentBoardLogsList');
        if (!list) return;

        var emptyNotice = document.getElementById('emptyBoardLogsNotice');
        if (emptyNotice) emptyNotice.remove();

        data.entries.forEach(function(entry) {
          if (!entry || !entry.id) return;
          if (entry.status === 'pending' || entry.status === 'processing' || entry.status === 'reverting') {
            trackPendingBoardLog(entry.id);
          }
          var badge = document.querySelector('[data-board-log-status="' + entry.id + '"]');
          if (badge) {
            if (entry.status === 'synced') {
              badge.className = 'badge rounded-pill bg-success-subtle text-success';
              badge.textContent = 'Synced to Odoo';
              var retryForm = document.querySelector('.board-retry-form[data-intake-id="' + entry.id + '"]');
              if (retryForm) retryForm.remove();
            } else if (entry.status === 'failed') {
              badge.className = 'badge rounded-pill bg-danger-subtle text-danger';
              badge.textContent = 'Sync failed';
              badge.title = entry.error_message || '';
            } else if (entry.status === 'reverted') {
              badge.className = 'badge rounded-pill bg-secondary-subtle text-secondary';
              badge.textContent = 'Reverted in Odoo';
              var revertForm = document.querySelector('.board-revert-form[data-intake-id="' + entry.id + '"]');
              if (revertForm) {
                revertForm.innerHTML = '<span class="badge rounded-pill bg-secondary-subtle text-secondary border px-2.5 py-1" style="font-size:0.75rem">✓ Reverted</span>';
              }
              var card = badge.closest('.border.rounded-4') || badge.closest('.card') || badge.parentElement.parentElement;
              if (card) {
                card.style.opacity = '0.65';
              }
            } else if (entry.status === 'reverting') {
              badge.className = 'badge rounded-pill bg-warning-subtle text-warning-emphasis';
              badge.textContent = 'Reverting in background...';
            }
          }
        });
      } catch (_e) {}
    }
    hydrateRecentBoardLogsOnLoad();

    // Background Revert Form Handler (Non-blocking)
    document.addEventListener('submit', async function(e) {
      var form = e.target.closest('.board-revert-form');
      if (!form) return;
      e.preventDefault();
      if (!confirm('Revert this board intake in Odoo? This will remove the logged quantity from stock.')) return;

      var id = form.getAttribute('data-intake-id');
      var btn = form.querySelector('.btn-revert') || form.querySelector('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" style="width:0.75rem;height:0.75rem"></span>Reverting...';
      }

      var badge = document.querySelector('[data-board-log-status="' + id + '"]');
      if (badge) {
        badge.className = 'badge rounded-pill bg-warning-subtle text-warning-emphasis';
        badge.textContent = 'Reverting in background...';
      }
      if (id) trackPendingBoardLog(id);

      try {
        var formData = new FormData(form);
        formData.append('ajax', 'true');
        var res = await fetch(form.getAttribute('action'), {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: new URLSearchParams(formData).toString()
        });
        var data = await res.json().catch(function() { return {}; });
        if (!res.ok && !data.ok) {
          alert(data.error || 'Failed to revert board log.');
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Revert';
          }
          if (badge) {
            badge.className = 'badge rounded-pill bg-danger-subtle text-danger';
            badge.textContent = 'Sync failed';
          }
        }
      } catch (err) {
        console.warn('Revert request background error:', err);
      }
    });

    // Background Retry Form Handler (Non-blocking)
    document.addEventListener('submit', async function(e) {
      var form = e.target.closest('.board-retry-form');
      if (!form) return;
      e.preventDefault();

      var id = form.getAttribute('data-intake-id');
      var btn = form.querySelector('.btn-retry') || form.querySelector('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" style="width:0.75rem;height:0.75rem"></span>Retrying...';
      }

      var badge = document.querySelector('[data-board-log-status="' + id + '"]');
      if (badge) {
        badge.className = 'badge rounded-pill bg-warning-subtle text-warning-emphasis';
        badge.textContent = 'Syncing to Odoo';
      }
      if (id) trackPendingBoardLog(id);

      try {
        var formData = new FormData(form);
        formData.append('ajax', 'true');
        var res = await fetch(form.getAttribute('action'), {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: new URLSearchParams(formData).toString()
        });
        var data = await res.json().catch(function() { return {}; });
        if (!res.ok && !data.ok) {
          alert(data.error || 'Failed to retry board log synchronization.');
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Retry now';
          }
          if (badge) {
            badge.className = 'badge rounded-pill bg-danger-subtle text-danger';
            badge.textContent = 'Sync failed';
          }
        }
      } catch (err) {
        console.warn('Retry request background error:', err);
      }
    });

    // Toggle collapsible optional details (Vehicle, Time, Gate)
    var toggleBtn = document.getElementById('toggleDetailsBtn');
    var detailsContainer = document.getElementById('optionalDetailsContainer');
    var detailsChevron = document.getElementById('toggleDetailsChevron');
    var detailsIcon = document.getElementById('toggleDetailsIcon');

    if (toggleBtn && detailsContainer) {
      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var isCollapsed = detailsContainer.classList.contains('d-none');
        if (isCollapsed) {
          detailsContainer.classList.remove('d-none');
          toggleBtn.setAttribute('aria-expanded', 'true');
          if (detailsChevron) detailsChevron.style.transform = 'rotate(180deg)';
          if (detailsIcon) detailsIcon.innerHTML = '<line x1="5" y1="12" x2="19" y2="12"/>';
          toggleBtn.style.background = '#f1f5f9';
        } else {
          detailsContainer.classList.add('d-none');
          toggleBtn.setAttribute('aria-expanded', 'false');
          if (detailsChevron) detailsChevron.style.transform = '';
          if (detailsIcon) detailsIcon.innerHTML = '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>';
          toggleBtn.style.background = '#f8fafc';
        }
      });
    }

    // Allow clicking a selected radio to uncheck it (fully optional)
    ['gateFront', 'gateBack'].forEach(function(id) {
      var radio = document.getElementById(id);
      if (radio) {
        radio.addEventListener('click', function() {
          if (this.dataset.wasChecked === 'true') {
            this.checked = false;
            this.dataset.wasChecked = 'false';
          } else {
            document.querySelectorAll('input[name="gate"]').forEach(function(r) { r.dataset.wasChecked = 'false'; });
            this.dataset.wasChecked = 'true';
          }
        });
      }
    });

    // Form submission spinner state & asynchronous rapid logging
    var form = document.getElementById('intakeForm');
    var submitBtn = document.getElementById('submitBtn');
    var alertContainer = document.getElementById('intakeAlertContainer');

    if (form && submitBtn) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        if (typeof hideAppLoading === 'function') {
          hideAppLoading();
        }

        var partnerVal = document.getElementById('partnerSelect').value;
        var productVal = document.getElementById('productSelect').value;
        var isValid = true;

        if (!partnerVal) {
          document.getElementById('partnerSearch').classList.add('is-invalid');
          isValid = false;
        } else {
          document.getElementById('partnerSearch').classList.remove('is-invalid');
        }

        if (!productVal) {
          document.getElementById('productSearch').classList.add('is-invalid');
          isValid = false;
        } else {
          document.getElementById('productSearch').classList.remove('is-invalid');
        }

        var qtyInput = document.getElementById('intakeQty');
        var rawQtyVal = qtyInput ? qtyInput.value.trim() : '';
        var numQty = parseFloat(rawQtyVal);

        if (!rawQtyVal || isNaN(numQty) || numQty <= 0 || !Number.isInteger(numQty) || numQty % 1 !== 0 || rawQtyVal.includes('.') || rawQtyVal.includes(',')) {
          isValid = false;
          if (qtyInput) {
            qtyInput.classList.add('is-invalid');
            qtyInput.style.color = '#dc2626';
            qtyInput.style.borderColor = '#dc2626';
            qtyInput.style.backgroundColor = '#fef2f2';
            qtyInput.style.boxShadow = '0 0 0 0.25rem rgba(220, 38, 38, 0.2)';
            var feedback = document.getElementById('qtyFeedback');
            if (feedback) feedback.style.display = 'block';
            qtyInput.focus();
          }
          showOffcutsPopup();
          e.stopPropagation();
          return;
        } else {
          if (qtyInput) {
            qtyInput.classList.remove('is-invalid');
            qtyInput.style.color = '';
            qtyInput.style.borderColor = '';
            qtyInput.style.backgroundColor = '';
            qtyInput.style.boxShadow = '';
            var feedback = document.getElementById('qtyFeedback');
            if (feedback) feedback.style.display = 'none';
          }
        }

        if (!form.checkValidity() || !isValid) {
          e.stopPropagation();
          form.classList.add('was-validated');
          return;
        }

        var text = submitBtn.querySelector('.submit-text');
        var spinner = submitBtn.querySelector('.submit-spinner');
        if (text && spinner) {
          text.textContent = 'Saving...';
          spinner.classList.remove('d-none');
          submitBtn.setAttribute('disabled', 'disabled');
          submitBtn.style.opacity = '0.85';
        }

        try {
          var response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
            },
            body: new URLSearchParams(new FormData(form)).toString()
          });

          var result = await response.json().catch(function() {
            return { ok: false, error: 'Unexpected server response.' };
          });

          if (!response.ok || !result.ok) {
            throw new Error(result.error || result.message || 'Failed to save boards.');
          }

          // Show immediate success notification banner
          if (alertContainer) {
            alertContainer.className = 'alert alert-success alert-dismissible fade show rounded-3 py-2.5 px-3 mb-3 d-flex align-items-center justify-content-between gap-3 shadow-sm';
            alertContainer.innerHTML =
              '<div class="small">' +
                '<strong>✓ Saved immediately:</strong> ' + escapeHtml(result.item.quantity) + ' × ' + escapeHtml(result.item.product_name) +
                ' for <strong>' + escapeHtml(result.item.customer_name) + '</strong>.' +
              '</div>' +
              '<span class="badge bg-success text-white rounded-pill px-2 py-1 flex-shrink-0" style="font-size:0.75rem">Saved</span>';
          }

          // Invalidate shop-floor cache so navigation remains fresh
          if (window.shopFloorPageCache) {
            window.shopFloorPageCache.clear();
          }

          // Dynamically prepend new log item to recentBoardLogsList
          var section = document.getElementById('recentBoardLogsSection');
          var list = document.getElementById('recentBoardLogsList');
          if (section) section.classList.remove('d-none');
          if (list) {
            var emptyNotice = document.getElementById('emptyBoardLogsNotice');
            if (emptyNotice) emptyNotice.remove();
            var row = document.createElement('div');
            row.className = 'd-flex flex-wrap justify-content-between align-items-center gap-2 border rounded-3 px-3 py-2';
            row.setAttribute('data-board-log-row', result.item.id);
            row.style.background = '#f0fdf4';
            row.style.transition = 'background 1.5s ease';
            row.innerHTML =
              '<div>' +
                '<strong>' + escapeHtml(result.item.quantity) + ' × ' + escapeHtml(result.item.product_name) + '</strong>' +
                '<div class="small text-muted">' +
                  escapeHtml(result.item.customer_name) + ' · Just now' +
                  (result.item.gate ? ' · <strong>' + escapeHtml(result.item.gate) + '</strong>' : '') +
                  (result.item.arrival_date ? ' · Date: <strong>' + escapeHtml(result.item.arrival_date) + '</strong>' : '') +
                  (result.item.arrival_time ? ' · Arrived: <strong>' + escapeHtml(result.item.arrival_time) + '</strong>' : '') +
                  (result.item.vehicle_registration ? ' · Vehicle: <strong>' + escapeHtml(result.item.vehicle_registration) + '</strong>' : '') +
                  (result.item.actor_name ? ' · Logged by <strong>' + escapeHtml(result.item.actor_name) + '</strong>' : '') +
                '</div>' +
              '</div>' +
              '<div class="d-flex align-items-center gap-2">' +
                '<div class="text-end">' +
                  '<span class="badge rounded-pill bg-warning-subtle text-warning-emphasis" data-board-log-status="' + escapeHtml(result.item.id) + '">Syncing to Odoo</span>' +
                '</div>' +
              '</div>';
            list.prepend(row);
            window.setTimeout(function() { row.style.background = ''; }, 2000);
          }

          // Start tracking Odoo sync in background
          trackPendingBoardLog(result.item.id);

          // Clear ALL fields for the next entry - no prefilling, completely empty fields
          var partnerSelect = document.getElementById('partnerSelect');
          var partnerName = document.getElementById('partnerName');
          var partnerSearch = document.getElementById('partnerSearch');
          if (partnerSelect) partnerSelect.value = '';
          if (partnerName) partnerName.value = '';
          if (partnerSearch) {
            partnerSearch.value = '';
            partnerSearch.classList.remove('is-invalid');
          }
          var partnerList = document.getElementById('partnerList');
          if (partnerList) {
            partnerList.querySelectorAll('.combobox-item').forEach(function(i) {
              i.classList.remove('selected');
            });
          }
          clearRequirements();

          var productSelect = document.getElementById('productSelect');
          var productName = document.getElementById('productName');
          var productSearch = document.getElementById('productSearch');
          if (productSelect) productSelect.value = '';
          if (productName) productName.value = '';
          if (productSearch) {
            productSearch.value = '';
            productSearch.classList.remove('is-invalid');
          }
          var productList = document.getElementById('productList');
          if (productList) {
            productList.querySelectorAll('.combobox-item').forEach(function(i) {
              i.classList.remove('selected');
            });
          }

          var qtyInput = document.getElementById('intakeQty');
          if (qtyInput) {
            qtyInput.value = '';
            qtyInput.classList.remove('is-invalid');
          }
          var stockHelp = document.getElementById('qtyCurrentStock');
          if (stockHelp) {
            stockHelp.style.display = 'none';
          }

          var vehicleReg = document.getElementById('vehicleRegistration');
          if (vehicleReg) {
            vehicleReg.value = '';
          }

          var arrivalDateInput = document.getElementById('arrivalDate');
          if (arrivalDateInput) {
            arrivalDateInput.value = '';
          }

          var arrivalTimeInput = document.getElementById('arrivalTime');
          if (arrivalTimeInput) {
            arrivalTimeInput.value = '';
          }

          var gateFront = document.getElementById('gateFront');
          if (gateFront) {
            gateFront.checked = false;
            gateFront.dataset.wasChecked = 'false';
          }
          var gateBack = document.getElementById('gateBack');
          if (gateBack) {
            gateBack.checked = false;
            gateBack.dataset.wasChecked = 'false';
          }

          if (detailsContainer && !detailsContainer.classList.contains('d-none')) {
            detailsContainer.classList.add('d-none');
            if (toggleBtn) {
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.style.background = '#f8fafc';
            }
            if (detailsChevron) detailsChevron.style.transform = '';
            if (detailsIcon) detailsIcon.innerHTML = '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>';
          }

          form.classList.remove('was-validated');

          // Transition the submitted item immediately to locked syncing feedback
          var submittedPartnerId = String(result.item.partner_id || '');
          var submittedPartnerName = (result.item.customer_name || '').toLowerCase().trim();
          var submittedProductId = String(result.item.product_id || '');
          var submittedProductName = (result.item.product_name || '').toLowerCase().trim();

          document.querySelectorAll('.stock-alert-item').forEach(function(itemEl) {
            var pId = itemEl.getAttribute('data-partner-id');
            var client = (itemEl.getAttribute('data-client') || '').toLowerCase().trim();
            var prodId = itemEl.getAttribute('data-product-id');
            var comp = (itemEl.getAttribute('data-component') || '').toLowerCase().trim();

            var partnerMatch = (pId && pId === submittedPartnerId) || (client && (client.includes(submittedPartnerName) || submittedPartnerName.includes(client)));
            var productMatch = (prodId && prodId === submittedProductId) || (comp && (comp.includes(submittedProductName) || submittedProductName.includes(comp)));

            if (partnerMatch && productMatch) {
              itemEl.setAttribute('data-is-syncing', 'true');
              itemEl.classList.remove('item-undone');
              itemEl.classList.add('item-syncing-locked');
              itemEl.style.opacity = '0.78';

              var actionContainer = itemEl.querySelector('.action-container');
              if (actionContainer) {
                actionContainer.innerHTML =
                  '<span class="badge rounded-pill d-inline-flex align-items-center gap-1.5 px-2.5 py-1 fw-semibold text-warning-emphasis border border-warning-subtle bg-white" style="font-size: 0.72rem;">' +
                    '<span class="spinner-border spinner-border-sm text-warning" role="status" style="width: 10px; height: 10px; border-width: 1.5px;"></span>' +
                    '🔒 Locked · In Odoo Queue' +
                  '</span>';
              }

              var clientGroup = itemEl.closest('.stock-client-group');
              if (clientGroup) {
                var groupBtn = clientGroup.querySelector('.auto-fill-stock-btn');
                if (groupBtn) {
                  groupBtn.outerHTML =
                    '<span class="badge rounded-pill d-inline-flex align-items-center gap-1.5 px-3 py-1.5 fw-bold syncing-locked-badge" style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.78rem;">' +
                      '<span class="spinner-border spinner-border-sm text-warning" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>' +
                      '<span>⏳ Logged · Syncing to Odoo...</span>' +
                    '</span>';
                }
              }
            }
          });

          // Update undone count in header badge
          var remainingUndoneItems = document.querySelectorAll('.stock-alert-item.item-undone');
          var undoneCountNumber = document.getElementById('undoneCountNumber');
          var undoneCountBadge = document.getElementById('undoneCountBadge');
          if (undoneCountNumber) {
            undoneCountNumber.textContent = remainingUndoneItems.length;
          }
          if (remainingUndoneItems.length === 0 && undoneCountBadge) {
            undoneCountBadge.style.background = '#f0fdf4';
            undoneCountBadge.style.color = '#15803d';
            undoneCountBadge.style.borderColor = '#bbf7d0';
            undoneCountBadge.innerHTML = '✓ All items logged &amp; syncing';
          }

          // Smoothly open and focus on the still undone logs
          if (remainingUndoneItems.length > 0) {
            var nextUndone = remainingUndoneItems[0];
            nextUndone.scrollIntoView({ behavior: 'smooth', block: 'center' });
            nextUndone.style.transition = 'background-color 0.4s ease';
            nextUndone.style.backgroundColor = 'rgba(254, 215, 170, 0.45)';
            setTimeout(function() {
              nextUndone.style.backgroundColor = '';
            }, 2500);
          } else {
            // Reset focus to the Client field for the next entry
            if (partnerSearch) {
              partnerSearch.focus();
            }
          }
        } catch (err) {
          if (alertContainer) {
            alertContainer.className = 'alert alert-danger alert-dismissible fade show rounded-3 py-2.5 px-3 mb-3';
            alertContainer.innerHTML =
              '<div class="small"><strong>Error:</strong> ' + escapeHtml(err instanceof Error ? err.message : 'Could not log boards.') + '</div>' +
              '<button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>';
          }
        } finally {
          if (text) text.textContent = 'Log Boards & Reserve on MOs';
          if (spinner) spinner.classList.add('d-none');
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.style.opacity = '1';
            delete submitBtn.dataset.submitting;
            submitBtn.classList.remove('is-loading');
          }
          if (typeof hideAppLoading === 'function') {
            hideAppLoading();
          }
        }
      });
    }
  })();
</script>

<%- include('partials/footer') %>
