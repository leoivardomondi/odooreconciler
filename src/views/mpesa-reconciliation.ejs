          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close Log</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function loadMpesaBatchDiagnostics(batchId) {
      const loading = document.getElementById('mpesa-diag-loading');
      const content = document.getElementById('mpesa-diag-content');
      if (!loading || !content) return;

      loading.classList.remove('d-none');
      content.classList.add('d-none');

      try {
        const res = await fetch('/mpesa-reconciliation/batches/' + encodeURIComponent(batchId) + '/diagnostics');
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'Failed to load log.');

        document.getElementById('diag-ai-provider').textContent = data.aiInfo.provider;
        document.getElementById('diag-ai-model').textContent = data.aiInfo.model || 'default';
        document.getElementById('diag-ocr-provider').textContent = data.aiInfo.ocrProvider;
        document.getElementById('diag-ocr-model').textContent = data.aiInfo.ocrModel || 'default';
        document.getElementById('diag-oauth-status').innerHTML = data.aiInfo.geminiOAuthConnected
          ? '<span class="badge text-bg-success">Connected (' + (data.aiInfo.geminiOAuthEmail || 'Active') + ')</span>'
          : '<span class="badge text-bg-secondary">Not connected</span>';
        document.getElementById('diag-apikey-status').innerHTML = data.aiInfo.hasGeminiApiKey
          ? '<span class="badge text-bg-success">Yes</span>'
          : '<span class="badge text-bg-warning">No</span>';

        document.getElementById('diag-file-name').textContent = data.batch.originalFilename;
        document.getElementById('diag-batch-id').textContent = data.batch.id;
        document.getElementById('diag-status-badge').textContent = data.batch.status;
        document.getElementById('diag-status-badge').className = 'badge text-bg-' + (data.batch.status === 'parsed' ? 'success' : 'warning');
        document.getElementById('diag-row-count').textContent = data.batch.transactionCount;
        document.getElementById('diag-matched-count').textContent = data.batch.matchedCount;

        const checksContainer = document.getElementById('diag-total-checks-list');
        checksContainer.innerHTML = (data.totalChecks || []).map(function(check) {
          const moneyVal = function(val) {
            return val === null || val === undefined ? '-' : 'KSh ' + Number(val).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          };
          const badgeClass = check.status === 'match' || check.status === 'verified' ? 'success' : check.status === 'mismatch' ? 'danger' : 'warning';
          const labelText = check.status === 'match' ? 'Matched' : check.status === 'mismatch' ? 'Mismatch' : check.status === 'verified' ? 'Verified' : 'Needs Review';
          return '<div class="p-2 border rounded bg-white">' +
            '<div class="d-flex justify-content-between align-items-center mb-1">' +
            '<strong>' + check.label + '</strong>' +
            '<span class="badge text-bg-' + badgeClass + '">' + labelText + '</span>' +
            '</div>' +
            '<div class="small text-secondary mb-1">' + (check.validationMode === 'summary' ? 'Extracted Rows: ' + moneyVal(check.extracted) : 'Validated Rows: ' + check.validatedRows + ' of ' + check.totalRows) + '</div>' +
            '<div class="small text-muted">' + check.diagnosis + '</div>' +
            '</div>';
        }).join('');

        const warningsContainer = document.getElementById('diag-warnings-list');
        if (!data.warnings || data.warnings.length === 0) {
          warningsContainer.innerHTML = '<li class="list-group-item text-success small">No diagnostic warnings reported during parsing.</li>';
        } else {
          warningsContainer.innerHTML = data.warnings.map(function(w) {
            return '<li class="list-group-item text-danger small">⚠️ ' + w + '</li>';
          }).join('');
        }

        document.getElementById('diag-raw-preview').textContent = data.rawTextPreview || '(No raw text preview captured)';

        loading.classList.add('d-none');
        content.classList.remove('d-none');
      } catch (err) {
        loading.innerHTML = '<div class="alert alert-danger mb-0">' + (err.message || String(err)) + '</div>';
      }
    }
  </script>
<% } %>

