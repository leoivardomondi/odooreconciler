// Store original English text
var _originals = {};
(function() {
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    _originals[el.getAttribute('data-i18n')] = _originals[el.getAttribute('data-i18n')] || el.textContent.trim();
  });
})();

function setLanguage(lang) {
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    var key = el.getAttribute('data-i18n');
    if (lang === 'sw' && _i18n.sw[key]) {
      el.textContent = _i18n.sw[key];
    } else if (_originals[key]) {
      el.textContent = _originals[key];
    }
  });
  var btn = document.getElementById('langBtnLabel');
  if (btn) btn.textContent = lang === 'sw' ? 'English' : 'Swahili';
  localStorage.setItem('shopFloorLang', lang);
}

function openPauseMoModal(btn) {
  var id = btn.getAttribute('data-pause-id');
  var name = btn.getAttribute('data-pause-name');
  var product = btn.getAttribute('data-pause-product');
  var totalQty = btn.getAttribute('data-pause-qty');
  var producedQty = btn.getAttribute('data-pause-produced');

  var form = document.getElementById('pauseMoForm');
  if (form) {
    form.action = '/shop-floor/work-order/' + encodeURIComponent(id) + '/pause';
  }
  var nameEl = document.getElementById('pauseMoNameDisplay');
  var prodEl = document.getElementById('pauseMoProductDisplay');
  var totalEl = document.getElementById('pauseMoTotalQtyDisplay');
  var qtyEl = document.getElementById('pauseMoQtyProduced');
  if (nameEl) nameEl.textContent = name;
  if (prodEl) prodEl.textContent = product;
  if (totalEl) totalEl.textContent = totalQty;
  if (qtyEl) qtyEl.value = producedQty || 0;
}
</script>

<!-- Pause Manufacturing Order Modal -->
<div class="modal fade" id="pauseMoModal" tabindex="-1" aria-labelledby="pauseMoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form method="post" action="" id="pauseMoForm" class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden">
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
      <div class="modal-header bg-warning-subtle text-warning-emphasis border-0 px-4 py-3">
        <h5 class="modal-title fw-bold" id="pauseMoModalLabel">
          <i class="bi bi-pause-circle-fill me-2"></i>Pause Manufacturing Order
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3">
          <label class="form-label text-muted small mb-1 fw-semibold">Manufacturing Order</label>
          <div class="fw-bold fs-5 text-dark" id="pauseMoNameDisplay">-</div>
          <div class="text-secondary small" id="pauseMoProductDisplay">-</div>
        </div>

        <div class="mb-3">
          <label class="form-label text-muted small mb-1 fw-semibold">Units Completed So Far</label>
          <input type="number" name="qtyProduced" id="pauseMoQtyProduced" class="form-control rounded-3" min="0" value="0" />
          <div class="form-text small">Enter quantity finished before pausing (Total MO Quantity: <span id="pauseMoTotalQtyDisplay">0</span>).</div>
        </div>

        <div class="form-check form-switch bg-light p-3 rounded-3 border mb-3 ms-0">
          <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" name="createBackorder" value="true" id="pauseMoBackorderCheck" checked>
          <label class="form-check-label fw-bold text-dark" for="pauseMoBackorderCheck">
            Create Backorder for Remaining Units
          </label>
          <div class="text-muted small mt-1">Pauses current task and creates a backorder in Odoo for unproduced units so other orders can be prioritized.</div>
        </div>
      </div>
      <div class="modal-footer border-top-0 px-4 pb-4">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">
          <i class="bi bi-pause-fill me-1"></i>Pause Task
        </button>
      </div>
    </form>
  </div>
</div>
