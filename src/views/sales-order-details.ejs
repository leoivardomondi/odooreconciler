<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const hasJobSummary = attachments.some((item) => item.isJobSummary);
  const queryParts = [];
  if (query) queryParts.push(`q=${encodeURIComponent(query)}`);
  if (page > 1) queryParts.push(`page=${page}`);
  const querySuffix = queryParts.length ? `?${queryParts.join('&')}` : '';
  const statusClass = (value) => {
    if (value === 'sent_to_odoo') return 'success';
    if (value === 'failed' || value === 'odoo_update_failed') return 'danger';
    if (value === 'parsed' || value === 'parsed_empty') return 'warning';
    return 'secondary';
  };
%>

<main class="container py-4 py-lg-5">
  <section class="hero-panel mb-4">
    <div>
      <p class="eyebrow">Sales Order Detail</p>
      <h1 class="display-6 mb-2"><%= order.name %></h1>
      <p class="lead text-secondary mb-0">
        Review order metadata, inspect attachments, and extract the latest Job Summary PDF in one place.
      </p>
    </div>
    <div class="hero-actions">
      <div class="d-flex flex-wrap gap-2">
        <a
          href="<%= previousOrder ? `/sales-orders/${previousOrder.id}${querySuffix}` : '#' %>"
          class="btn btn-outline-secondary <%= previousOrder ? '' : 'disabled' %>"
          <%= previousOrder ? '' : 'aria-disabled="true"' %>
        >
          Prev
        </a>
        <a
          href="<%= nextOrder ? `/sales-orders/${nextOrder.id}${querySuffix}` : '#' %>"
          class="btn btn-outline-secondary <%= nextOrder ? '' : 'disabled' %>"
          <%= nextOrder ? '' : 'aria-disabled="true"' %>
        >
          Next
        </a>
      </div>
      <form method="post" action="/sales-orders/<%= order.id %>/extract-latest" data-disable-submit="true" data-loading-message="Extracting latest Job Summary...">
        <input type="hidden" name="q" value="<%= query %>" />
        <input type="hidden" name="page" value="<%= page %>" />
        <button type="submit" class="btn btn-primary" <%= hasJobSummary ? '' : 'disabled' %>>
          Extract Latest Job Summary
        </button>
      </form>
      <a href="/sales-orders<%= querySuffix %>" class="btn btn-outline-secondary">Back to Search</a>
    </div>
  </section>

  <%- include('partials/alerts', { status, validationErrors: [] }) %>

  <div class="card shadow-sm border-0 app-card mb-4">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
          <h2 class="h4 mb-2">Stock Reconciliation</h2>
          <p class="text-secondary small mb-0">
            Reconcile unused edge banding stock from Job Summary usage: Sales Order ordered metres minus Job Summary used metres.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <form method="post" action="/sales-orders/<%= order.id %>/stock/preview" data-disable-submit="true" data-loading-message="Preparing stock preview...">
            <input type="hidden" name="q" value="<%= query %>" />
            <input type="hidden" name="page" value="<%= page %>" />
            <button type="submit" class="btn btn-outline-primary">
              Preview
            </button>
          </form>
          <form
            method="post"
            action="/sales-orders/<%= order.id %>/stock/process"
            data-disable-submit="true"
            data-loading-message="Reconciling stock..."
          >
            <input type="hidden" name="q" value="<%= query %>" />
            <input type="hidden" name="page" value="<%= page %>" />
            <button
              type="submit"
              class="btn btn-primary"
              data-confirm="Run stock reconciliation for this Sales Order now?"
            >
              Reconcile Stock
            </button>
          </form>
          <form
            method="post"
            action="/sales-orders/<%= order.id %>/stock/reverse"
            data-disable-submit="true"
            data-loading-message="Reversing stock additions..."
          >
            <input type="hidden" name="q" value="<%= query %>" />
            <input type="hidden" name="page" value="<%= page %>" />
            <button
              type="submit"
              class="btn btn-outline-danger"
              data-confirm="Reverse all app-recorded stock additions for this Sales Order?"
            >
              Reverse Stock Additions
            </button>
          </form>
        </div>
      </div>

      <% if (stockResult) { %>
        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <div class="stat-card h-100">
              <span class="stat-label">Source</span>
              <span class="stat-value stat-compact"><%= stockResult.source === 'stock_adjustment_input_json' ? 'Stock Adjustment Input JSON' : 'Latest Extracted Job Summary' %></span>
              <span class="stat-note">Signature: <%= stockResult.signature || 'missing' %></span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card h-100">
              <span class="stat-label">Processed</span>
              <span class="stat-value"><%= stockResult.summary.processedCount %></span>
              <span class="stat-note">Skipped <%= stockResult.summary.skippedCount %> | Failed <%= stockResult.summary.failedCount %></span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card h-100">
              <span class="stat-label">Missing SO</span>
              <span class="stat-value"><%= stockResult.summary.missingSoItemsCount %></span>
              <span class="stat-note">Missing component <%= stockResult.summary.missingComponentCount %></span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card h-100">
              <span class="stat-label">Run State</span>
              <span class="stat-value stat-compact">
                <%= stockResult.preview ? 'Preview' : stockResult.alreadyProcessed ? 'Already Processed' : stockResult.lockSkipped ? 'Locked' : 'Completed' %>
              </span>
              <span class="stat-note"><%= stockResult.writeBackApplied ? 'Odoo write-back applied' : 'No Odoo write-back' %></span>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table align-middle mb-0 stock-results-table">
            <thead>
              <tr>
                <th>Color</th>
                <th>Normalized Color</th>
                <th>Job Summary Used Metres</th>
                <th>SO Ordered Metres</th>
                <th>Unused Quantity to Add</th>
                <th>SO Match</th>
                <th>MO Gate</th>
                <th>Component Match</th>
                <th>Variant</th>
                <th>Current Stock</th>
                <th>New Stock</th>
                <th>Status</th>
                <th>Reason</th>
              </tr>
            </thead>
            <tbody>
              <% if (stockResult.items.length === 0) { %>
                <tr>
                  <td colspan="13" class="text-center text-secondary py-4">
                    <%= stockResult.statusMessage %>
                  </td>
                </tr>
              <% } %>
              <% stockResult.items.forEach((item) => { %>
                <tr>
                  <td><strong><%= item.extractedColor %></strong></td>
                  <td><%= item.normalizedColor %></td>
                  <td><%= item.usedMeters %></td>
                  <td><%= item.orderedMeters ?? 'n/a' %></td>
                  <td><%= item.quantityToAddMeters %></td>
                  <td><%= item.soMatched ? 'Yes' : 'No' %></td>
                  <td><%= item.moMatched ? (item.moState || 'Yes') : 'No' %></td>
                  <td><%= item.componentFound ? 'Yes' : 'No' %></td>
                  <td><%= item.variantId || 'n/a' %></td>
                  <td><%= item.currentStock ?? 'n/a' %></td>
                  <td><%= item.newStock ?? 'n/a' %></td>
                  <td>
                    <span class="badge text-bg-<%= item.status === 'processed' ? 'success' : item.status === 'failed' ? 'danger' : item.status === 'skipped' ? 'warning' : 'secondary' %>">
                      <%= item.status %>
                    </span>
                  </td>
                  <td><%= item.skipReason || 'n/a' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-5">
      <div class="card shadow-sm border-0 app-card h-100">
        <div class="card-body p-4">
          <h2 class="h4 mb-3">Order Information</h2>
          <dl class="row small mb-0">
            <dt class="col-5 text-secondary">Customer</dt>
            <dd class="col-7"><%= getRelationLabel(order.partner_id) %></dd>
            <dt class="col-5 text-secondary">Salesperson</dt>
            <dd class="col-7"><%= getRelationLabel(order.user_id) %></dd>
            <dt class="col-5 text-secondary">Date</dt>
            <dd class="col-7"><%= formatDateTime(order.date_order) %></dd>
            <dt class="col-5 text-secondary">State</dt>
            <dd class="col-7"><%= order.state || 'n/a' %></dd>
            <dt class="col-5 text-secondary">Amount</dt>
            <dd class="col-7"><%= order.amount_total ?? 'n/a' %></dd>
            <dt class="col-5 text-secondary">Client Ref</dt>
            <dd class="col-7"><%= order.client_order_ref || 'n/a' %></dd>
            <dt class="col-5 text-secondary">Valid Until</dt>
            <dd class="col-7"><%= formatDateTime(order.validity_date) %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="card shadow-sm border-0 app-card h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
              <h2 class="h4 mb-2">Attachment Scan</h2>
              <p class="text-secondary small mb-0">
                Job Summary detection currently looks for PDF filenames containing "<%= filenameKeyword %>".
              </p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
              <span class="badge text-bg-<%= hasJobSummary ? 'success' : 'secondary' %>">
                <%= hasJobSummary ? 'Job Summary PDF detected' : 'No matching Job Summary PDF' %>
              </span>
              <form
                method="post"
                action="/sales-orders/<%= order.id %>/job-summary-reminder/run"
                data-disable-submit="true"
                data-loading-message="Checking Job Summary reminder..."
              >
                <input type="hidden" name="q" value="<%= query %>" />
                <input type="hidden" name="page" value="<%= page %>" />
                <button type="submit" class="btn btn-sm btn-outline-primary">
                  Run Upload Reminder
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-card mb-4">
    <div class="card-body p-4">
      <h2 class="h4 mb-3">Attachments</h2>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Attachment</th>
              <th>Type</th>
              <th>Updated</th>
              <th>Size</th>
              <th>Flags</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (attachments.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-secondary py-4">No attachments were found for this Sales Order.</td>
              </tr>
            <% } %>
            <% attachments.forEach((attachment) => { %>
              <tr class="<%= attachment.isJobSummary ? 'job-summary-row' : '' %>">
                <td><strong><%= attachment.name %></strong></td>
                <td><%= attachment.mimetype || 'n/a' %></td>
                <td><%= formatDateTime(attachment.write_date || attachment.create_date) %></td>
                <td><%= formatFileSize(attachment.file_size) %></td>
                <td>
                  <% if (attachment.isPdf) { %>
                    <span class="badge text-bg-light">PDF</span>
                  <% } %>
                  <% if (attachment.isJobSummary) { %>
                    <span class="badge text-bg-success">Job Summary</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <form method="post" action="/sales-orders/<%= order.id %>/extract-selected" data-disable-submit="true" data-loading-message="Extracting selected attachment...">
                    <input type="hidden" name="attachmentId" value="<%= attachment.id %>" />
                    <input type="hidden" name="q" value="<%= query %>" />
                    <input type="hidden" name="page" value="<%= page %>" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" <%= attachment.isPdf ? '' : 'disabled' %>>
                      Extract Selected
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-card">
    <div class="card-body p-4">
      <h2 class="h4 mb-3">Recent History For This SO</h2>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Attachment</th>
              <th>Status</th>
              <th>Summary</th>
              <th>Updated</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (history.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center text-secondary py-4">No extraction history exists for this order yet.</td>
              </tr>
            <% } %>
            <% history.forEach((entry) => { %>
              <tr>
                <td><%= entry.attachmentName %></td>
                <td><span class="badge text-bg-<%= statusClass(entry.status) %>"><%= entry.status %></span></td>
                <td><%= entry.summary || entry.errorMessage || 'n/a' %></td>
                <td><%= formatDateTime(entry.updatedAt) %></td>
                <td class="text-end">
                  <a href="/extractions/<%= entry.id %>" class="btn btn-sm btn-outline-secondary">Open</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
