<%- include('partials/head') %>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background: radial-gradient(circle at top right, #f5eff4 0%, #f0f2f5 48%, #e9edf3 100%);
    color: #1e293b;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .sf-gate-card {
    width: 100%;
    max-width: 460px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 20px 50px -12px rgba(15, 23, 42, 0.16);
    overflow: hidden;
  }

  .sf-gate-banner {
    background: linear-gradient(135deg, #714B67 0%, #583a50 100%);
    color: #ffffff;
    padding: 1.75rem 1.75rem 1.5rem;
    text-align: center;
  }

  .sf-gate-logo {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: #ffffff;
    padding: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
    margin: 0 auto 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sf-gate-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sf-gate-title {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .sf-gate-subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.4;
  }

  .sf-gate-body {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .sf-net-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .sf-net-badge.is-site {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }

  .sf-net-badge.is-remote {
    background: #fffbeb;
    color: #b45309;
    border: 1px solid #fde68a;
  }

  .sf-btn-primary {
    background: linear-gradient(135deg, #714B67 0%, #583a50 100%);
    border: none;
    color: #ffffff;
    font-weight: 700;
    padding: 0.7rem 1.1rem;
    border-radius: 12px;
    width: 100%;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }

  .sf-btn-primary:hover {
    opacity: 0.94;
    color: #ffffff;
  }

  .sf-btn-secondary {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-weight: 600;
    padding: 0.62rem 1rem;
    border-radius: 12px;
    width: 100%;
  }

  .sf-btn-secondary:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
</style>

<div class="sf-gate-card">
  <div class="sf-gate-banner">
    <div class="sf-gate-logo">
      <img src="/public/icons/odoo-shop-floor-192.png" alt="SHOP FLOOR" />
    </div>
    <h1 class="sf-gate-title">New Device Verification Required</h1>
    <p class="sf-gate-subtitle">
      This device has not previously been authorized for Urban Vibe <strong><%= typeof targetResourceLabel !== 'undefined' ? targetResourceLabel : 'Shop Floor' %></strong>.
      An Administrator must approve it once before access is granted.
    </p>
  </div>

  <div class="sf-gate-body">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
      <% if (isSiteNetwork) { %>
        <span class="sf-net-badge is-site">
          <span>●</span> Factory Site Network
        </span>
      <% } else { %>
        <span class="sf-net-badge is-remote">
          <span>🔒</span> Remote Network Detected
        </span>
      <% } %>
      <span class="small text-muted font-monospace"><%= clientIp %></span>
    </div>

    <% if (message) { %>
      <div class="alert alert-success py-2 px-3 small rounded-3 mb-3" role="alert">
        <%= message %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (canQuickAuthorize && signedInAdminEmail) { %>
      <div class="p-3 rounded-3 mb-3" style="background: #f0fdfa; border: 1px solid #99f6e4;">
        <div class="small fw-bold text-teal-800 mb-1" style="color:#0f766e;">
          Signed in as Administrator
        </div>
        <div class="small text-muted mb-2">
          Approve this browser as a trusted Shop Floor terminal under <strong><%= signedInAdminEmail %></strong>.
        </div>
        <form method="post" action="/public/shop-floor/device-auth/authorize">
          <input type="hidden" name="mode" value="quick" />
          <input type="hidden" name="next" value="<%= typeof returnTo !== 'undefined' ? returnTo : '/public/shop-floor' %>" />
          <div class="mb-2">
            <label for="quickDeviceLabel" class="form-label small fw-semibold mb-1">Device Name (optional)</label>
            <input
              type="text"
              id="quickDeviceLabel"
              name="deviceLabel"
              class="form-control form-control-sm rounded-3"
              value="<%= suggestedDeviceLabel %>"
              placeholder="e.g. Table Saw Tablet"
              maxlength="120"
            />
          </div>
          <button type="submit" class="btn sf-btn-primary">
            Authorize This Device Now
          </button>
        </form>
      </div>
    <% } else { %>
      <form method="post" action="/public/shop-floor/device-auth/authorize" id="deviceAuthForm">
        <input type="hidden" name="next" value="<%= typeof returnTo !== 'undefined' ? returnTo : '/public/shop-floor' %>" />
        <div class="mb-3">
          <label for="deviceLabel" class="form-label small fw-semibold text-secondary mb-1">Device Name</label>
          <input
            type="text"
            id="deviceLabel"
            name="deviceLabel"
            class="form-control rounded-3"
            value="<%= suggestedDeviceLabel %>"
            placeholder="e.g. Table Saw Tablet, Edge Banding PC"
            maxlength="120"
          />
          <div class="form-text small">Helps admins identify or revoke this terminal later.</div>
        </div>

        <div class="mb-3">
          <label for="adminEmail" class="form-label small fw-semibold text-secondary mb-1">Administrator Work Email</label>
          <input
            type="email"
            id="adminEmail"
            name="email"
            class="form-control rounded-3"
            value="<%= email %>"
            placeholder="admin@urbanvibeinteriordesign.co.ke"
            autocomplete="username"
            required
          />
        </div>

        <div class="mb-3">
          <label for="adminCredential" class="form-label small fw-semibold text-secondary mb-1">
            Password or 6-Digit Email Code
          </label>
          <input
            type="password"
            id="adminCredential"
            name="credential"
            class="form-control rounded-3"
            placeholder="<%= codeSent ? 'Enter 6-digit code from your email' : 'Enter password or 6-digit code' %>"
            autocomplete="current-password"
          />
          <div class="form-text small">
            Only active Administrators or Shop Floor Admins can approve new devices. Admin credentials are verified once and are <strong>not</strong> kept signed in on this terminal.
          </div>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn sf-btn-primary" id="authorizeSubmitBtn">
            Authorize &amp; Unlock Shop Floor
          </button>
          <button
            type="submit"
            formaction="/public/shop-floor/device-auth/request-code"
            formnovalidate
            class="btn sf-btn-secondary"
            id="requestCodeBtn"
          >
            Send 6-Digit Verification Code to Email
          </button>
        </div>
      </form>
    <% } %>

    <div class="mt-3 pt-3 border-top text-center small text-muted">
      Once authorized, this device stays trusted until revoked by an administrator under
      <strong>Shop Floor &rarr; Operators</strong>.
    </div>
  </div>
</div>

<script>
  (function () {
    var reqBtn = document.getElementById('requestCodeBtn');
    var emailInput = document.getElementById('adminEmail');
    if (reqBtn && emailInput) {
      reqBtn.addEventListener('click', function (e) {
        if (!emailInput.value.trim()) {
          e.preventDefault();
          emailInput.focus();
          emailInput.reportValidity();
        }
      });
    }
  })();
</script>

</body>
</html>
