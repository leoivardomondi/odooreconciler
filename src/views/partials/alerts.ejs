<% if (status) { %>
  <div
    class="alert alert-<%= status.type %> shadow-sm"
    role="alert"
    <% if (status.type === 'danger' && /Gemini Google OAuth is not configured/i.test(String(status.message || ''))) { %>data-popup-error="true"<% } %>
  >
    <%= status.message %>
  </div>
<% } %>

<% if (validationErrors && validationErrors.length) { %>
  <div class="alert alert-danger shadow-sm" role="alert">
    <strong>Validation errors:</strong>
    <ul class="mb-0 mt-2 ps-3">
      <% validationErrors.forEach((item) => { %>
        <li><%= item.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>
