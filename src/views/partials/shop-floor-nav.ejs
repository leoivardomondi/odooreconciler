<%
  const activeTab = typeof activeShopFloorTab !== 'undefined' ? activeShopFloorTab : 'dashboard';
  const tabs = [
    { key: 'dashboard', label: 'All Apps', href: '/shop-floor', icon: 'M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z' },
    { key: 'boards', label: 'Add Stock', href: '/shop-floor/boards', icon: 'M3 6.5 12 2l9 4.5-9 4.5-9-4.5Zm0 0V17l9 5 9-5V6.5M12 11v11M7.5 8.75l9-4.5' },
    { key: 'receipts', label: 'Receipts', href: '/shop-floor/receipts', icon: 'M5 3h14v18l-3-2-4 2-4-2-3 2V3Zm3 5h8m-8 4h8m-8 4h5' },
    { key: 'deliveries', label: 'Deliveries', href: '/shop-floor/deliveries', icon: 'M3 6h12v11H3V6Zm12 4h3l3 3v4h-6v-7ZM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z' },
  ];
%>
<nav class="shop-floor-subnav mb-4" aria-label="Shop Floor apps">
  <div class="shop-floor-subnav-scroll">
    <% tabs.forEach((tab) => { %>
      <a
        href="<%= tab.href %>"
        class="shop-floor-subnav-pill <%= activeTab === tab.key ? 'is-active' : '' %>"
        data-instant-nav="true"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="<%= tab.icon %>" />
        </svg>
        <span><%= tab.label %></span>
      </a>
    <% }) %>
  </div>
</nav>

<style>
  .shop-floor-subnav {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
  }
  .shop-floor-subnav-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem 0.15rem 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .shop-floor-subnav-scroll::-webkit-scrollbar {
    display: none;
  }
  .shop-floor-subnav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .shop-floor-subnav-pill:hover {
    color: #0f172a;
    background: #f8fafc;
    border-color: #cbd5e1;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
  }
  .shop-floor-subnav-pill.is-active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
  }
  .shop-floor-subnav-pill.is-active svg {
    stroke: #ffffff;
  }
</style>
