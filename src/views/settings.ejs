              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>Mapping</th>
                    <th>Status</th>
                    <th>Selected Field</th>
                    <th>Odoo Label</th>
                    <th>Raw Type</th>
                  </tr>
