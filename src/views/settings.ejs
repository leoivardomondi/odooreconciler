              <select class="form-select" name="deltaJsonField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.deltaJsonField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
                  </option>
                <% }) %>
              </select>
              <div class="form-text">
                If you use <code>x_studio_job_summary_delta_json</code>, treat it as extracted Job Summary input for stock reconciliation, not a PDF delta.
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Stock Processed Field</label>
              <select class="form-select" name="stockProcessedField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.stockProcessedField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
                  </option>
                <% }) %>
              </select>
              <div class="form-text">
                Stores whether stock reconciliation has already been completed for this Sales Order.
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Stock Signature Field</label>
              <select class="form-select" name="stockSignatureField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.stockSignatureField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
                  </option>
                <% }) %>
              </select>
