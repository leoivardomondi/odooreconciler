            </div>
            <div class="col-md-6">
              <label class="form-label">Previous JSON Field</label>
              <select class="form-select" name="previousJsonField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.previousJsonField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
