<%- include('partials/head') %>
<%- include('partials/header') %>

<style>
  .automation-shell{background:#f8fafc;border:1px solid #e2e8f0;border-radius:20px;padding:1.25rem}
  .automation-schedule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:1.25rem}
  .automation-schedule__item{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px 16px;box-shadow:0 3px 14px rgba(15,23,42,.04)}
  .automation-schedule__item strong{display:block;color:#1e293b;font-size:.92rem;margin-bottom:3px}
  .automation-schedule__item span{color:#64748b;font-size:.78rem;line-height:1.4}
  .email-automation-row{background:#fff;border:1px solid #e2e8f0!important;border-radius:18px!important;padding:0!important;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,.055);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
  .email-automation-row:hover{border-color:#cbd5e1!important;box-shadow:0 12px 30px rgba(15,23,42,.08);transform:translateY(-1px)}
  .automation-card__header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 18px;border-bottom:1px solid #edf2f7;background:linear-gradient(180deg,#fff,#fbfdff)}
  .automation-card__identity{display:flex;align-items:center;gap:12px;min-width:0}
  .automation-card__icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#f0f0ff;color:#34315f;font-weight:800;font-size:1.05rem}
  .automation-card__title{font-weight:750;color:#172033;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .automation-card__type{color:#64748b;font-size:.76rem}
  .automation-card__body{padding:18px}
  .automation-field .form-label{font-size:.73rem;font-weight:750;letter-spacing:.025em;text-transform:uppercase;color:#64748b;margin-bottom:7px}
  .automation-field .form-control,.automation-field .form-select,.automation-field .input-group-text{min-height:44px;border-color:#dbe3ec;background-color:#fff;border-radius:11px;font-size:.9rem}
  .automation-field .form-control:focus,.automation-field .form-select:focus{border-color:#7672b4;box-shadow:0 0 0 .2rem rgba(78,73,137,.12)}
  .automation-field .input-group .form-control{border-radius:11px 0 0 11px}
  .automation-field .input-group-text{border-radius:0 11px 11px 0;color:#64748b}
  .automation-remove{color:#b42318;font-size:.78rem}
  .operator-note{display:flex;gap:10px;align-items:flex-start;background:#eef8f4;border:1px solid #cce9df;border-radius:14px;padding:13px 15px;color:#315c50;font-size:.82rem;line-height:1.5;margin-bottom:1rem}
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
  .settings-sidebar-nav .nav-link {
    color: #475569;
    font-weight: 500;
    font-size: 0.88rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.55rem 0.85rem;
  }
  .settings-sidebar-nav .nav-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
  }
  .settings-sidebar-nav .nav-link.active {
    background-color: #4f46e5;
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
  }
  .mobile-settings-pills {
    display: flex;
    overflow-x: auto;
    white-space: nowrap;
    gap: 8px;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-settings-pills::-webkit-scrollbar { height: 4px; }
  .mobile-settings-pills::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  @media(max-width:767.98px){.automation-shell{padding:.9rem}.automation-schedule{grid-template-columns:1fr}.automation-card__header{align-items:flex-start}.automation-card__body{padding:14px}.automation-card__identity{align-items:flex-start}}
</style>

<main class="container py-4 py-lg-5">
  <%
    const fieldTypeBadge = (value) => {
      if (value === 'boolean') return 'success';
      if (value === 'datetime') return 'info';
      if (value === 'text' || value === 'html') return 'secondary';
      if (value === 'integer' || value === 'float' || value === 'monetary') return 'warning';
      return 'dark';
    };
    const diagnosticBadge = (value) => {
      if (value === 'matched') return 'success';
      if (value === 'missing') return 'warning';
      return 'danger';
    };
  %>
  <section class="hero-panel mb-4">
    <div>
      <p class="eyebrow">Settings</p>
      <h1 class="display-6 mb-2">Control field mappings and parser behavior</h1>
      <p class="lead text-secondary mb-0">
        Every Odoo target field and parser rule stays configurable here so the app can adapt to each deployment.
      </p>
    </div>
    <div class="meta-card">
      <span class="meta-label">Active Company</span>
      <strong><%= activeOdooCompanyName %></strong>
      <div class="small text-secondary mt-2">
        Sales Orders, stock reconciliation, and scheduler actions are restricted to this company.
      </div>
    </div>
  </section>

  <%- include('partials/alerts', { status, validationErrors }) %>

  <form method="post" action="/settings/clear-cache" class="mb-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
    <button
      type="submit"
      class="btn btn-outline-danger"
      data-confirm="Clear cached Odoo field lists and browser asset cache?"
    >
      Clear Cache
    </button>
    <span class="text-secondary small ms-2">Clears cached field lists and asks the browser to refresh cached assets.</span>
  </form>

  <div class="row g-4">
    <!-- Side Panel Navigation Menu (Sticky Sidebar) -->
    <div class="col-lg-3 col-xl-3">
      <!-- Mobile Quick Horizontal Scroller -->
      <div class="d-lg-none mb-3">
        <div class="mobile-settings-pills">
          <a class="btn btn-sm btn-outline-primary active" href="#section-payroll-bridge">💳 Payroll</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-outgoing-mail">✉️ Mail</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-odoo-credentials">🔐 Credentials</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-field-mappings">📋 Mappings</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-ai-parser">🤖 AI Parser</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-ocr-engine">👁️ OCR Engine</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-failure-reports">📊 Reports</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-main-scheduler">⏱️ Main Cron</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-po-bill-scheduler">🧾 PO Cron</a>
          <a class="btn btn-sm btn-outline-primary" href="#section-stock-mappings">📦 Stock</a>
        </div>
      </div>

      <!-- Desktop Sticky Side Panel Menu -->
      <div class="card shadow-sm border-0 app-card sticky-top d-none d-lg-block" style="top: 85px; z-index: 100;">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
            <span class="fs-5">⚙️</span>
            <h2 class="h6 mb-0 fw-bold">Settings Areas</h2>
          </div>
          <nav id="settings-side-nav" class="nav flex-column settings-sidebar-nav">
            <a class="nav-link active" href="#section-payroll-bridge">
              <span>💳</span> Payroll Bridge
            </a>
            <a class="nav-link" href="#section-outgoing-mail">
              <span>✉️</span> Outgoing Mail
            </a>
            <a class="nav-link" href="#section-odoo-credentials">
              <span>🔐</span> Odoo Credentials
            </a>
            <a class="nav-link" href="#section-field-mappings">
              <span>📋</span> Field Mappings
            </a>
            <a class="nav-link" href="#section-ai-parser">
              <span>🤖</span> AI Invoice Parser
            </a>
            <a class="nav-link" href="#section-ocr-engine">
              <span>👁️</span> OCR Engine
            </a>
            <a class="nav-link" href="#section-failure-reports">
              <span>📊</span> Failure Reports
            </a>
            <a class="nav-link" href="#section-main-scheduler">
              <span>⏱️</span> Main Scheduler
            </a>
            <a class="nav-link" href="#section-po-bill-scheduler">
              <span>🧾</span> PO Bill Scheduler
            </a>
            <a class="nav-link" href="#section-stock-mappings">
              <span>📦</span> Stock Mappings
            </a>
          </nav>
        </div>
      </div>
    </div>

    <!-- Main Settings Forms Column -->
    <div class="col-lg-9 col-xl-9">
      <form method="post" action="/settings/payroll-bridge" class="mb-4" id="section-payroll-bridge">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
    <div class="card shadow-sm border-0 app-card">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1">Payroll Bridge</h2>
            <p class="text-secondary small mb-0">Admin-managed token and pay-run automation settings for the Python payroll service.</p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button
              type="submit"
              formaction="/settings/test-payroll-bridge"
              formmethod="post"
              formnovalidate
              class="btn btn-outline-secondary"
            >
              Test Bridge
            </button>
            <button type="submit" class="btn btn-primary">Save Payroll Bridge</button>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-7">
            <label class="form-label">Bridge URL</label>
            <input
              type="url"
              class="form-control font-monospace"
              name="payrollBridgeUrl"
              value="<%= form.payrollBridgeUrl %>"
              placeholder="https://app.urbanvibeinteriordesign.co.ke/odoo-payroll"
            />
          </div>
          <div class="col-lg-5">
            <label class="form-label">Bridge Token</label>
            <input
              type="password"
              class="form-control"
              name="payrollBridgeToken"
              autocomplete="new-password"
              placeholder="<%= form.hasPayrollBridgeToken ? 'Keep stored token' : 'Paste bridge token' %>"
            />
            <% if (form.hasPayrollBridgeToken) { %>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearPayrollBridgeToken" id="clearPayrollBridgeToken" />
                <label class="form-check-label small" for="clearPayrollBridgeToken">Clear saved token</label>
              </div>
            <% } %>
          </div>
          <div class="col-md-4">
            <label class="form-label">Advance Source</label>
            <input type="text" class="form-control" name="payrollAdvanceSource" value="<%= form.payrollAdvanceSource %>" />
          </div>
          <div class="col-md-4">
            <label class="form-label">Salary Structure</label>
            <input type="text" class="form-control" name="payrollSalaryStructure" value="<%= form.payrollSalaryStructure %>" placeholder="All" />
          </div>
          <div class="col-md-4">
            <label class="form-label">Pay Run Name Template</label>
            <input type="text" class="form-control font-monospace" name="payrollPayRunNameTemplate" value="<%= form.payrollPayRunNameTemplate %>" placeholder="{monthName} {year}" />
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="payrollAutoCreatePayRun" id="payrollAutoCreatePayRun" <%= form.payrollAutoCreatePayRun ? 'checked' : '' %> />
              <label class="form-check-label" for="payrollAutoCreatePayRun">
                Automatically create Odoo pay run after sharing monthly salary advances
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <% if (saleOrderFieldState.errorMessage) { %>
    <div class="alert alert-<%= saleOrderFieldState.fields.length ? 'warning' : 'danger' %> shadow-sm" role="alert">
      <%= saleOrderFieldState.fields.length ? 'Using cached sale.order fields. ' : '' %><%= saleOrderFieldState.errorMessage %>
    </div>
  <% } %>

  <% if (missingMappings && missingMappings.length) { %>
    <div class="alert alert-warning shadow-sm" role="alert">
      Some field mappings still need attention: <%= missingMappings.join(', ') %>. The app will skip any unmapped values until you choose valid Odoo fields.
    </div>
  <% } %>

  <form method="post" action="/settings/mail" class="mb-4" id="section-outgoing-mail">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
    <div class="card shadow-sm border-0 app-card">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1">Outgoing Mail</h2>
            <p class="text-secondary small mb-0">Admin-managed SMTP for scheduled notifications and mail testing.</p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button
              type="submit"
              formaction="/settings/test-mail"
              formmethod="post"
              formnovalidate
              class="btn btn-outline-secondary"
            >
              Send Test
            </button>
            <button type="submit" class="btn btn-primary">Save Mail Settings</button>
          </div>
        </div>

        <div class="row g-3">
          <input type="hidden" name="mailTransport" value="smtp" />
          <input type="hidden" name="mailFallbackTransport" value="none" />
          <div class="col-md-4">
            <label class="form-label">Provider Preset</label>
            <select class="form-select" name="mailPreset">
              <option value="zoho-587" <%= form.mailPreset === 'zoho-587' ? 'selected' : '' %>>Zoho SMTP - 587 STARTTLS</option>
              <option value="zoho-465" <%= form.mailPreset === 'zoho-465' ? 'selected' : '' %>>Zoho SMTP - 465 SSL/TLS</option>
              <option value="cpanel-465" <%= form.mailPreset === 'cpanel-465' ? 'selected' : '' %>>cPanel SMTP - 465 SSL/TLS</option>
              <option value="custom" <%= form.mailPreset === 'custom' ? 'selected' : '' %>>Custom SMTP</option>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label">SMTP Host</label>
            <input type="text" class="form-control font-monospace" name="mailHost" value="<%= form.mailHost %>" placeholder="smtp.zoho.com" />
          </div>
          <div class="col-md-2">
            <label class="form-label">Port</label>
            <input type="number" min="1" max="65535" class="form-control" name="mailPort" value="<%= form.mailPort %>" />
          </div>
          <div class="col-12">
            <div class="d-flex flex-wrap gap-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="mailSecure" id="mailSecure" <%= form.mailSecure ? 'checked' : '' %> />
                <label class="form-check-label" for="mailSecure">SSL/TLS</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="mailRequireTls" id="mailRequireTls" <%= form.mailRequireTls ? 'checked' : '' %> />
                <label class="form-check-label" for="mailRequireTls">Require STARTTLS</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="mailIgnoreTls" id="mailIgnoreTls" <%= form.mailIgnoreTls ? 'checked' : '' %> />
                <label class="form-check-label" for="mailIgnoreTls">Ignore TLS</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="mailTlsRejectUnauthorized" id="mailTlsRejectUnauthorized" <%= form.mailTlsRejectUnauthorized ? 'checked' : '' %> />
                <label class="form-check-label" for="mailTlsRejectUnauthorized">Verify TLS certificate</label>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Connection Timeout (ms)</label>
            <input type="number" min="1000" class="form-control" name="mailConnectionTimeoutMs" value="<%= form.mailConnectionTimeoutMs %>" />
          </div>
          <div class="col-md-4">
            <label class="form-label">Greeting Timeout (ms)</label>
            <input type="number" min="1000" class="form-control" name="mailGreetingTimeoutMs" value="<%= form.mailGreetingTimeoutMs %>" />
          </div>
          <div class="col-md-4">
            <label class="form-label">Socket Timeout (ms)</label>
            <input type="number" min="1000" class="form-control" name="mailSocketTimeoutMs" value="<%= form.mailSocketTimeoutMs %>" />
          </div>
          <div class="col-12">
            <label class="form-label">Test Recipient</label>
            <input type="email" class="form-control" name="mailTestRecipient" value="<%= form.mailTestRecipient %>" placeholder="dbadmin@urbanvibeinteriordesign.co.ke" />
          </div>
        </div>

        <hr class="my-4" />

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width: 80px;">Active</th>
                <th>Label</th>
                <th>Username</th>
                <th>Password</th>
                <th>From Email</th>
                <th>From Name</th>
              </tr>
            </thead>
            <tbody>
              <% form.mailAccounts.forEach((account) => { %>
                <tr>
                  <td>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="mailAccount<%= account.index %>Enabled"
                        id="mailAccount<%= account.index %>Enabled"
                        <%= account.enabled ? 'checked' : '' %>
                      />
                    </div>
                  </td>
                  <td>
                    <input type="text" class="form-control" name="mailAccount<%= account.index %>Label" value="<%= account.label %>" />
                  </td>
                  <td>
                    <input type="email" class="form-control" name="mailAccount<%= account.index %>Username" value="<%= account.username %>" placeholder="user@example.com" />
                  </td>
                  <td>
                    <input
                      type="password"
                      class="form-control"
                      name="mailAccount<%= account.index %>Password"
                      autocomplete="new-password"
                      placeholder="<%= account.hasPassword ? 'Keep stored password' : 'SMTP password' %>"
                    />
                    <% if (account.hasPassword) { %>
                      <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="mailAccount<%= account.index %>ClearPassword" id="mailAccount<%= account.index %>ClearPassword" />
                        <label class="form-check-label small" for="mailAccount<%= account.index %>ClearPassword">Clear saved password</label>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <input type="email" class="form-control" name="mailAccount<%= account.index %>FromEmail" value="<%= account.fromEmail %>" placeholder="user@example.com" />
                  </td>
                  <td>
                    <input type="text" class="form-control" name="mailAccount<%= account.index %>FromName" value="<%= account.fromName %>" placeholder="Odoo Reconciler" />
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <hr class="my-4" />
        <div class="automation-shell">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
          <div>
            <h3 class="h4 mb-1">Email Automation</h3>
            <p class="text-secondary small mb-0">Manage operational schedules, recipients and custom messages from one place.</p>
          </div>
          <button type="button" class="btn btn-primary rounded-pill px-3" id="addEmailAutomation">+ Add automation</button>
        </div>
        <div class="automation-schedule">
          <div class="automation-schedule__item"><strong>Monday–Friday</strong><span>Operator reminders run hourly from 8:00 AM through 5:00 PM.</span></div>
          <div class="automation-schedule__item"><strong>Saturday</strong><span>Operator reminders run hourly from 8:00 AM through 3:00 PM. Nothing is sent on Sunday.</span></div>
          <div class="automation-schedule__item"><strong>8:00 AM performance email</strong><span>Boards and attendance use the previous working day. Monday reports use Saturday’s results.</span></div>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-lg-5 automation-field">
            <label class="form-label" for="shopFloorReportingStartDate">Shop-floor reporting start date</label>
            <input
              type="date"
              class="form-control"
              id="shopFloorReportingStartDate"
              name="shopFloorReportingStartDate"
              value="<%= form.shopFloorReportingStartDate %>"
              required
            />
            <div class="form-text">Boards, board records, operator percentages, attendance summaries and Wednesday reports will not include historical data before this date.</div>
          </div>
        </div>
        <div class="operator-note"><strong>Operator matching:</strong><span>Personal performance emails are sent only when the recipient matches an employee in Odoo. Non-operators, including management recipients, do not receive operator board or attendance summaries.</span></div>
        <input type="hidden" name="mailAutomationCount" id="mailAutomationCount" value="<%= form.mailAutomations.length %>" />
        <div id="emailAutomationRows" class="vstack gap-3">
          <% form.mailAutomations.forEach((item, itemIndex) => { const n = itemIndex + 1; %>
            <div class="email-automation-row" data-system-key="<%= item.systemKey %>">
              <input type="hidden" name="mailAutomation<%= n %>Id" value="<%= item.id %>" />
              <input type="hidden" name="mailAutomation<%= n %>SystemKey" value="<%= item.systemKey %>" />
              <div class="automation-card__header">
                <div class="automation-card__identity"><div class="automation-card__icon">✉</div><div><div class="automation-card__title"><%= item.name %></div><div class="automation-card__type"><%= item.systemKey === 'custom' ? 'Custom scheduled email' : 'Built-in operational email' %></div></div></div>
                <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" name="mailAutomation<%= n %>Enabled" id="mailAutomation<%= n %>Enabled" <%= item.enabled ? 'checked' : '' %>><label class="form-check-label small fw-semibold" for="mailAutomation<%= n %>Enabled"><%= item.enabled ? 'Active' : 'Paused' %></label></div>
              </div>
              <div class="automation-card__body"><div class="row g-3">
                <div class="col-lg-4 automation-field"><label class="form-label">Automation name</label><input class="form-control" name="mailAutomation<%= n %>Name" value="<%= item.name %>" required></div>
                <div class="col-sm-6 col-lg-2 automation-field"><label class="form-label">Frequency</label><select class="form-select automation-frequency" name="mailAutomation<%= n %>Frequency"><option value="hourly" <%= item.frequency === 'hourly' ? 'selected' : '' %>>Hourly</option><option value="daily" <%= item.frequency === 'daily' ? 'selected' : '' %>>Daily</option><option value="weekly" <%= item.frequency === 'weekly' ? 'selected' : '' %>>Weekly</option></select></div>
                <div class="col-sm-6 col-lg-2 automation-field"><label class="form-label">Repeat every</label><div class="input-group"><input type="number" min="1" max="168" class="form-control" name="mailAutomation<%= n %>Interval" value="<%= item.interval %>"><span class="input-group-text">cycle</span></div></div>
                <div class="col-sm-6 col-lg-2 automation-field send-hour-field"><label class="form-label">Send hour (0–23)</label><input type="number" min="0" max="23" class="form-control" name="mailAutomation<%= n %>Hour" value="<%= item.hour %>"></div>
                <div class="col-sm-6 col-lg-2 automation-field weekly-field"><label class="form-label">Weekly day</label><select class="form-select" name="mailAutomation<%= n %>DayOfWeek"><% ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].forEach((day, dayIndex) => { %><option value="<%= dayIndex %>" <%= item.dayOfWeek === dayIndex ? 'selected' : '' %>><%= day %></option><% }) %></select></div>
                <div class="col-lg-10 automation-field">
                  <label class="form-label d-flex justify-content-between align-items-center mb-1">
                    <span>Recipients</span>
                    <span class="small text-muted" style="font-size: 0.75rem;">Click <strong>&times;</strong> on any badge to remove recipient</span>
                  </label>
                  <div class="automation-pills-wrapper p-2 bg-light rounded border mb-2 d-flex flex-wrap align-items-center gap-1" id="recipientPills_<%= n %>"></div>
                  <div class="row g-2 align-items-center">
                    <div class="col-md-6 col-lg-5">
                      <div class="input-group input-group-sm">
                        <input type="email" class="form-control automation-add-input" id="addEmailInput_<%= n %>" placeholder="Add email address..." onkeydown="if(event.key==='Enter'){event.preventDefault();addEmailFromInput(<%= n %>);}">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addEmailFromInput(<%= n %>)">+ Add</button>
                      </div>
                    </div>
                    <% if (typeof approvedUsers !== 'undefined' && approvedUsers && approvedUsers.length > 0) { %>
                      <div class="col-md-6 col-lg-7">
                        <div class="d-flex align-items-center flex-wrap gap-1">
                          <span class="small text-muted me-1" style="font-size: 0.75rem;">Quick add:</span>
                          <% approvedUsers.filter(u => u.active && u.email).forEach(u => { %>
                            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 rounded-pill small me-1 mb-1" style="font-size: 0.72rem;" onclick="addEmailDirect(<%= n %>, '<%= u.email %>')">+ <%= u.email %></button>
                          <% }) %>
                        </div>
                      </div>
                    <% } %>
                  </div>
                  <input type="hidden" name="mailAutomation<%= n %>Recipients" id="mailAutomation<%= n %>Recipients" class="automation-recipients-hidden" value="<%= item.recipients %>" />
                </div>
                <div class="col-lg-2 d-flex align-items-end"><label class="form-check automation-remove mb-2"><input class="form-check-input" type="checkbox" name="mailAutomation<%= n %>Remove"> Remove on save</label></div>
                <div class="automation-custom-fields <%= item.systemKey === 'custom' ? 'row g-3 mx-0 px-0' : 'd-none' %>">
                  <div class="col-lg-5 automation-field"><label class="form-label">Email subject</label><input class="form-control" name="mailAutomation<%= n %>Subject" value="<%= item.subject %>"></div>
                  <div class="col-lg-7 automation-field"><label class="form-label">Email message</label><textarea class="form-control" rows="3" name="mailAutomation<%= n %>Body"><%= item.body %></textarea></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        </div>
      </div>
    </div>
  </form>

  <script>
    function parseEmails(str) {
      return [...new Set((str || '').split(/[\s,\n;]+/).map(e => e.trim().toLowerCase()).filter(Boolean))];
    }

    window.renderRecipientPills = function(n) {
      const hiddenInput = document.getElementById(`mailAutomation${n}Recipients`);
      const container = document.getElementById(`recipientPills_${n}`);
      if (!hiddenInput || !container) return;

      const emails = parseEmails(hiddenInput.value);
      container.innerHTML = '';

      if (emails.length === 0) {
        container.innerHTML = `<span class="badge bg-warning-subtle text-dark border border-warning-subtle py-1 px-2 me-1" style="font-weight: 500;">Default System Users (all active approved users)</span>`;
      } else {
        emails.forEach(email => {
          const pill = document.createElement('span');
          pill.className = 'badge bg-white text-dark border shadow-sm py-1 px-2 d-inline-flex align-items-center gap-1 font-monospace me-1 mb-1';
          pill.style.fontSize = '0.82rem';
          pill.innerHTML = `
            <span>${email}</span>
            <button type="button" class="btn-close ms-1" style="font-size: 0.55rem; padding: 2px;" aria-label="Remove ${email}" onclick="removeEmailDirect(${n}, '${email}')" title="Remove ${email}"></button>
          `;
          container.appendChild(pill);
        });
      }
    };

    window.removeEmailDirect = function(n, emailToRemove) {
      const hiddenInput = document.getElementById(`mailAutomation${n}Recipients`);
      if (!hiddenInput) return;
      const emails = parseEmails(hiddenInput.value).filter(e => e !== emailToRemove.toLowerCase());
      hiddenInput.value = emails.join(', ');
      renderRecipientPills(n);
    };

    window.addEmailDirect = function(n, emailToAdd) {
      const clean = (emailToAdd || '').trim().toLowerCase();
      if (!clean || !clean.includes('@')) return;
      const hiddenInput = document.getElementById(`mailAutomation${n}Recipients`);
      if (!hiddenInput) return;
      const emails = parseEmails(hiddenInput.value);
      if (!emails.includes(clean)) {
        emails.push(clean);
        hiddenInput.value = emails.join(', ');
        renderRecipientPills(n);
      }
    };

    window.addEmailFromInput = function(n) {
      const input = document.getElementById(`addEmailInput_${n}`);
      if (input && input.value) {
        addEmailDirect(n, input.value);
        input.value = '';
      }
    };

    (() => {
      const button = document.getElementById('addEmailAutomation');
      const rows = document.getElementById('emailAutomationRows');
      const count = document.getElementById('mailAutomationCount');
      if (!button || !rows || !count) return;
      const refreshAutomationRow = (row) => {
        const frequency = row.querySelector('.automation-frequency')?.value;
        const weeklyField = row.querySelector('.weekly-field');
        const sendHourField = row.querySelector('.send-hour-field');
        if (weeklyField) weeklyField.classList.toggle('d-none', frequency !== 'weekly');
        if (sendHourField) sendHourField.classList.toggle('d-none', frequency === 'hourly');
      };
      rows.querySelectorAll('.email-automation-row').forEach(refreshAutomationRow);
      rows.addEventListener('change', (event) => {
        const row = event.target.closest('.email-automation-row');
        if (!row) return;
        if (event.target.classList.contains('automation-frequency')) refreshAutomationRow(row);
        if (event.target.matches('[role="switch"]')) {
          const label = row.querySelector(`label[for="${event.target.id}"]`);
          if (label) label.textContent = event.target.checked ? 'Active' : 'Paused';
        }
      });
      button.addEventListener('click', () => {
        const n = Number(count.value || 0) + 1;
        if (n > 20) return;
        count.value = String(n);
        const wrapper = document.createElement('div');
        wrapper.className = 'email-automation-row';
        wrapper.dataset.systemKey = 'custom';
        wrapper.innerHTML = `
          <input type="hidden" name="mailAutomation${n}Id" value="custom-${Date.now()}">
          <input type="hidden" name="mailAutomation${n}SystemKey" value="custom">
          <div class="automation-card__header">
            <div class="automation-card__identity"><div class="automation-card__icon">✉</div><div><div class="automation-card__title">New email automation</div><div class="automation-card__type">Custom scheduled email</div></div></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" name="mailAutomation${n}Enabled" id="mailAutomation${n}Enabled" checked><label class="form-check-label small fw-semibold" for="mailAutomation${n}Enabled">Active</label></div>
          </div>
          <div class="automation-card__body"><div class="row g-3">
            <div class="col-lg-4 automation-field"><label class="form-label">Automation name</label><input class="form-control" name="mailAutomation${n}Name" required></div>
            <div class="col-sm-6 col-lg-2 automation-field"><label class="form-label">Frequency</label><select class="form-select automation-frequency" name="mailAutomation${n}Frequency"><option value="hourly">Hourly</option><option value="daily" selected>Daily</option><option value="weekly">Weekly</option></select></div>
            <div class="col-sm-6 col-lg-2 automation-field"><label class="form-label">Repeat every</label><div class="input-group"><input type="number" min="1" max="168" class="form-control" name="mailAutomation${n}Interval" value="1"><span class="input-group-text">cycle</span></div></div>
            <div class="col-sm-6 col-lg-2 automation-field send-hour-field"><label class="form-label">Send hour (0–23)</label><input type="number" min="0" max="23" class="form-control" name="mailAutomation${n}Hour" value="8"></div>
            <div class="col-sm-6 col-lg-2 automation-field weekly-field d-none"><label class="form-label">Weekly day</label><select class="form-select" name="mailAutomation${n}DayOfWeek"><option value="0">Sunday</option><option value="1" selected>Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option></select></div>
            <div class="col-lg-10 automation-field">
              <label class="form-label d-flex justify-content-between align-items-center mb-1">
                <span>Recipients</span>
                <span class="small text-muted" style="font-size: 0.75rem;">Click <strong>&times;</strong> on any badge to remove recipient</span>
              </label>
              <div class="automation-pills-wrapper p-2 bg-light rounded border mb-2 d-flex flex-wrap align-items-center gap-1" id="recipientPills_${n}"></div>
              <div class="input-group input-group-sm" style="max-width: 320px;">
                <input type="email" class="form-control automation-add-input" id="addEmailInput_${n}" placeholder="Add email address..." onkeydown="if(event.key==='Enter'){event.preventDefault();addEmailFromInput(${n});}">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addEmailFromInput(${n})">+ Add</button>
              </div>
              <input type="hidden" name="mailAutomation${n}Recipients" id="mailAutomation${n}Recipients" class="automation-recipients-hidden" value="" />
            </div>
            <div class="col-lg-2 d-flex align-items-end"><label class="form-check automation-remove mb-2"><input class="form-check-input" type="checkbox" name="mailAutomation${n}Remove"> Remove on save</label></div>
            <div class="automation-custom-fields row g-3 mx-0 px-0"><div class="col-lg-5 automation-field"><label class="form-label">Email subject</label><input class="form-control" name="mailAutomation${n}Subject" required></div><div class="col-lg-7 automation-field"><label class="form-label">Email message</label><textarea class="form-control" rows="3" name="mailAutomation${n}Body" required></textarea></div></div>
          </div></div>`;
        rows.appendChild(wrapper);
        refreshAutomationRow(wrapper);
        renderRecipientPills(n);
        wrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      // Initialize recipient pills for all existing automation rows
      const totalAutomations = Number(count.value || 0);
      for (let i = 1; i <= totalAutomations; i++) {
        renderRecipientPills(i);
      }
    })();
  </script>

  <form method="post" action="/settings" class="row g-4" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
    <div class="col-xl-6" id="section-odoo-credentials">
      <div class="card shadow-sm border-0 app-card h-100">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
