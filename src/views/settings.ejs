            </div>
            <div class="col-md-4">
              <label class="form-label">AI Provider</label>
              <select class="form-select" name="aiProvider">
                <option value="disabled" <%= form.aiProvider === 'disabled' ? 'selected' : '' %>>Disabled</option>
                <option value="nvidia" <%= form.aiProvider === 'nvidia' ? 'selected' : '' %>>NVIDIA NIM</option>
                <option value="openai" <%= form.aiProvider === 'openai' ? 'selected' : '' %>>OpenAI</option>
                <option value="gemini" <%= form.aiProvider === 'gemini' ? 'selected' : '' %>>Google Gemini</option>
                <option value="anthropic" <%= form.aiProvider === 'anthropic' ? 'selected' : '' %>>Anthropic Claude</option>
                <option value="openrouter" <%= form.aiProvider === 'openrouter' ? 'selected' : '' %>>OpenRouter</option>
