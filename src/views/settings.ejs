                <input class="form-check-input" type="checkbox" name="clearGeminiApiKey" id="clearGeminiApiKey" />
                <label class="form-check-label small" for="clearGeminiApiKey">Clear saved Gemini key</label>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Anthropic API Key</label>
              <input type="password" class="form-control" name="anthropicApiKey" placeholder="<%= form.hasAnthropicApiKey ? 'Keep stored key' : 'Paste key' %>" />
