            <div class="col-12">
              <div class="rounded-4 border p-3 p-md-4" style="background:linear-gradient(135deg,#f8fafc,#eff6ff)">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                  <div>
                    <h3 class="h6 mb-1">Document failure retry policy</h3>
                    <p class="small text-secondary mb-0">Controls when an unchanged failed document becomes eligible for another automatic check.</p>
                  </div>
                  <span class="badge rounded-pill text-bg-primary">Recommended defaults</span>
                </div>
                <div class="row g-3">
                  <div class="col-md-3">
                    <label class="form-label" for="poBillSchedulerMaxRetryAttempts">Maximum Attempts</label>
                    <input id="poBillSchedulerMaxRetryAttempts" type="number" min="1" max="20" class="form-control" name="poBillSchedulerMaxRetryAttempts" value="<%= form.poBillSchedulerMaxRetryAttempts %>" />
                    <div class="form-text">Stop automatic retries after this many attempts.</div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label" for="poBillSchedulerTransientRetryHours">OCR/API Retry</label>
                    <div class="input-group">
                      <input id="poBillSchedulerTransientRetryHours" type="number" min="1" max="168" class="form-control" name="poBillSchedulerTransientRetryHours" value="<%= form.poBillSchedulerTransientRetryHours %>" />
                      <span class="input-group-text">hours</span>
                    </div>
                    <div class="form-text">For timeouts, OCR, network and API errors.</div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label" for="poBillSchedulerStableSkipRetryDays">Non-bill Recheck</label>
                    <div class="input-group">
                      <input id="poBillSchedulerStableSkipRetryDays" type="number" min="1" max="365" class="form-control" name="poBillSchedulerStableSkipRetryDays" value="<%= form.poBillSchedulerStableSkipRetryDays %>" />
                      <span class="input-group-text">days</span>
                    </div>
                    <div class="form-text">For Job Summary or non-vendor documents.</div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label" for="poBillSchedulerRetryBackoffHours">PO Match Backoff</label>
                    <input id="poBillSchedulerRetryBackoffHours" type="text" class="form-control font-monospace" name="poBillSchedulerRetryBackoffHours" value="<%= form.poBillSchedulerRetryBackoffHours %>" placeholder="168, 168, 168, 168, 168" />
                    <div class="form-text">Hours after consecutive failed match attempts.</div>
                  </div>
                </div>
                <div class="alert alert-warning border-0 small mt-3 mb-0">
                  Recommended: scheduler every <strong>15–45 minutes</strong>; OCR/API retry after <strong>2 hours</strong>; PO matching backoff <strong>168 hours (7 days per attempt)</strong>; non-bills every <strong>14 days</strong>. Manual “Check now” can still run immediately.
                </div>
              </div>
            </div>
            <div class="col-12">
              <div class="alert alert-light border small mb-0" role="alert">
                Cron URL: <code><%= `${appBaseUrl}/jobs/run-po-bill-scheduler?token=${form.poBillSchedulerCronToken || form.schedulerCronToken || 'set-a-token-in-settings'}` %></code>
              </div>
            </div>
          </div>

          <hr class="my-4" />

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" id="section-stock-mappings">
            <h2 class="h4 mb-0">Stock Reconciliation Configuration</h2>
            <button type="submit" name="settingsSection" value="stock" class="btn btn-sm btn-primary">
              Save Stock
            </button>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Stock Location ID</label>
              <input
                type="text"
                class="form-control font-monospace"
                name="stockLocationId"
                value="<%= form.stockLocationId %>"
                placeholder="Preferred when known"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Stock Location Fallback Name</label>
              <input
                type="text"
                class="form-control"
                name="stockLocationName"
                value="<%= form.stockLocationName %>"
                placeholder="Used when Location ID is blank"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Warehouse ID (optional)</label>
              <input
                type="text"
                class="form-control font-monospace"
                name="stockWarehouseId"
                value="<%= form.stockWarehouseId %>"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Picking Type ID (optional)</label>
              <input
                type="text"
                class="form-control font-monospace"
                name="stockPickingTypeId"
                value="<%= form.stockPickingTypeId %>"
              />
            </div>
            <div class="col-12">
              <label class="form-label">Missing Sales Order Items Alert User (optional)</label>
              <input
                type="text"
                class="form-control"
                name="stockMissingSoAlertUserLogin"
                value="<%= form.stockMissingSoAlertUserLogin %>"
                placeholder="user@example.com"
              />
              <div class="form-text">
                When set, chatter for extracted edging items missing from the Sales Order will prepend a mention-style name and address the alert to this Odoo user.
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Missing BOM Component Alert User (optional)</label>
              <input
                type="text"
                class="form-control"
                name="stockMissingComponentAlertUserLogin"
                value="<%= form.stockMissingComponentAlertUserLogin %>"
                placeholder="user@example.com"
              />
              <div class="form-text">
                When set, chatter for missing BOM components will prepend a mention-style name and address the alert to this Odoo user.
              </div>
            </div>
          </div>

          <div class="alert alert-light border small mt-3 mb-0" role="alert">
            cPanel recommendation: leave in-process interval off and trigger the scheduler from cron using a protected URL. This is more reliable when Passenger sleeps idle apps.
          </div>

          <div class="mt-4 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary px-4">Save All Settings</button>
            <a href="/dashboard" class="btn btn-link text-decoration-none">Back to Dashboard</a>
          </div>
        </div>
      </div>
    </div>
    </div><!-- /.col-lg-9 -->
  </div><!-- /.row -->
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sideNavLinks = document.querySelectorAll('#settings-side-nav .nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-settings-pills a');
    const allNavLinks = [...sideNavLinks, ...mobileLinks];

    const sectionElements = Array.from(document.querySelectorAll('[id^="section-"]'));

    function updateActiveNav() {
      const scrollPos = window.scrollY + 130;
      let currentId = '';

      for (const section of sectionElements) {
        if (section.offsetTop <= scrollPos) {
          currentId = section.id;
        }
      }

      if (!currentId && sectionElements.length > 0) {
        currentId = sectionElements[0].id;
      }

      sideNavLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        if (href === '#' + currentId) {
          link.classList.add('active', 'fw-bold');
        } else {
          link.classList.remove('active', 'fw-bold');
        }
      });

      mobileLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        if (href === '#' + currentId) {
          link.classList.add('active', 'btn-primary');
          link.classList.remove('btn-outline-primary');
        } else {
          link.classList.remove('active', 'btn-primary');
          link.classList.add('btn-outline-primary');
        }
      });
    }

    window.addEventListener('scroll', updateActiveNav, { passive: true });
    updateActiveNav();
  });
</script>

<%- include('partials/footer') %>
