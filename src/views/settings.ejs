            </div>
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input type="text" class="form-control" name="username" value="<%= form.username %>" required />
            </div>
            <div class="col-12">
              <label class="form-label">API Key</label>
              <input
                type="password"
                class="form-control"
                name="apiKey"
                data-clear-sensitive-field="true"
                autocomplete="new-password"
                autocapitalize="off"
                spellcheck="false"
                placeholder="<%= form.hasStoredApiKey ? 'Leave blank to keep the stored API key' : 'Paste a new Odoo API key' %>"
              />
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearStoredApiKey" id="clearStoredApiKey" <%= form.clearStoredApiKey ? 'checked' : '' %> />
                <label class="form-check-label" for="clearStoredApiKey">
                  Clear stored API key
                </label>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Shop Floor web password <span class="text-secondary fw-normal">(optional)</span></label>
              <input
                type="password"
                class="form-control"
                name="shopFloorPassword"
                data-clear-sensitive-field="true"
                autocomplete="new-password"
                autocapitalize="off"
                spellcheck="false"
                placeholder="<%= form.hasStoredShopFloorPassword ? 'Leave blank to keep the stored Shop Floor password' : 'Enter the Odoo user web-login password' %>"
              />
              <div class="form-text">
                Used only to open an authenticated Odoo Shop Floor web session. It is stored encrypted and does not replace the API key.
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearStoredShopFloorPassword" id="clearStoredShopFloorPassword" <%= form.clearStoredShopFloorPassword ? 'checked' : '' %> />
                <label class="form-check-label" for="clearStoredShopFloorPassword">
                  Clear stored Shop Floor web password
                </label>
              </div>
            </div>
            <div class="col-12" id="odoo-shop-floor-session">
              <div class="border rounded-4 bg-light p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                  <div>
                    <h3 class="h6 mb-1">Shop Floor session</h3>
                    <p class="text-secondary small mb-0">
                      Connect once with Odoo two-factor verification. The server securely reuses the session for operator Start and Finish actions and only asks again after Odoo expires it.
                    </p>
                  </div>
                  <button
                    type="submit"
                    formaction="/settings/shop-floor-session/begin"
                    formmethod="post"
                    formnovalidate
                    class="btn btn-outline-primary"
                  >
                    Request OTP
                  </button>
                </div>
                <div class="row g-2 align-items-end mt-2">
                  <div class="col-sm-7">
                    <label class="form-label" for="shopFloorOtpCode">Odoo verification code</label>
                    <input
                      type="text"
                      class="form-control font-monospace"
                      id="shopFloorOtpCode"
                      name="otpCode"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      pattern="[0-9]{4,10}"
                      maxlength="10"
                      placeholder="Enter the code from Odoo"
                    />
                  </div>
                  <div class="col-sm-5">
                    <button
                      type="submit"
                      formaction="/settings/shop-floor-session/verify"
                      formmethod="post"
                      class="btn btn-primary w-100"
                    >
                      Verify &amp; Connect
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <hr class="my-4" />

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Connection Snapshot</h2>
            <div class="d-flex flex-wrap gap-2">
              <button
                type="submit"
                formaction="/settings/test-connection"
                formmethod="post"
                class="btn btn-sm btn-outline-secondary"
              >
                Test Connection
              </button>
            </div>
          </div>
          <dl class="row small mb-0">
            <dt class="col-4 text-secondary">Status</dt>
            <dd class="col-8"><span class="badge text-bg-<%= connection.status === 'success' ? 'success' : connection.status === 'error' ? 'danger' : 'secondary' %>"><%= connection.status %></span></dd>
            <dt class="col-4 text-secondary">Checked</dt>
            <dd class="col-8"><%= formatDateTime(connection.checkedAt) %></dd>
            <dt class="col-4 text-secondary">Version</dt>
            <dd class="col-8"><%= connection.version || '—' %></dd>
            <dt class="col-4 text-secondary">Message</dt>
            <dd class="col-8"><%= connection.message || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>

