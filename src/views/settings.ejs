                  <option value="<%= field.name %>" <%= field.name === form.processedAtField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Log Field</label>
              <select class="form-select" name="logField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.logField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Attachment Name Field</label>
              <select class="form-select" name="attachmentNameField">
                <option value="">Skip this value</option>
                <% saleOrderFields.forEach((field) => { %>
                  <option value="<%= field.name %>" <%= field.name === form.attachmentNameField ? 'selected' : '' %>>
                    <%= field.label %> (<%= field.name %>) [<%= field.type %>]
