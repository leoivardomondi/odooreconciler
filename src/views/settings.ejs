              <input type="password" class="form-control" name="openaiApiKey" placeholder="<%= form.hasOpenaiApiKey ? 'Leave blank to keep stored OpenAI key' : 'Paste OpenAI API key' %>" />
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearOpenaiApiKey" id="clearOpenaiApiKey" />
                <label class="form-check-label small" for="clearOpenaiApiKey">Clear saved OpenAI key</label>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Google Gemini API Key</label>
              <input type="password" class="form-control" name="geminiApiKey" placeholder="<%= form.hasGeminiApiKey ? 'Keep stored Google key' : 'Paste Google AI Studio key' %>" />
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="clearGeminiApiKey" id="clearGeminiApiKey" />
                <label class="form-check-label small" for="clearGeminiApiKey">Clear saved Gemini key</label>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Anthropic API Key</label>
              <input type="password" class="form-control" name="anthropicApiKey" placeholder="<%= form.hasAnthropicApiKey ? 'Keep stored key' : 'Paste key' %>" />
