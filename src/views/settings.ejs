                <% }) %>
              </div>
              <% if (saleOrderFields.length > 24) { %>
                <p class="small text-secondary mt-2 mb-0">
                  <%= saleOrderFields.length %> fields available in total. All of them are included in the dropdowns above.
                </p>
              <% } %>
            </div>
          <% } %>

          <div class="mt-4">
            <h3 class="h6 text-uppercase text-secondary mb-2">Mapping Diagnostics</h3>
