            <div class="col-md-4">
              <label class="form-label">OCR Provider</label>
              <select class="form-select" name="ocrProvider">
                <option value="disabled" <%= form.ocrProvider === 'disabled' ? 'selected' : '' %>>Disabled</option>
                <option value="nvidia_nemoretriever" <%= form.ocrProvider === 'nvidia_nemoretriever' ? 'selected' : '' %>>NVIDIA Nemotron OCR</option>
