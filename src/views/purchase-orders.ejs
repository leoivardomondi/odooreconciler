<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container py-4 py-lg-5">
  <%
    const buildPageHref = (pageNumber) => `/purchase-orders${buildPurchaseOrderQuerySuffix({
      q: query,
      fromDate,
      toDate,
      page: pageNumber,
      load: true,
    })}`;
    const appStatusLabel = (order) => {
      if (order.appStatus.status === 'processed') return 'Bill Processed';
      if (order.appStatus.status === 'processed_with_warnings') return 'Processed with Warnings';
      if (order.appStatus.status === 'skipped') return 'Skipped';
      if (order.appStatus.status === 'failed') return 'Failed';
      return 'Auto Not Run';
    };
    const appStatusBadge = (order) => {
      if (order.appStatus.status === 'processed') return 'success';
      if (order.appStatus.status === 'processed_with_warnings') return 'warning';
      if (order.appStatus.status === 'skipped') return 'secondary';
      if (order.appStatus.status === 'failed') return 'danger';
      return 'secondary';
    };
  %>
  <section class="hero-panel mb-4">
    <div>
      <p class="eyebrow">Purchase Orders</p>
      <h1 class="display-6 mb-2">Track PO bill automation status</h1>
      <p class="lead text-secondary mb-0">
        Review Purchase Orders and see which ones the automatic bill matcher has already handled.
      </p>
    </div>
    <div class="hero-actions">
      <span class="meta-card">
        <span class="meta-label">From</span>
        <strong><%= fromDate || 'All' %></strong>
      </span>
      <span class="meta-card">
        <span class="meta-label">Page</span>
        <strong><%= page %></strong>
      </span>
    </div>
  </section>

  <%- include('partials/alerts', { status, validationErrors: [] }) %>

  <!-- Navigation Tabs -->
  <ul class="nav nav-pills mb-3 gap-2">
    <li class="nav-item">
      <a class="nav-link <%= activeTab !== 'company3' ? 'active fw-bold' : 'bg-white text-dark border' %> rounded-pill px-3 py-1.5" href="/purchase-orders">
        📋 All Purchase Orders
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeTab === 'company3' ? 'active fw-bold bg-dark text-white' : 'bg-white text-dark border' %> rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-2" href="/purchase-orders?tab=company3">
        <span>🏢 Company 3 ETR Moves</span>
        <% if (typeof crossCompanyCount === 'number' && crossCompanyCount > 0) { %>
          <span class="badge rounded-pill bg-warning text-dark"><%= crossCompanyCount %></span>
        <% } %>
      </a>
    </li>
  </ul>

  <div class="card shadow-sm border-0 app-card">
    <div class="card-body p-4">
      <% if (activeTab === 'company3') { %>
        <!-- Company 3 ETR Moved POs View -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <div>
            <h5 class="fw-bold mb-1">🏢 ETR Purchase Orders Moved to Company 3 (URBAN VIBE 2)</h5>
            <p class="text-secondary small mb-0">Audit log of Purchase Orders with Tax Option = <strong>ETR</strong> that have been transferred / mirrored to Company 3.</p>
          </div>
          <span class="badge bg-dark text-white px-3 py-2 rounded-pill fs-6">
            <%= (crossCompanyLogs || []).length %> Logged PO<%= (crossCompanyLogs || []).length === 1 ? '' : 's' %>
          </span>
        </div>

        <form method="get" action="/purchase-orders" class="row g-3 align-items-end mb-4">
          <input type="hidden" name="tab" value="company3" />
          <div class="col-lg-6">
            <label class="form-label small fw-semibold">Search ETR Logs</label>
            <input
              type="text"
              class="form-control"
              name="q"
              value="<%= query %>"
              placeholder="Search by source PO, target PO, vendor, bill, or payment..."
            />
          </div>
          <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary">Filter Logs</button>
          </div>
          <% if (query) { %>
            <div class="col-md-3 d-grid">
              <a href="/purchase-orders?tab=company3" class="btn btn-outline-secondary">Clear Filter</a>
            </div>
          <% } %>
        </form>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr class="table-light">
                <th>Source PO (Co 1)</th>
                <th>Target PO (Co 3)</th>
                <th>Vendor</th>
                <th>Tax Option</th>
                <th>Total Amount</th>
                <th>Target Status</th>
                <th>Bill &amp; Payment (Co 3)</th>
                <th>Moved / Mirrored</th>
              </tr>
            </thead>
            <tbody>
              <% if (!crossCompanyLogs || crossCompanyLogs.length === 0) { %>
                <tr>
                  <td colspan="8" class="text-center text-secondary py-5">
                    <div class="fs-1 mb-2">🏢</div>
                    <strong>No ETR POs moved to Company 3 found.</strong>
                    <div class="small text-muted mt-1">Purchase orders with Tax Option ETR mirrored to URBAN VIBE 2 will automatically appear here.</div>
                  </td>
                </tr>
              <% } %>
              <% (crossCompanyLogs || []).forEach((log) => { %>
                <tr>
                  <td>
                    <strong class="text-primary"><%= log.source_po_name %></strong>
                    <% if (log.source_state) { %>
                      <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.72rem;"><%= log.source_state %></span>
                    <% } %>
                  </td>
                  <td>
                    <strong class="text-success"><%= log.target_po_name || 'Pending' %></strong>
                  </td>
                  <td>
                    <strong><%= log.partner_name || '—' %></strong>
                  </td>
                  <td>
                    <span class="badge bg-warning text-dark fw-bold"><%= log.tax_option || 'ETR' %></span>
                  </td>
                  <td>
                    <strong><%= log.currency || 'KES' %> <%= Number(log.amount_total || 0).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></strong>
                  </td>
                  <td>
                    <span class="badge <%= log.target_state === 'purchase' || log.target_state === 'done' ? 'bg-success text-white' : 'bg-warning text-dark' %>">
                      <%= log.target_state || 'draft' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex flex-column gap-1 small">
                      <div>
                        <span class="badge <%= log.bill_name ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>">
                          <%= log.bill_name ? `Bill: ${log.bill_name}` : 'No Bill' %>
                        </span>
                      </div>
                      <% if (log.payment_name) { %>
                        <div>
                          <span class="badge bg-info-subtle text-info">
                            Paid: <%= log.payment_name %> (Bank 25)
                          </span>
                        </div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <span class="small text-secondary"><%= log.moved_at || log.created_at || '—' %></span>
                    <% if (log.message) { %>
                      <div class="small text-muted text-truncate" style="max-width:240px;" title="<%= log.message %>">
                        <%= log.message %>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- Default All Purchase Orders View -->
      <form method="get" action="/purchase-orders" class="row g-3 align-items-end mb-4" data-disable-submit="true" data-loading-message="Loading Purchase Orders...">
        <input type="hidden" name="load" value="1" />
        <div class="col-lg-4">
          <label class="form-label">Search</label>
          <input
            type="text"
            class="form-control"
            name="q"
            value="<%= query %>"
            placeholder="PO number, vendor reference, or vendor name"
          />
        </div>
        <div class="col-md-3 col-lg-2">
          <label class="form-label">From</label>
          <input type="date" class="form-control" name="from" value="<%= fromDate %>" />
        </div>
        <div class="col-md-3 col-lg-2">
          <label class="form-label">To</label>
          <input type="date" class="form-control" name="to" value="<%= toDate %>" />
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
          <button type="submit" class="btn btn-primary">Load POs</button>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
          <a href="/po-bill-automation" class="btn btn-outline-secondary" data-loading-message="Opening PO Bill Automation...">Run Matcher</a>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Purchase Order</th>
              <th>Vendor</th>
              <th>Date</th>
              <th>Odoo Status</th>
              <th>App Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-secondary py-4">
                  <%= hasLoaded ? 'No Purchase Orders were returned for this search.' : 'Use Load POs to fetch Purchase Orders from Odoo.' %>
                </td>
              </tr>
            <% } %>
            <% orders.forEach((order) => { %>
              <tr>
                <td>
                  <strong><%= order.name %></strong>
                  <div class="small text-secondary"><%= order.partner_ref || 'No vendor reference' %></div>
                </td>
                <td><%= getRelationLabel(order.partner_id) %></td>
                <td><%= formatDateTime(order.date_order) %></td>
                <td>
                  <div class="d-flex flex-wrap gap-1">
                    <span class="badge text-bg-secondary"><%= order.state || '-' %></span>
                    <span class="badge text-bg-<%= order.invoice_status === 'invoiced' ? 'success' : 'secondary' %>">
                      <%= order.invoice_status || 'no invoice status' %>
                    </span>
                  </div>
                </td>
                <td>
                  <div class="d-flex flex-wrap gap-1">
                    <span class="badge text-bg-<%= appStatusBadge(order) %>">
                      <%= appStatusLabel(order) %>
                    </span>
                    <span class="badge text-bg-<%= order.appStatus.vendorBillName ? 'success' : 'secondary' %>">
                      <%= order.appStatus.vendorBillName ? `Bill ${order.appStatus.vendorBillName}` : 'No Vendor Bill Created' %>
                    </span>
                    <span class="badge text-bg-<%= order.appStatus.matchedDocumentName ? 'info' : 'secondary' %>">
                      <%= order.appStatus.matchedDocumentName ? 'Matched PDF' : 'No Matched PDF' %>
                    </span>
                  </div>
                  <% if (order.appStatus.matchedDocumentName || order.appStatus.summary) { %>
                    <div class="small text-secondary mt-1">
                      <% if (order.appStatus.matchedDocumentName) { %>
                        <span><%= order.appStatus.matchedDocumentName %></span>
                      <% } %>
                      <% if (order.appStatus.processedAt) { %>
                        <span> - <%= formatDateTime(order.appStatus.processedAt) %></span>
                      <% } %>
                      <% if (order.appStatus.summary) { %>
                        <div><%= order.appStatus.summary %></div>
                      <% } %>
                    </div>
                  <% } %>
                </td>
                <td><%= order.amount_total ?? '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4">
        <span class="small text-secondary"><%= hasLoaded ? 'Showing page' : 'Ready to load page' %> <strong><%= page %></strong>.</span>
        <div class="d-flex flex-wrap gap-2">
          <a
            href="<%= hasPreviousPage ? buildPageHref(page - 1) : '#' %>"
            class="btn btn-sm btn-outline-secondary <%= hasPreviousPage ? '' : 'disabled' %>"
            <%= hasPreviousPage ? '' : 'aria-disabled="true"' %>
            data-loading-message="Loading Purchase Orders..."
          >
            Prev Page
          </a>
          <a
            href="<%= hasNextPage ? buildPageHref(page + 1) : '#' %>"
            class="btn btn-sm btn-outline-secondary <%= hasNextPage ? '' : 'disabled' %>"
            <%= hasNextPage ? '' : 'aria-disabled="true"' %>
            data-loading-message="Loading Purchase Orders..."
          >
            Next Page
          </a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
