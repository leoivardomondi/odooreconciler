<%- include('partials/head') %>
  <%- include('partials/header') %>

    <main class="container py-4 my-2" style="max-width: 1100px;">
      <!-- Public Header Section -->
      <div class="card border-0 rounded-4 shadow-sm mb-4"
        style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
        <div class="card-body p-4 p-md-5">
          <div
            class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
              <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="badge rounded-pill bg-success text-white px-3 py-1 fw-bold"
                  style="font-size: 0.76rem; letter-spacing: 0.04em;">
                  LIVE REGISTRY
                </span>
                <span class="badge rounded-pill bg-white text-dark bg-opacity-25 px-3 py-1 fw-semibold"
                  style="font-size: 0.76rem;">
                  Public Access · No Login Required
                </span>
              </div>
              <h1 class="h3 fw-bold mb-1 text-white" style="letter-spacing: -0.02em;">Board Intake Logs</h1>
              <p class="text-white-50 small mb-0" style="max-width: 650px; font-size: 0.88rem; line-height: 1.5;">
                Continuous chronological timeline of whole boards received at factory gates and allocated to production
                cutting orders.
              </p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
              <a href="/public/board-logs"
                class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold"
                title="Refresh logs from database">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
                </svg>
                <span>Refresh</span>
              </a>
              <a href="/public/shop-floor"
                class="btn btn-sm rounded-pill px-3.5 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold"
                style="background:#714B67;color:#fff;border:1px solid rgba(255,255,255,0.28);"
                title="Open SHOP FLOOR public kiosk app">
                <img src="/public/icons/odoo-shop-floor-192.png" alt="" width="16" height="16" style="border-radius:3px;" />
                <span>SHOP FLOOR</span>
              </a>
              <% if (isAuthenticated) { %>
                <a href="/shop-floor/boards"
                  class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  <span>Record Boards (App)</span>
                </a>
                <% } %>
            </div>
          </div>

          <!-- Quick Metrics Summary -->
          <div class="row g-2 mt-4 pt-2 border-top border-secondary border-opacity-25">
            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center"
                style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
                <div class="text-white-50 small mb-1"
                  style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Total
                  Sheets</div>
                <div class="h4 fw-bold mb-0 text-white">
                  <%= summary.totalSheets %>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center"
                style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25);">
                <div class="text-success-emphasis small mb-1"
                  style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; color: #a7f3d0 !important;">
                  Client Supply</div>
                <div class="h4 fw-bold mb-0" style="color: #6ee7b7;">
                  <%= summary.clientSupplySheets %>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center"
                style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.25);">
                <div class="text-primary-emphasis small mb-1"
                  style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; color: #bfdbfe !important;">
                  PO Purchases</div>
                <div class="h4 fw-bold mb-0" style="color: #93c5fd;">
                  <%= summary.purchaseSheets %>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center"
                style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
                <div class="text-white-50 small mb-1"
                  style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Total
                  Deliveries</div>
                <div class="h4 fw-bold mb-0 text-white">
                  <%= summary.totalLogs %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Search & Filter Controls Toolbar -->
      <div class="card border-0 rounded-4 shadow-sm mb-4"
        style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
        <div class="card-body p-3 p-md-4">
          <div class="row g-3 align-items-center">
            <!-- Search Input with Instant Live Matching & Filtering -->
            <div class="col-12 col-md-6 col-lg-7">
              <form id="boardSearchForm" method="get" action="/public/board-logs" class="m-0 position-relative">
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                      stroke-width="2.5">
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                  </span>
                  <input type="text" name="q" id="boardSearchInput"
                    class="form-control bg-light border-start-0 py-2 text-dark"
                    placeholder="Search by client, board material, vehicle, gate, PO, or operator..."
                    value="<%= initialSearch || '' %>" aria-label="Search board logs" style="font-size: 0.88rem;"
                    autocomplete="off" />
                  <% if (initialSearch) { %>
                    <a href="/public/board-logs" class="btn btn-outline-secondary border-start-0 py-2 text-muted"
                      title="Clear filter">✕</a>
                    <% } %>
                      <button type="submit" class="btn btn-primary rounded-end-pill px-3 py-2 fw-semibold"
                        style="font-size: 0.84rem;">Search</button>
                </div>
                <!-- Live Autocomplete dropdown matching local DB -->
                <div id="boardSearchDropdown"
                  class="combobox-dropdown d-none shadow-lg border rounded-3 position-absolute w-100"
                  style="top: 100%; left: 0; max-height: 280px; overflow-y: auto; z-index: 1050; background: #fff; margin-top: 4px;">
                  <div class="list-group list-group-flush" id="boardSearchSuggestions"></div>
                </div>
              </form>
            </div>

            <!-- Filter Pills & Date Selector -->
            <div class="col-12 col-md-6 col-lg-5">
              <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <!-- Supply Type Filter Buttons -->
                <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border shadow-none" role="group"
                  aria-label="Filter supply type" id="supplyFilterGroup">
                  <button type="button" class="btn btn-sm rounded-pill px-3 py-1 active fw-semibold"
                    data-supply-filter="all">All</button>
                  <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold"
                    data-supply-filter="client">Client</button>
                  <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold"
                    data-supply-filter="purchase">PO</button>
                </div>

                <!-- Date Jump Dropdown -->
                <% if (dateGroups && dateGroups.length> 1) { %>
                  <div class="dropdown">
                    <button type="button"
                      class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 dropdown-toggle fw-semibold d-inline-flex align-items-center gap-1"
                      data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.82rem;">
                      <span>Jump to Date</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border rounded-3 p-2"
                      style="max-height: 350px; overflow-y: auto; min-width: 240px; font-size: 0.84rem;">
                      <li>
                        <h6 class="dropdown-header text-uppercase text-muted px-2 py-1" style="font-size: 0.70rem;">Jump
                          to Day</h6>
                      </li>
                      <% dateGroups.forEach(g=> { %>
                        <li>
                          <a class="dropdown-item rounded-2 py-1.5 d-flex justify-content-between align-items-center"
                            href="#date-<%= g.date %>">
                            <span>
                              <%= g.dayLabel %>, <%= g.formattedDate %>
                            </span>
                            <span class="badge rounded-pill bg-light text-secondary border ms-2">
                              <%= g.totalSheets %>
                            </span>
                          </a>
                        </li>
                        <% }); %>
                    </ul>
                  </div>
                  <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Continuous Board Log Stream Grouped by Date -->
      <div id="boardLogStream">
        <% if (!dateGroups || dateGroups.length===0) { %>
          <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white"
            style="border: 1px solid #e2e8f0 !important;">
            <div class="text-muted mb-3">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"
                class="text-secondary">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">No board logs recorded yet</h2>
            <p class="text-secondary small mb-0">Gate intake entries will appear here chronologically grouped by arrival
              date.</p>
          </div>
          <% } else { %>
            <% dateGroups.forEach((group)=> { %>
              <section class="board-date-section mb-4" id="date-<%= group.date %>" data-date="<%= group.date %>">
                <!-- Date Subcategory Sticky Header -->
                <div
                  class="board-date-header sticky-top py-2.5 px-3 px-md-4 mb-2.5 rounded-4 d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm"
                  style="background: #ffffff; border: 1px solid #cbd5e1; top: 68px; z-index: 10;">
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fs-5" style="line-height: 1;">📅</span>
                    <h2 class="h6 fw-bold mb-0 text-dark d-inline" style="font-size: 0.98rem; letter-spacing: -0.01em;">
                      <%= group.dayLabel %>, <%= group.formattedDate %>
                    </h2>
                    <% if (group.isToday) { %>
                      <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5 fw-bold"
                        style="font-size: 0.70rem; letter-spacing: 0.03em;">TODAY</span>
                      <% } else if (group.isYesterday) { %>
                        <span class="badge bg-secondary text-white rounded-pill px-2.5 py-0.5 fw-bold"
                          style="font-size: 0.70rem; letter-spacing: 0.03em;">YESTERDAY</span>
                        <% } %>
                  </div>

                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge rounded-pill bg-dark text-white fw-bold px-3 py-1.5" style="font-size: 0.78rem;">
                      <%= group.totalSheets %>
                        <%= group.totalSheets===1 ? 'Sheet' : 'Sheets' %> Total
                    </span>
                    <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1"
                      style="font-size: 0.74rem;">
                      <span class="visible-count">
                        <%= group.entries.length %>
                      </span>
                      <%= group.entries.length===1 ? 'log' : 'logs' %>
                    </span>
                    <% if (group.clientSupplySheets> 0) { %>
                      <span
                        class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-0.5 fw-semibold"
                        style="font-size: 0.72rem;">
                        <%= group.clientSupplySheets %> Client
                      </span>
                      <% } %>
                        <% if (group.purchaseSheets> 0) { %>
                          <span
                            class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 fw-semibold"
                            style="font-size: 0.72rem;">
                            <%= group.purchaseSheets %> PO
                          </span>
                          <% } %>
                  </div>
                </div>

                <!-- Entries List under Date Subcategory -->
                <div class="board-entries-container d-flex flex-column gap-2">
                  <% group.entries.forEach((item)=> {
                    const isPurchase = Boolean(item.is_purchase);
                    const status = String(item.status || 'synced').toLowerCase();
                    const isPendingClient = !item.partner_id || Number(item.partner_id) === 0 || item.customer_name ===
                    'Pending Client Matching';
                    %>
                    <div class="board-log-entry-card border rounded-3 p-3 bg-white shadow-sm"
                      data-entry-id="<%= item.id %>" data-client="<%= (item.customer_name || '').toLowerCase() %>"
                      data-product="<%= (item.product_name || '').toLowerCase() %>"
                      data-vehicle="<%= (item.vehicle_registration || '').toLowerCase() %>"
                      data-po="<%= (item.purchase_order_reference || '').toLowerCase() %>"
                      data-gate="<%= (item.gate || '').toLowerCase() %>"
                      data-operator="<%= (item.actor_name || '').toLowerCase() %>"
                      data-supply="<%= isPendingClient ? 'pending' : (isPurchase ? 'purchase' : 'client') %>"
                      style="border-left: 4.5px solid <%= isPendingClient ? '#f59e0b' : (isPurchase ? '#2563eb' : '#059669') %> !important; border-color: #cbd5e1 !important; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div style="flex: 1 1 300px;">
                          <!-- Line 1: Quantity × Product Name & Supply Badge -->
                          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <strong class="text-dark" style="font-size: 0.96rem;">
                              <%= item.quantity %> × <%= item.product_name %>
                            </strong>
                            <% if (isPendingClient) { %>
                              <span class="badge text-dark border border-warning shadow-sm rounded-pill"
                                style="background-color: #fef08a !important; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;"
                                title="Owner is unknown - pending client matching">
                                ⚠️ PENDING CLIENT MATCHING
                              </span>
                              <% } else if (isPurchase) { %>
                                <span class="badge bg-primary text-white border-0 shadow-sm rounded-pill"
                                  style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;"
                                  title="Company Purchase (PO-backed)">
                                  📦 COMPANY PURCHASE
                                </span>
                                <% if (item.purchase_order_reference) { %>
                                  <span
                                    class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-semibold"
                                    style="font-size: 0.72rem;">
                                    PO: <%= item.purchase_order_reference %>
                                  </span>
                                  <% } %>
                                    <% } else { %>
                                      <span class="badge text-white border-0 shadow-sm rounded-pill"
                                        style="background-color: #059669 !important; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;"
                                        title="Client Supplied Boards (Customer Provided)">
                                        📦 CLIENT SUPPLY
                                      </span>
                                      <% } %>
                                        <% if (item.no_backorder) { %>
                                          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill fw-semibold"
                                            style="font-size: 0.70rem;" title="Short receipt closed without backorder">
                                            ✓ No Backorder
                                          </span>
                                          <% } %>
                          </div>

                          <!-- Line 2: Customer, Source Tag & Gate Details -->
                          <div class="small mt-1 text-secondary" style="font-size: 0.84rem; line-height: 1.45;">
                            <% if (isPendingClient) { %>
                              <span class="fw-bold text-warning-emphasis">⚠️ Pending Client Matching</span>
                              <% } else { %>
                                <span class="fw-bold" style="color: #0f172a;">
                                  <%= item.customer_name %>
                                </span>
                                <% if (isPurchase) { %>
                                  <span
                                    class="badge bg-light text-primary border border-primary-subtle px-1.5 py-0.5 ms-1"
                                    style="font-size: 0.68rem; font-weight: 600;">Company Procured</span>
                                  <% } else { %>
                                    <span
                                      class="badge bg-light text-success border border-success-subtle px-1.5 py-0.5 ms-1"
                                      style="font-size: 0.68rem; font-weight: 600;">Customer's Own Material</span>
                                    <% } %>
                                      <% } %>
                                        <% if (item.matched_by) { %>
                                          <span
                                            class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-0.5 ms-1"
                                            style="font-size: 0.70rem;">Matched by <%= item.matched_by %></span>
                                          <% } %>
                                            <span class="text-muted">·</span>
                                            <span style="color: #475569;">
                                              <%= item.created_at %>
                                            </span>
                                            <% if (item.arrival_time) { %>
                                              <span class="text-muted">·</span>
                                              <span>Arrived: <strong>
                                                  <%= item.arrival_time %>
                                                </strong></span>
                                              <% } %>
                                                <% if (item.vehicle_registration) { %>
                                                  <span class="text-muted">·</span>
                                                  <span>Vehicle: <strong>
                                                      <%= item.vehicle_registration %>
                                                    </strong></span>
                                                  <% } %>
                                                    <% if (item.gate) { %>
                                                      <span class="text-muted">·</span>
                                                      <span>Gate: <strong>
                                                          <%= item.gate %>
                                                        </strong></span>
                                                      <% } %>
                                                        <% if (item.actor_name) { %>
                                                          <span class="text-muted">·</span>
                                                          <span>Logged by <strong style="color: #0f172a;">
                                                              <%= item.actor_name %>
                                                            </strong></span>
                                                          <% } %>
                          </div>
                        </div>

                        <!-- Action & Status Badge -->
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                          <div class="text-end" data-board-log-status-container="<%= item.id %>">
                            <% if (status==='synced' ) { %>
                              <span
                                class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-semibold px-2.5 py-1"
                                style="font-size: 0.74rem;" data-board-log-status="<%= item.id %>">
                                <%= isPendingClient ? '✓ Synced (Pending Match)' : '✓ Synced to Odoo' %>
                              </span>
                              <% } else if (status==='reverted' ) { %>
                                <span
                                  class="badge bg-secondary-subtle text-secondary border rounded-pill fw-semibold px-2.5 py-1"
                                  style="font-size: 0.74rem;"
                                  title="<%= item.reverted_at ? 'Reverted at ' + item.reverted_at : '' %>"
                                  data-board-log-status="<%= item.id %>">
                                  Cancelled / Reverted
                                </span>
                                <% } else if (status==='failed' ) { %>
                                  <span
                                    class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-semibold px-2.5 py-1"
                                    style="font-size: 0.74rem;" data-board-log-status="<%= item.id %>">
                                    Sync Pending Retry
                                  </span>
                                  <% } else if (isPendingClient) { %>
                                    <span
                                      class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill fw-semibold px-2.5 py-1"
                                      style="font-size: 0.74rem;" data-board-log-status="<%= item.id %>">
                                      ⏳ Waiting Client Match
                                    </span>
                                    <% } else { %>
                                      <span
                                        class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill fw-semibold px-2.5 py-1"
                                        style="font-size: 0.74rem;" data-board-log-status="<%= item.id %>">
                                        ⏳ Syncing
                                      </span>
                                      <% } %>
                          </div>
                          <% if (isPendingClient && status !=='reverted' && !item.reverted_at) { %>
                            <button type="button"
                              class="btn btn-sm btn-warning rounded-pill fw-bold btn-open-match-modal px-2.5 shadow-sm d-inline-flex align-items-center gap-1"
                              data-intake-id="<%= item.id %>" data-product-name="<%= item.product_name %>"
                              data-qty="<%= item.quantity %>" style="font-size:0.76rem;">
                              🔗 Match Client
                            </button>
                            <% } %>
                        </div>
                      </div>
                    </div>
                    <% }); %>
                </div>
              </section>
              <% }); %>
                <% } %>

                  <!-- Empty Search State -->
                  <div id="noSearchMatchAlert" class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white d-none"
                    style="border: 1px solid #e2e8f0 !important;">
                    <div class="text-muted mb-3">
                      <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor"
                        stroke-width="1.5">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      </svg>
                    </div>
                    <h3 class="h6 fw-bold text-dark mb-1">No matching board logs found</h3>
                    <p class="text-secondary small mb-3">No board intake entries matched your current search and filter
                      criteria.</p>
                    <div>
                      <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                        id="clearSearchBtn">
                        Reset Filter &amp; Show All
                      </button>
                    </div>
                  </div>
      </div>

      <!-- Match Client Modal (Public View with Attendance PIN) -->
      <div class="modal fade" id="publicMatchClientModal" tabindex="-1" aria-labelledby="publicMatchClientModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content shadow border-0 rounded-4">
              <form id="publicMatchClientForm" method="post" action="" data-no-loading="true">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                  <div>
                    <h5 class="modal-title fw-bold text-dark" id="publicMatchClientModalLabel">🔗 Match Board Log to
                      Client</h5>
                    <p class="text-muted small mb-0 mt-1">Assign the client for this board intake and authenticate using
                      your Odoo attendance PIN.</p>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-3">
                  <div id="matchModalAlert" class="alert alert-danger d-none small py-2 px-3 rounded-3 mb-3"></div>

                  <div class="p-3 rounded-3 bg-light border mb-3">
                    <div class="small text-muted mb-1">Board Intake Details</div>
                    <div class="fw-bold text-dark" id="matchModalBoardDetails">--</div>
                  </div>

                  <!-- Client Combobox -->
                  <div class="mb-3 position-relative" id="publicMatchPartnerCombobox">
                    <label for="publicMatchPartnerSearch" class="form-label fw-semibold"
                      style="font-size: 0.92rem; color: #334155;">
                      Select Client <span class="text-danger">*</span>
                    </label>
                    <div class="input-group rounded-3 border overflow-hidden" style="border-color: #cbd5e1 !important;">
                      <span class="input-group-text bg-white border-0 pe-1"
                        style="color: #94a3b8; font-size: 1.1rem; padding: 0.65rem 0.75rem;">🔍</span>
                      <input type="text" id="publicMatchPartnerSearch" class="form-control border-0 ps-2"
                        placeholder="Type to search clients..." style="font-size: 1rem; padding: 0.65rem 0.75rem;"
                        autocomplete="off" required>
                    </div>
                    <input type="hidden" name="partner_id" id="publicMatchPartnerId" required>
                    <input type="hidden" name="partner_name" id="publicMatchPartnerName" required>
                    <div class="invalid-feedback d-block d-none" id="publicMatchPartnerFeedback">Please choose a valid
                      client from the list.</div>

                    <div class="combobox-dropdown d-none shadow border position-absolute w-100 rounded-3"
                      style="top: 100%; left: 0; max-height: 250px; overflow-y: auto; z-index: 1055; background: #fff;">
                      <div class="list-group list-group-flush" id="publicMatchPartnerList">
                        <% (typeof customers !=='undefined' && Array.isArray(customers) ? customers : []).forEach(c=> {
                          %>
                          <button type="button"
                            class="list-group-item list-group-item-action text-start py-2 px-3 combobox-item"
                            data-id="<%= c.id %>" data-name="<%= c.name %>" style="border: none;">
                            <div class="fw-medium text-dark">
                              <%= c.name %>
                            </div>
                            <div class="small text-muted" style="font-size: 0.74rem;">Odoo partner record</div>
                          </button>
                          <% }) %>
                      </div>
                      <div class="text-muted text-center py-3 d-none no-results" style="font-size: 0.85rem;">No clients
                        found</div>
                    </div>
                  </div>

                  <!-- Attendance PIN -->
                  <div class="mb-3">
                    <label for="publicMatchOperatorPin" class="form-label fw-semibold"
                      style="font-size: 0.92rem; color: #334155;">
                      Attendance PIN <span class="text-danger">*</span>
                    </label>
                    <input type="password" inputmode="numeric" pattern="[0-9]*" class="form-control rounded-3"
                      id="publicMatchOperatorPin" name="pin" placeholder="Enter your 4-digit attendance PIN"
                      maxlength="8" required autocomplete="off"
                      style="font-size: 1.05rem; letter-spacing: 0.15em; padding: 0.65rem 0.75rem; border-color: #cbd5e1;">
                    <div class="form-text small text-muted">Enter your Odoo attendance kiosk PIN (stored in MySQL).
                    </div>
                  </div>

                  <div class="small text-muted">
                    <i class="bi bi-info-circle"></i> Once verified and matched, Odoo links this stock intake to the
                    client and automatically reserves components on open cutting / manufacturing orders.
                  </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                  <button type="button" class="btn btn-secondary rounded-pill px-3"
                    data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold"
                    id="btnSubmitPublicMatchClient">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="publicMatchSpinner"
                      role="status"></span>
                    Confirm &amp; Match
                  </button>
                </div>
              </form>
          </div>
        </div>
      </div>
    </main>

    <script>
      (function () {
        const searchInput = document.getElementById('boardSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const stream = document.getElementById('boardLogStream');
        const noMatchAlert = document.getElementById('noSearchMatchAlert');
        const filterButtons = document.querySelectorAll('#supplyFilterGroup button');

        let currentSupplyFilter = 'all';

        function applyFilters() {
          const query = (searchInput.value || '').trim().toLowerCase();
          const sections = document.querySelectorAll('.board-date-section');
          let totalVisible = 0;

          sections.forEach(function (section) {
            const cards = section.querySelectorAll('.board-log-entry-card');
            let visibleInSection = 0;

            cards.forEach(function (card) {
              const client = card.getAttribute('data-client') || '';
              const product = card.getAttribute('data-product') || '';
              const vehicle = card.getAttribute('data-vehicle') || '';
              const po = card.getAttribute('data-po') || '';
              const gate = card.getAttribute('data-gate') || '';
              const operator = card.getAttribute('data-operator') || '';
              const supply = card.getAttribute('data-supply') || '';

              const matchesSupply = currentSupplyFilter === 'all' || supply === currentSupplyFilter;
              const matchesQuery = !query ||
                client.includes(query) ||
                product.includes(query) ||
                vehicle.includes(query) ||
                po.includes(query) ||
                gate.includes(query) ||
                operator.includes(query);

              if (matchesSupply && matchesQuery) {
                card.classList.remove('d-none');
                visibleInSection++;
                totalVisible++;
              } else {
                card.classList.add('d-none');
              }
            });

            const countBadge = section.querySelector('.visible-count');
            if (countBadge) {
              countBadge.textContent = visibleInSection;
            }

            if (visibleInSection > 0) {
              section.classList.remove('d-none');
            } else {
              section.classList.add('d-none');
            }
          });

          if (noMatchAlert) {
            if (totalVisible === 0 && (query || currentSupplyFilter !== 'all')) {
              noMatchAlert.classList.remove('d-none');
            } else {
              noMatchAlert.classList.add('d-none');
            }
          }
        }

        const searchDropdown = document.getElementById('boardSearchDropdown');
        const searchSuggestions = document.getElementById('boardSearchSuggestions');
        let searchDebounceTimer = null;
        let searchReqSeq = 0;

        function renderSuggestions(clients) {
          if (!searchSuggestions || !searchDropdown) return;
          if (!clients || clients.length === 0) {
            searchDropdown.classList.add('d-none');
            searchSuggestions.innerHTML = '';
            return;
          }
          searchSuggestions.innerHTML = '';
          clients.forEach(function (c) {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action py-2.5 px-3 d-flex align-items-center justify-content-between border-0';
            item.style.fontSize = '0.88rem';
            item.innerHTML = `
          <div class="d-flex align-items-center gap-2">
            <span class="text-primary">👤</span>
            <strong class="text-dark">${c.name}</strong>
          </div>
          <span class="badge bg-light text-secondary border rounded-pill" style="font-size:0.70rem;">Client</span>`;
            item.addEventListener('click', function (e) {
              e.stopPropagation();
              if (searchInput) {
                searchInput.value = c.name;
              }
              searchDropdown.classList.add('d-none');
              applyFilters();
            });
            searchSuggestions.appendChild(item);
          });
          searchDropdown.classList.remove('d-none');
        }

        if (searchInput) {
          searchInput.addEventListener('input', function () {
            applyFilters();
            const term = searchInput.value.trim();
            if (term.length < 2) {
              if (searchDropdown) searchDropdown.classList.add('d-none');
              return;
            }
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(async function () {
              const currentSeq = ++searchReqSeq;
              try {
                const res = await fetch('/public/board-logs/partners/search?q=' + encodeURIComponent(term), {
                  headers: { Accept: 'application/json' },
                });
                if (!res.ok || currentSeq !== searchReqSeq) return;
                const data = await res.json();
                if (currentSeq !== searchReqSeq) return;
                renderSuggestions(Array.isArray(data && data.results) ? data.results : []);
              } catch (_err) { }
            }, 120);
          });

          document.addEventListener('click', function (e) {
            if (searchDropdown && !searchDropdown.contains(e.target) && e.target !== searchInput) {
              searchDropdown.classList.add('d-none');
            }
          });
        }

        // Execute immediately on load to handle pre-filled queries (?q=...)
        applyFilters();

        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            if (searchInput) searchInput.value = '';
            currentSupplyFilter = 'all';
            filterButtons.forEach(function (btn) {
              btn.classList.toggle('active', btn.getAttribute('data-supply-filter') === 'all');
              btn.classList.toggle('text-secondary', btn.getAttribute('data-supply-filter') !== 'all');
            });
            applyFilters();
          });
        }

        filterButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            filterButtons.forEach(function (b) {
              b.classList.remove('active');
              b.classList.add('text-secondary');
            });
            btn.classList.add('active');
            btn.classList.remove('text-secondary');
            currentSupplyFilter = btn.getAttribute('data-supply-filter') || 'all';
            applyFilters();
          });
        });

        // Handle deep-link to date anchor (?date=YYYY-MM-DD or #date-YYYY-MM-DD)
        const urlParams = new URLSearchParams(window.location.search);
        const targetDate = urlParams.get('date');
        const hash = window.location.hash;

        const targetDateId = targetDate ? ('date-' + targetDate) : (hash ? hash.replace('#', '') : null);

        if (targetDateId) {
          const targetEl = document.getElementById(targetDateId);
          if (targetEl) {
            setTimeout(function () {
              targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              const header = targetEl.querySelector('.board-date-header');
              if (header) {
                header.style.transition = 'box-shadow 0.4s ease, border-color 0.4s ease, background 0.4s ease';
                header.style.borderColor = '#059669';
                header.style.boxShadow = '0 0 0 4px rgba(5, 150, 105, 0.25)';
                header.style.background = '#f0fdf4';
                setTimeout(function () {
                  header.style.borderColor = '#cbd5e1';
                  header.style.boxShadow = '';
                  header.style.background = '#ffffff';
                }, 3500);
              }
            }, 300);
          }
        }

        // Handle Match Client modal button clicks from cards
          let activeMatchIntakeId = null;
          const matchModalEl = document.getElementById('publicMatchClientModal');
          const matchForm = document.getElementById('publicMatchClientForm');
          const matchAlert = document.getElementById('matchModalAlert');
          const matchDetails = document.getElementById('matchModalBoardDetails');
          const partnerSearchInput = document.getElementById('publicMatchPartnerSearch');
          const partnerIdInput = document.getElementById('publicMatchPartnerId');
          const partnerNameInput = document.getElementById('publicMatchPartnerName');
          const partnerFeedback = document.getElementById('publicMatchPartnerFeedback');
          const partnerDropdown = document.querySelector('#publicMatchPartnerCombobox .combobox-dropdown');
          const partnerList = document.getElementById('publicMatchPartnerList');
          const noResultsEl = document.querySelector('#publicMatchPartnerCombobox .no-results');
          const pinInput = document.getElementById('publicMatchOperatorPin');
          const submitBtn = document.getElementById('btnSubmitPublicMatchClient');
          const spinner = document.getElementById('publicMatchSpinner');

          document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-open-match-modal');
            if (!btn) return;
            activeMatchIntakeId = btn.getAttribute('data-intake-id');
            const prodName = btn.getAttribute('data-product-name') || '';
            const qty = btn.getAttribute('data-qty') || '';

            if (matchDetails) {
              matchDetails.textContent = qty + ' × ' + prodName + ' (Intake #' + activeMatchIntakeId + ')';
            }
            if (matchAlert) {
              matchAlert.classList.add('d-none');
              matchAlert.textContent = '';
            }
            if (partnerSearchInput) {
              partnerSearchInput.value = '';
              partnerSearchInput.classList.remove('is-invalid');
            }
            if (partnerIdInput) partnerIdInput.value = '';
            if (partnerNameInput) partnerNameInput.value = '';
            if (partnerFeedback) partnerFeedback.classList.add('d-none');
            if (partnerDropdown) partnerDropdown.classList.add('d-none');
            if (pinInput) {
              pinInput.value = '';
              pinInput.classList.remove('is-invalid');
            }
            if (submitBtn) submitBtn.disabled = false;
            if (spinner) spinner.classList.add('d-none');

            if (matchModalEl && window.bootstrap && window.bootstrap.Modal) {
              const modal = window.bootstrap.Modal.getOrCreateInstance(matchModalEl);
              modal.show();
              setTimeout(function () {
                if (partnerSearchInput) partnerSearchInput.focus();
              }, 300);
            }
          });

          // Client search logic for Match Modal
          let partnerSearchTimer = null;
          let partnerRequestSeq = 0;

          function selectPartnerItem(id, name) {
            if (partnerIdInput) partnerIdInput.value = id;
            if (partnerNameInput) partnerNameInput.value = name;
            if (partnerSearchInput) {
              partnerSearchInput.value = name;
              partnerSearchInput.classList.remove('is-invalid');
            }
            if (partnerFeedback) partnerFeedback.classList.add('d-none');
            if (partnerDropdown) partnerDropdown.classList.add('d-none');
          }

          if (partnerList) {
            partnerList.addEventListener('click', function (e) {
              const item = e.target.closest('.combobox-item');
              if (!item) return;
              e.stopPropagation();
              const id = item.getAttribute('data-id');
              const name = item.getAttribute('data-name');
              selectPartnerItem(id, name);
            });
          }

          if (partnerSearchInput) {
            async function loadPublicPartnerResults(query) {
              const currentSeq = ++partnerRequestSeq;
              try {
                const res = await fetch('/public/board-logs/partners/search?q=' + encodeURIComponent(query || ''), {
                  headers: { Accept: 'application/json' },
                });
                if (!res.ok || currentSeq !== partnerRequestSeq) return;
                const payload = await res.json();
                if (currentSeq !== partnerRequestSeq) return;

                const results = Array.isArray(payload && payload.results) ? payload.results : [];
                if (partnerList) {
                  partnerList.innerHTML = '';
                  if (results.length === 0) {
                    if (noResultsEl) noResultsEl.classList.remove('d-none');
                  } else {
                    if (noResultsEl) noResultsEl.classList.add('d-none');
                    results.forEach(function (partner) {
                      const btn = document.createElement('button');
                      btn.type = 'button';
                      btn.className = 'list-group-item list-group-item-action text-start py-2 px-3 combobox-item';
                      btn.setAttribute('data-id', partner.id);
                      btn.setAttribute('data-name', partner.name || '');
                      btn.style.border = 'none';

                      const nameEl = document.createElement('div');
                      nameEl.className = 'fw-medium text-dark';
                      nameEl.textContent = partner.name || 'Unnamed client';

                      const metaEl = document.createElement('div');
                      metaEl.className = 'small text-muted';
                      metaEl.style.fontSize = '0.74rem';
                      const parts = [];
                      if (partner.ref) parts.push('Ref: ' + partner.ref);
                      if (partner.mobile || partner.phone) parts.push('Tel: ' + (partner.mobile || partner.phone));
                      metaEl.textContent = parts.length ? parts.join(' • ') : 'Client in MySQL';

                      btn.appendChild(nameEl);
                      btn.appendChild(metaEl);
                      partnerList.appendChild(btn);
                    });
                  }
                }
              } catch (_err) { }
            }

            partnerSearchInput.addEventListener('click', function () {
              if (partnerDropdown) partnerDropdown.classList.remove('d-none');
              loadPublicPartnerResults(partnerSearchInput.value.trim());
            });

            partnerSearchInput.addEventListener('focus', function () {
              if (partnerDropdown) partnerDropdown.classList.remove('d-none');
              loadPublicPartnerResults(partnerSearchInput.value.trim());
            });

            partnerSearchInput.addEventListener('input', function () {
              const query = partnerSearchInput.value.trim();
              if (partnerIdInput) partnerIdInput.value = '';
              if (partnerNameInput) partnerNameInput.value = '';
              if (partnerDropdown) partnerDropdown.classList.remove('d-none');

              // Immediately filter existing items in DOM for 0ms responsiveness
              if (partnerList) {
                const lower = query.toLowerCase();
                let visibleCount = 0;
                partnerList.querySelectorAll('.combobox-item').forEach(function (item) {
                  const name = (item.getAttribute('data-name') || item.textContent || '').toLowerCase();
                  const match = !lower || name.includes(lower);
                  item.classList.toggle('d-none', !match);
                  if (match) visibleCount++;
                });
                if (noResultsEl) noResultsEl.classList.toggle('d-none', visibleCount > 0 || !lower);
              }

              clearTimeout(partnerSearchTimer);
              partnerSearchTimer = setTimeout(function () {
                loadPublicPartnerResults(query);
              }, 40);
            });
          }

          document.addEventListener('click', function (e) {
            if (partnerDropdown && !e.target.closest('#publicMatchPartnerCombobox')) {
              partnerDropdown.classList.add('d-none');
            }
          });

          // Handle Match Form Submission
          if (matchForm) {
            matchForm.addEventListener('submit', async function (e) {
              e.preventDefault();
              const partnerId = partnerIdInput ? partnerIdInput.value : '';
              const partnerName = partnerNameInput ? partnerNameInput.value : '';
              const pin = pinInput ? pinInput.value.trim() : '';

              if (!partnerId || partnerId === '0') {
                if (partnerSearchInput) {
                  partnerSearchInput.classList.add('is-invalid');
                  partnerSearchInput.focus();
                }
                if (partnerFeedback) partnerFeedback.classList.remove('d-none');
                return;
              }

              if (!pin) {
                if (pinInput) {
                  pinInput.classList.add('is-invalid');
                  pinInput.focus();
                }
                return;
              }

              if (submitBtn) submitBtn.disabled = true;
              if (spinner) spinner.classList.remove('d-none');
              if (matchAlert) matchAlert.classList.add('d-none');

              try {
                const response = await fetch('/public/board-logs/match-client', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                  },
                  body: JSON.stringify({
                    id: activeMatchIntakeId,
                    partner_id: Number(partnerId),
                    partner_name: partnerName,
                    pin: pin,
                  }),
                });

                const data = await response.json();
                if (!response.ok || !data.ok) {
                  throw new Error(data.error || 'Failed to match client. Please check your PIN.');
                }

                // Update card in DOM
                const card = document.querySelector(`.board-log-entry-card[data-entry-id="${activeMatchIntakeId}"]`);
                if (card) {
                  card.style.setProperty('border-left', '4.5px solid #059669', 'important');
                  card.setAttribute('data-supply', 'client');
                  card.setAttribute('data-client', (data.customerName || partnerName).toLowerCase());

                  // 1. Update supply badge
                  const pendingBadge = card.querySelector('.badge.border-warning');
                  if (pendingBadge) {
                    pendingBadge.className = 'badge text-white border-0 shadow-sm rounded-pill';
                    pendingBadge.style.backgroundColor = '#059669 !important';
                    pendingBadge.style.fontSize = '0.72rem';
                    pendingBadge.style.fontWeight = '700';
                    pendingBadge.title = 'Client Supplied Boards (Customer Provided)';
                    pendingBadge.textContent = '📦 CLIENT SUPPLY';
                  }

                  // 2. Update line 2 text
                  const clientWarningText = card.querySelector('.fw-bold.text-warning-emphasis');
                  if (clientWarningText) {
                    const matchedSpan = document.createElement('span');
                    matchedSpan.className = 'badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-0.5 ms-1';
                    matchedSpan.style.fontSize = '0.70rem';
                    matchedSpan.textContent = 'Matched by ' + (data.matchedBy || 'Operator');

                    const clientSpan = document.createElement('span');
                    clientSpan.className = 'fw-bold';
                    clientSpan.style.color = '#0f172a';
                    clientSpan.textContent = data.customerName || partnerName;

                    const supplyTypeSpan = document.createElement('span');
                    supplyTypeSpan.className = 'badge bg-light text-success border border-success-subtle px-1.5 py-0.5 ms-1';
                    supplyTypeSpan.style.fontSize = '0.68rem';
                    supplyTypeSpan.style.fontWeight = '600';
                    supplyTypeSpan.textContent = "Customer's Own Material";

                    const container = clientWarningText.parentElement;
                    container.insertBefore(clientSpan, clientWarningText);
                    container.insertBefore(supplyTypeSpan, clientWarningText);
                    container.insertBefore(matchedSpan, clientWarningText);
                    clientWarningText.remove();
                  }

                  // 3. Update status badge (synced immediately or syncing in background)
                  const statusBadge = card.querySelector('[data-board-log-status]');
                  if (statusBadge) {
                    if (data.status === 'synced') {
                      statusBadge.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-semibold px-2.5 py-1';
                      statusBadge.textContent = '✓ Synced to Odoo';
                    } else {
                      statusBadge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill fw-semibold px-2.5 py-1';
                      statusBadge.textContent = '⏳ Syncing';
                      initPublicStatusPolling();
                    }
                  }

                  // 4. Remove Match Client button
                  const matchBtn = card.querySelector('.btn-open-match-modal');
                  if (matchBtn) matchBtn.remove();
                }

                // Close modal
                if (matchModalEl && window.bootstrap && window.bootstrap.Modal) {
                  const modal = window.bootstrap.Modal.getInstance(matchModalEl);
                  if (modal) modal.hide();
                }

                // Show floating success toast
                const alertContainer = document.createElement('div');
                alertContainer.className = 'position-fixed bottom-0 end-0 p-3';
                alertContainer.style.zIndex = '1090';
                alertContainer.innerHTML = `
            <div class="toast align-items-center text-bg-success border-0 show shadow-lg" role="alert">
              <div class="d-flex">
                <div class="toast-body fw-medium py-2.5 px-3">
                  ${data.message || 'Board log matched successfully!'}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
              </div>
            </div>`;
                document.body.appendChild(alertContainer);
                setTimeout(() => alertContainer.remove(), 5000);
              } catch (err) {
                if (matchAlert) {
                  matchAlert.textContent = err instanceof Error ? err.message : 'An error occurred while matching the client.';
                  matchAlert.classList.remove('d-none');
                }
              } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (spinner) spinner.classList.add('d-none');
              }
            });
          }

          // Live polling for cards currently in "Syncing" state
          function initPublicStatusPolling() {
            const syncingBadges = document.querySelectorAll('.board-log-entry-card [data-board-log-status]');
            const syncingIds = [];
            syncingBadges.forEach(function (badge) {
              if (badge.textContent.includes('Syncing')) {
                const id = badge.getAttribute('data-board-log-status');
                if (id) syncingIds.push(id);
              }
            });

            if (syncingIds.length === 0) return;

            let pollCount = 0;
            const maxPolls = 15;
            const pollTimer = setInterval(async function () {
              pollCount++;
              if (pollCount > maxPolls) {
                clearInterval(pollTimer);
                return;
              }

              try {
                const res = await fetch('/public/board-logs/status?ids=' + encodeURIComponent(syncingIds.join(',')), {
                  headers: { Accept: 'application/json' },
                });
                if (!res.ok) return;
                const data = await res.json();
                const statuses = Array.isArray(data && data.statuses) ? data.statuses : [];

                let allDone = true;
                statuses.forEach(function (item) {
                  const badge = document.querySelector(`[data-board-log-status="${item.id}"]`);
                  if (!badge) return;

                  const isPending = !item.partner_id || Number(item.partner_id) === 0 || item.customer_name === 'Pending Client Matching';

                  if (item.status === 'synced') {
                    badge.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-semibold px-2.5 py-1';
                    badge.textContent = isPending ? '✓ Synced (Pending Match)' : '✓ Synced to Odoo';
                  } else if (item.status === 'reverted' || item.reverted_at) {
                    badge.className = 'badge bg-secondary-subtle text-secondary border rounded-pill fw-semibold px-2.5 py-1';
                    badge.textContent = 'Cancelled / Reverted';
                  } else if (item.status === 'failed') {
                    badge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-semibold px-2.5 py-1';
                    badge.textContent = 'Sync Pending Retry';
                  } else {
                    allDone = false;
                  }
                });

                if (allDone) {
                  clearInterval(pollTimer);
                }
              } catch (_err) { }
            }, 3500);
          }

          initPublicStatusPolling();
        }) ();
    </script>

    <%- include('partials/footer') %>