<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container py-4 my-2" style="max-width: 1100px;">
  <!-- Public Header Section -->
  <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
    <div class="card-body p-4 p-md-5">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <span class="badge rounded-pill bg-success text-white px-3 py-1 fw-bold" style="font-size: 0.76rem; letter-spacing: 0.04em;">
              LIVE REGISTRY
            </span>
            <span class="badge rounded-pill bg-white text-dark bg-opacity-25 px-3 py-1 fw-semibold" style="font-size: 0.76rem;">
              Public Access · No Login Required
            </span>
          </div>
          <h1 class="h3 fw-bold mb-1 text-white" style="letter-spacing: -0.02em;">Board Intake Logs</h1>
          <p class="text-white-50 small mb-0" style="max-width: 650px; font-size: 0.88rem; line-height: 1.5;">
            Continuous chronological timeline of whole boards received at factory gates and allocated to production cutting orders.
          </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
          <a href="/public/board-logs" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold" title="Refresh logs from database">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            <span>Refresh</span>
          </a>
          <% if (isAuthenticated) { %>
            <a href="/shop-floor/boards" class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Record Boards (App)</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Quick Metrics Summary -->
      <div class="row g-2 mt-4 pt-2 border-top border-secondary border-opacity-25">
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 text-center" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
            <div class="text-white-50 small mb-1" style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Total Sheets</div>
            <div class="h4 fw-bold mb-0 text-white"><%= summary.totalSheets %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 text-center" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25);">
            <div class="text-success-emphasis small mb-1" style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; color: #a7f3d0 !important;">Client Supply</div>
            <div class="h4 fw-bold mb-0" style="color: #6ee7b7;"><%= summary.clientSupplySheets %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 text-center" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.25);">
            <div class="text-primary-emphasis small mb-1" style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; color: #bfdbfe !important;">PO Purchases</div>
            <div class="h4 fw-bold mb-0" style="color: #93c5fd;"><%= summary.purchaseSheets %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 text-center" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
            <div class="text-white-50 small mb-1" style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Total Deliveries</div>
            <div class="h4 fw-bold mb-0 text-white"><%= summary.totalLogs %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls Toolbar -->
  <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
    <div class="card-body p-3 p-md-4">
      <div class="row g-3 align-items-center">
        <!-- Search Input with Instant Filtering -->
        <div class="col-12 col-md-6 col-lg-7">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <input
              type="text"
              id="boardSearchInput"
              class="form-control bg-light border-start-0 rounded-end-pill py-2 text-dark"
              placeholder="Search by client, board material, vehicle, gate, PO, or operator..."
              value="<%= initialSearch || '' %>"
              aria-label="Search board logs"
              style="font-size: 0.88rem;"
            />
          </div>
        </div>

        <!-- Filter Pills & Date Selector -->
        <div class="col-12 col-md-6 col-lg-5">
          <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
            <!-- Supply Type Filter Buttons -->
            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border shadow-none" role="group" aria-label="Filter supply type" id="supplyFilterGroup">
              <button type="button" class="btn btn-sm rounded-pill px-3 py-1 active fw-semibold" data-supply-filter="all">All</button>
              <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold" data-supply-filter="client">Client</button>
              <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold" data-supply-filter="purchase">PO</button>
            </div>

            <!-- Date Jump Dropdown -->
            <% if (dateGroups && dateGroups.length > 1) { %>
              <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 dropdown-toggle fw-semibold d-inline-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.82rem;">
                  <span>Jump to Date</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border rounded-3 p-2" style="max-height: 350px; overflow-y: auto; min-width: 240px; font-size: 0.84rem;">
                  <li><h6 class="dropdown-header text-uppercase text-muted px-2 py-1" style="font-size: 0.70rem;">Jump to Day</h6></li>
                  <% dateGroups.forEach(g => { %>
                    <li>
                      <a class="dropdown-item rounded-2 py-1.5 d-flex justify-content-between align-items-center" href="#date-<%= g.date %>">
                        <span><%= g.dayLabel %>, <%= g.formattedDate %></span>
                        <span class="badge rounded-pill bg-light text-secondary border ms-2"><%= g.totalSheets %></span>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Continuous Board Log Stream Grouped by Date -->
  <div id="boardLogStream">
    <% if (!dateGroups || dateGroups.length === 0) { %>
      <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white" style="border: 1px solid #e2e8f0 !important;">
        <div class="text-muted mb-3">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" class="text-secondary"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h2 class="h5 fw-bold text-dark mb-1">No board logs recorded yet</h2>
        <p class="text-secondary small mb-0">Gate intake entries will appear here chronologically grouped by arrival date.</p>
      </div>
    <% } else { %>
      <% dateGroups.forEach((group) => { %>
        <section class="board-date-section mb-4" id="date-<%= group.date %>" data-date="<%= group.date %>">
          <!-- Date Subcategory Sticky Header -->
          <div class="board-date-header sticky-top py-2.5 px-3 px-md-4 mb-2.5 rounded-4 d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm"
               style="background: #ffffff; border: 1px solid #cbd5e1; top: 68px; z-index: 10;">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="fs-5" style="line-height: 1;">📅</span>
              <h2 class="h6 fw-bold mb-0 text-dark d-inline" style="font-size: 0.98rem; letter-spacing: -0.01em;">
                <%= group.dayLabel %>, <%= group.formattedDate %>
              </h2>
              <% if (group.isToday) { %>
                <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 0.70rem; letter-spacing: 0.03em;">TODAY</span>
              <% } else if (group.isYesterday) { %>
                <span class="badge bg-secondary text-white rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 0.70rem; letter-spacing: 0.03em;">YESTERDAY</span>
              <% } %>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="badge rounded-pill bg-dark text-white fw-bold px-3 py-1.5" style="font-size: 0.78rem;">
                <%= group.totalSheets %> <%= group.totalSheets === 1 ? 'Sheet' : 'Sheets' %> Total
              </span>
              <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1" style="font-size: 0.74rem;">
                <span class="visible-count"><%= group.entries.length %></span> <%= group.entries.length === 1 ? 'log' : 'logs' %>
              </span>
              <% if (group.clientSupplySheets > 0) { %>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">
                  <%= group.clientSupplySheets %> Client
                </span>
              <% } %>
              <% if (group.purchaseSheets > 0) { %>
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">
                  <%= group.purchaseSheets %> PO
                </span>
              <% } %>
            </div>
          </div>

          <!-- Entries List under Date Subcategory -->
          <div class="board-entries-container d-flex flex-column gap-2">
            <% group.entries.forEach((item) => { 
                 const isPurchase = Boolean(item.is_purchase);
                 const status = String(item.status || 'synced').toLowerCase();
            %>
              <div class="board-log-entry-card border rounded-3 p-3 bg-white shadow-sm"
                   data-entry-id="<%= item.id %>"
                   data-client="<%= (item.customer_name || '').toLowerCase() %>"
                   data-product="<%= (item.product_name || '').toLowerCase() %>"
                   data-vehicle="<%= (item.vehicle_registration || '').toLowerCase() %>"
                   data-po="<%= (item.purchase_order_reference || '').toLowerCase() %>"
                   data-gate="<%= (item.gate || '').toLowerCase() %>"
                   data-operator="<%= (item.actor_name || '').toLowerCase() %>"
                   data-supply="<%= isPurchase ? 'purchase' : 'client' %>"
                   style="border-left: 4.5px solid <%= isPurchase ? '#2563eb' : '#059669' %> !important; border-color: #cbd5e1 !important; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                  <div style="flex: 1 1 300px;">
                    <!-- Line 1: Quantity × Product Name & Supply Badge -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                      <strong class="text-dark" style="font-size: 0.96rem;">
                        <%= item.quantity %> × <%= item.product_name %>
                      </strong>
                      <% if (isPurchase) { %>
                        <span class="badge bg-primary text-white border-0 shadow-sm rounded-pill" style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;" title="Company Purchase (PO-backed)">
                          📦 COMPANY PURCHASE
                        </span>
                        <% if (item.purchase_order_reference) { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-semibold" style="font-size: 0.72rem;">
                            PO: <%= item.purchase_order_reference %>
                          </span>
                        <% } %>
                      <% } else { %>
                        <span class="badge text-white border-0 shadow-sm rounded-pill" style="background-color: #059669 !important; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;" title="Client Supplied Boards (Customer Provided)">
                          📦 CLIENT SUPPLY
                        </span>
                      <% } %>
                    </div>

                    <!-- Line 2: Customer, Source Tag & Gate Details -->
                    <div class="small mt-1 text-secondary" style="font-size: 0.84rem; line-height: 1.45;">
                      <span class="fw-bold" style="color: #0f172a;"><%= item.customer_name %></span>
                      <% if (isPurchase) { %>
                        <span class="badge bg-light text-primary border border-primary-subtle px-1.5 py-0.5 ms-1" style="font-size: 0.68rem; font-weight: 600;">Company Procured</span>
                      <% } else { %>
                        <span class="badge bg-light text-success border border-success-subtle px-1.5 py-0.5 ms-1" style="font-size: 0.68rem; font-weight: 600;">Customer's Own Material</span>
                      <% } %>
                      <span class="text-muted">·</span>
                      <span style="color: #475569;"><%= item.created_at %></span>
                      <% if (item.arrival_time) { %>
                        <span class="text-muted">·</span>
                        <span>Arrived: <strong><%= item.arrival_time %></strong></span>
                      <% } %>
                      <% if (item.vehicle_registration) { %>
                        <span class="text-muted">·</span>
                        <span>Vehicle: <strong><%= item.vehicle_registration %></strong></span>
                      <% } %>
                      <% if (item.gate) { %>
                        <span class="text-muted">·</span>
                        <span>Gate: <strong><%= item.gate %></strong></span>
                      <% } %>
                      <% if (item.actor_name) { %>
                        <span class="text-muted">·</span>
                        <span>Logged by <strong style="color: #0f172a;"><%= item.actor_name %></strong></span>
                      <% } %>
                    </div>
                  </div>

                  <!-- Status Badge -->
                  <div class="text-end flex-shrink-0">
                    <% if (status === 'synced') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-semibold px-2.5 py-1" style="font-size: 0.74rem;">
                        ✓ Synced to Odoo
                      </span>
                    <% } else if (status === 'reverted') { %>
                      <span class="badge bg-secondary-subtle text-secondary border rounded-pill fw-semibold px-2.5 py-1" style="font-size: 0.74rem;" title="<%= item.reverted_at ? 'Reverted at ' + item.reverted_at : '' %>">
                        Cancelled / Reverted
                      </span>
                    <% } else if (status === 'failed') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-semibold px-2.5 py-1" style="font-size: 0.74rem;">
                        Sync Pending Retry
                      </span>
                    <% } else { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill fw-semibold px-2.5 py-1" style="font-size: 0.74rem;">
                        ⏳ Syncing
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </section>
      <% }); %>
    <% } %>

    <!-- Empty Search State -->
    <div id="noSearchMatchAlert" class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white d-none" style="border: 1px solid #e2e8f0 !important;">
      <div class="text-muted mb-3">
        <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <h3 class="h6 fw-bold text-dark mb-1">No matching board logs found</h3>
      <p class="text-secondary small mb-3">No board intake entries matched your current search and filter criteria.</p>
      <div>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" id="clearSearchBtn">
          Reset Filter &amp; Show All
        </button>
      </div>
    </div>
  </div>
</main>

<script>
  (function () {
    const searchInput = document.getElementById('boardSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const stream = document.getElementById('boardLogStream');
    const noMatchAlert = document.getElementById('noSearchMatchAlert');
    const filterButtons = document.querySelectorAll('#supplyFilterGroup button');

    let currentSupplyFilter = 'all';

    function applyFilters() {
      const query = (searchInput.value || '').trim().toLowerCase();
      const sections = document.querySelectorAll('.board-date-section');
      let totalVisible = 0;

      sections.forEach(function (section) {
        const cards = section.querySelectorAll('.board-log-entry-card');
        let visibleInSection = 0;

        cards.forEach(function (card) {
          const client = card.getAttribute('data-client') || '';
          const product = card.getAttribute('data-product') || '';
          const vehicle = card.getAttribute('data-vehicle') || '';
          const po = card.getAttribute('data-po') || '';
          const gate = card.getAttribute('data-gate') || '';
          const operator = card.getAttribute('data-operator') || '';
          const supply = card.getAttribute('data-supply') || '';

          const matchesSupply = currentSupplyFilter === 'all' || supply === currentSupplyFilter;
          const matchesQuery = !query ||
            client.includes(query) ||
            product.includes(query) ||
            vehicle.includes(query) ||
            po.includes(query) ||
            gate.includes(query) ||
            operator.includes(query);

          if (matchesSupply && matchesQuery) {
            card.classList.remove('d-none');
            visibleInSection++;
            totalVisible++;
          } else {
            card.classList.add('d-none');
          }
        });

        const countBadge = section.querySelector('.visible-count');
        if (countBadge) {
          countBadge.textContent = visibleInSection;
        }

        if (visibleInSection > 0) {
          section.classList.remove('d-none');
        } else {
          section.classList.add('d-none');
        }
      });

      if (noMatchAlert) {
        if (totalVisible === 0 && (query || currentSupplyFilter !== 'all')) {
          noMatchAlert.classList.remove('d-none');
        } else {
          noMatchAlert.classList.add('d-none');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        currentSupplyFilter = 'all';
        filterButtons.forEach(function (btn) {
          btn.classList.toggle('active', btn.getAttribute('data-supply-filter') === 'all');
          btn.classList.toggle('text-secondary', btn.getAttribute('data-supply-filter') !== 'all');
        });
        applyFilters();
      });
    }

    filterButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterButtons.forEach(function (b) {
          b.classList.remove('active');
          b.classList.add('text-secondary');
        });
        btn.classList.add('active');
        btn.classList.remove('text-secondary');
        currentSupplyFilter = btn.getAttribute('data-supply-filter') || 'all';
        applyFilters();
      });
    });

    // Handle deep-link to date anchor (?date=YYYY-MM-DD or #date-YYYY-MM-DD)
    const urlParams = new URLSearchParams(window.location.search);
    const targetDate = urlParams.get('date');
    const hash = window.location.hash;

    const targetDateId = targetDate ? ('date-' + targetDate) : (hash ? hash.replace('#', '') : null);

    if (targetDateId) {
      const targetEl = document.getElementById(targetDateId);
      if (targetEl) {
        setTimeout(function () {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          const header = targetEl.querySelector('.board-date-header');
          if (header) {
            header.style.transition = 'box-shadow 0.4s ease, border-color 0.4s ease, background 0.4s ease';
            header.style.borderColor = '#059669';
            header.style.boxShadow = '0 0 0 4px rgba(5, 150, 105, 0.25)';
            header.style.background = '#f0fdf4';
            setTimeout(function () {
              header.style.borderColor = '#cbd5e1';
              header.style.boxShadow = '';
              header.style.background = '#ffffff';
            }, 3500);
          }
        }, 300);
      }
    }
  })();
</script>

<%- include('partials/footer') %>
