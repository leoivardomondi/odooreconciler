<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Staff Onboarding | Urban Vibe</title><link rel="stylesheet" href="/public/vendor/bootstrap/bootstrap.min.css"><link rel="stylesheet" href="/public/css/app.css"><style>
body{background:#f5f7fb;color:#22213f}.onboard-shell{min-height:100vh;display:grid;grid-template-columns:minmax(260px,34%) 1fr}.onboard-aside{background:#22213f;color:#fff;padding:clamp(2rem,5vw,5rem);display:flex;flex-direction:column;justify-content:space-between}.onboard-aside h1{font-size:clamp(2rem,4vw,3.8rem);line-height:1.02}.onboard-main{padding:clamp(1.25rem,4vw,4rem);overflow:auto}.onboard-form{max-width:820px;margin:auto}.phase{display:none}.phase.is-active{display:block}.phase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.phase-grid .wide{grid-column:1/-1}.step-rail{display:flex;gap:.5rem;margin:0 0 2rem}.step-dot{height:5px;flex:1;border-radius:9px;background:#dbe2ea}.step-dot.active{background:#cf8464}.form-control,.form-select{min-height:3.15rem;border-radius:12px;border-color:#dbe2ea}.form-label{font-size:.78rem;font-weight:700;color:#475569}.phase-actions{display:flex;justify-content:space-between;margin-top:2rem}.privacy{font-size:.78rem;color:#94a3b8}@media(max-width:800px){.onboard-shell{grid-template-columns:1fr}.onboard-aside{padding:1.5rem;min-height:230px}.phase-grid{grid-template-columns:1fr}.phase-grid .wide{grid-column:auto}}
</style></head><body><main class="onboard-shell"><aside class="onboard-aside"><div><div class="mb-4 fw-bold" style="letter-spacing:.14em;color:#cf8464">URBAN VIBE</div><h1>Tell us about yourself.</h1><p class="mt-4 text-white-50">Provide your personal details carefully. HR will complete your role and employment terms after review.</p></div><p class="privacy mb-0">Your personal, statutory and banking details are submitted securely to the company HR workflow.</p></aside><section class="onboard-main"><form method="post" action="/staff-onboarding" class="onboard-form" id="onboardingForm"><input name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px"><div class="step-rail"><span class="step-dot active"></span><span class="step-dot"></span><span class="step-dot"></span></div>
<% if (submitted) { %><div class="alert alert-success rounded-4 p-4"><h2 class="h4">Application received</h2><p class="mb-0">Your details have been submitted for review. HR will contact you after approval.</p></div><% } %><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<section class="phase is-active"><h2>Personal details</h2><p class="text-muted mb-4">Identity, contact and emergency information.</p><div class="phase-grid"><label class="wide"><span class="form-label">Full legal name *</span><input class="form-control" name="fullName" required></label><label><span class="form-label">Personal email *</span><input class="form-control" type="email" name="personalEmail" required></label><label><span class="form-label">Mobile phone *</span><input class="form-control" name="mobilePhone" required></label><label><span class="form-label">Date of birth</span><input class="form-control" type="date" name="birthday"></label><label><span class="form-label">Gender</span><select class="form-select" name="gender"><option value="">Select</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select></label><label><span class="form-label">Marital status</span><select class="form-select" name="marital"><option value="single">Single</option><option value="married">Married</option><option value="widower">Widowed</option><option value="divorced">Divorced</option></select></label><label><span class="form-label">National ID *</span><input class="form-control" name="identificationId" required></label><label><span class="form-label">Passport number</span><input class="form-control" name="passportId"></label><label><span class="form-label">Street/address</span><input class="form-control" name="street"></label><label><span class="form-label">Town/city</span><input class="form-control" name="city"></label><label><span class="form-label">County</span><input class="form-control" name="county"></label><label><span class="form-label">Emergency contact and relationship</span><input class="form-control" name="emergencyContact"></label><label><span class="form-label">Emergency phone</span><input class="form-control" name="emergencyPhone"></label></div></section>
<section class="phase"><h2>Statutory and banking details</h2><p class="text-muted mb-4">Your Kenyan statutory registrations and salary-payment account.</p><div class="phase-grid"><label><span class="form-label">KRA PIN</span><input class="form-control" name="kraPin"></label><label><span class="form-label">NSSF number</span><input class="form-control" name="nssfNumber"></label><label><span class="form-label">SHA number</span><input class="form-control" name="shaNumber"></label><label><span class="form-label">Bank name</span><input class="form-control" name="bankName"></label><label><span class="form-label">Bank account number</span><input class="form-control" name="bankAccount"></label><label><span class="form-label">Branch</span><input class="form-control" name="bankBranch"></label></div></section>
<section class="phase"><h2>Background and confirmation</h2><p class="text-muted mb-4">Complete your education details and verify the information supplied.</p><div class="phase-grid"><label><span class="form-label">Field of study</span><input class="form-control" name="education"></label><label><span class="form-label">School or institution</span><input class="form-control" name="school"></label><label class="wide"><span class="form-label">Additional notes</span><textarea class="form-control" rows="4" name="notes"></textarea></label><label class="wide d-flex gap-2 align-items-start"><input type="checkbox" required class="mt-1"><span>I confirm that the information provided is accurate and may be used to create my employment and payroll records after approval.</span></label></div></section>
<div class="phase-actions"><button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="backBtn" disabled>Back</button><button type="button" class="btn rounded-pill px-5 text-white" style="background:#cf8464" id="nextBtn">Continue</button></div></form></section></main><script>const phases=[...document.querySelectorAll('.phase')],dots=[...document.querySelectorAll('.step-dot')],back=document.getElementById('backBtn'),next=document.getElementById('nextBtn'),form=document.getElementById('onboardingForm');let step=0;function draw(){phases.forEach((p,i)=>p.classList.toggle('is-active',i===step));dots.forEach((d,i)=>d.classList.toggle('active',i<=step));back.disabled=step===0;next.textContent=step===phases.length-1?'Submit application':'Continue'}back.onclick=()=>{step--;draw()};next.onclick=()=>{const fields=[...phases[step].querySelectorAll('input,select,textarea')];if(!fields.every(f=>f.reportValidity()))return;if(step<phases.length-1){step++;draw();scrollTo({top:0,behavior:'smooth'})}else form.requestSubmit()};draw();</script></body></html>
