<%- include('partials/header', { pageTitle: 'Daily Board Report', currentPath: '/reports/daily-boards' }) %>

<main class="container py-4" style="max-width: 1240px;">
  <!-- Header Bar -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="h3 fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">📊 Daily Board Intake &amp; Order Report</h1>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.76rem;">Daily Comparison</span>
      </div>
      <p class="text-secondary small mb-0">
        Comparing physical board intake vs active cutting orders per client · Highlighting unlogged and company-purchased boards.
      </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
      <!-- Date Selector Form -->
      <form method="get" action="/reports/daily-boards" class="d-flex align-items-center gap-1.5" id="dateFilterForm">
        <div class="input-group input-group-sm rounded-pill border bg-white shadow-sm overflow-hidden" style="border-color: #cbd5e1 !important;">
          <span class="input-group-text bg-white border-0 pe-1 text-muted">📅</span>
          <input
            type="date"
            name="date"
            id="reportDateInput"
            class="form-control form-control-sm border-0 ps-1 fw-semibold text-dark"
            value="<%= report.reportDate %>"
            onchange="document.getElementById('dateFilterForm').submit();"
            style="font-size: 0.85rem; outline: none; box-shadow: none;"
          >
        </div>
      </form>

      <a href="/reports/daily-boards?date=<%= report.reportDate %>&refresh=true" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 shadow-sm fw-semibold" title="Refresh data from Odoo and MySQL">
        ↻ Refresh
      </a>

      <a href="/reports/daily-boards/pdf?date=<%= report.reportDate %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 shadow-sm fw-bold d-inline-flex align-items-center gap-1" target="_blank" title="Download Executive PDF Report">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Download PDF</span>
      </a>

      <a href="/shop-floor/boards" class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 shadow-sm fw-semibold">
        ← Shop Floor Boards
      </a>
    </div>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 mb-4 px-4 py-3 shadow-sm" role="alert">
      <strong>✓ Success:</strong> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 mb-4 px-4 py-3 shadow-sm" role="alert">
      <strong>Error:</strong> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Top KPI Cards -->
  <div class="row g-3 mb-4">
    <!-- Card 1: Total Confirmed Orders Required -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white" style="border-left: 4.5px solid #2563eb !important; border: 1px solid #e2e8f0;">
        <div class="small text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Confirmed Orders</div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <span class="fs-3 fw-bold text-dark"><%= report.totalBoardsNeeded %></span>
          <span class="small text-secondary fw-semibold">boards needed</span>
        </div>
        <div class="small text-muted mt-2" style="font-size: 0.76rem;">
          Across <strong><%= report.totalConfirmedMos %></strong> active cutting MOs (<%= report.totalClientsWithOrders %> clients)
        </div>
      </div>
    </div>

    <!-- Card 2: Total Logged on Date -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white" style="border-left: 4.5px solid #16a34a !important; border: 1px solid #e2e8f0;">
        <div class="small text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Logged On <%= report.reportDate %></div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <span class="fs-3 fw-bold text-success"><%= report.totalBoardsLoggedToday %></span>
          <span class="small text-secondary fw-semibold">boards logged</span>
        </div>
        <div class="small text-muted mt-2" style="font-size: 0.76rem;">
          Gate intakes + done warehouse PO deliveries
        </div>
      </div>
    </div>

    <!-- Card 3: Deficit / Not Yet Logged -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white" style="border-left: 4.5px solid <%= report.totalBoardsNotYetLogged > 0 ? '#dc2626' : '#16a34a' %> !important; border: 1px solid #e2e8f0;">
        <div class="small text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Deficit (Not Yet Logged)</div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <span class="fs-3 fw-bold <%= report.totalBoardsNotYetLogged > 0 ? 'text-danger' : 'text-success' %>"><%= report.totalBoardsNotYetLogged %></span>
          <span class="small text-secondary fw-semibold">boards missing</span>
        </div>
        <div class="small text-muted mt-2" style="font-size: 0.76rem;">
          <%= report.totalBoardsNotYetLogged > 0 ? 'Awaiting gate arrival or PO receipt' : 'All active cutting MOs fully covered' %>
        </div>
      </div>
    </div>

    <!-- Card 4: Especially Purchased Deficit -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white" style="border-left: 4.5px solid #ea580c !important; border: 1px solid #e2e8f0;">
        <div class="small text-muted fw-bold text-uppercase d-flex justify-content-between" style="font-size: 0.72rem; letter-spacing: 0.04em;">
          <span>🛒 Purchased (PO) Deficit</span>
          <% if (report.purchasedTotals.unapprovedPoCount > 0) { %>
            <span class="badge bg-danger text-white rounded-pill" style="font-size:0.65rem;"><%= report.purchasedTotals.unapprovedPoCount %> Unapproved PO</span>
          <% } %>
        </div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <span class="fs-3 fw-bold text-warning-emphasis"><%= report.purchasedTotals.notYetLogged %></span>
          <span class="small text-secondary fw-semibold">of <%= report.purchasedTotals.expected %> PO sheets missing</span>
        </div>
        <div class="small text-muted mt-2" style="font-size: 0.76rem;">
          <strong><%= report.purchasedTotals.activePoCount %></strong> purchase orders tied to active cutting
        </div>
      </div>
    </div>
  </div>

  <!-- Highlight Box: Company-Purchased Boards Status (Especially Purchased!) -->
  <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" style="border: 1px solid #fed7aa !important; background: #fffaf0;">
    <div class="card-header border-0 bg-transparent py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2" style="border-bottom: 1px solid #ffedd5 !important;">
      <div>
        <div class="d-flex align-items-center gap-2">
          <span class="fs-5">🛒</span>
          <h2 class="h5 fw-bold text-dark mb-0" style="font-size: 1.05rem;">Company-Purchased Boards (PO Backed)</h2>
          <span class="badge bg-warning text-dark fw-bold rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">High Priority</span>
        </div>
        <p class="text-secondary small mb-0 mt-0.5">
          Cutting orders where material is procured by Urban Vibe from external vendors.
        </p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-secondary border px-3 py-1.5 rounded-pill fw-semibold shadow-sm" style="font-size: 0.78rem;">
          <%= report.purchasedTotals.expected %> Needed · <%= report.purchasedTotals.logged %> Logged · <span class="text-danger fw-bold"><%= report.purchasedTotals.notYetLogged %> Missing</span>
        </span>
      </div>
    </div>
    <div class="card-body p-0">
      <% const poClients = report.clients.filter(c => c.purchased.items.length > 0); %>
      <% if (poClients.length === 0) { %>
        <div class="text-center py-4 px-3 text-muted small">
          ✓ No active cutting orders currently have missing company-purchased boards.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light" style="font-size: 0.76rem; text-transform: uppercase; color: #475569; letter-spacing: 0.03em;">
              <tr>
                <th class="ps-4 py-2.5">Client &amp; Order</th>
                <th class="py-2.5">Board Material</th>
                <th class="py-2.5">Purchase Order &amp; Supplier</th>
                <th class="text-center py-2.5">Needed</th>
                <th class="text-center py-2.5">Missing</th>
                <th class="pe-4 py-2.5">PO / Delivery Status</th>
              </tr>
            </thead>
            <tbody>
              <% poClients.forEach(client => { %>
                <% client.purchased.items.forEach(item => { %>
                  <tr>
                    <td class="ps-4 py-3">
                      <strong class="text-dark d-block"><%= client.clientName %></strong>
                      <span class="text-muted small"><%= item.moName %> <% if (item.soName) { %>(<%= item.soName %>)<% } %></span>
                    </td>
                    <td class="py-3">
                      <span class="fw-semibold text-dark"><%= item.productName %></span>
                    </td>
                    <td class="py-3">
                      <div class="fw-bold text-primary"><%= item.poName %></div>
                      <div class="text-muted small"><%= item.supplierName %></div>
                    </td>
                    <td class="text-center py-3 fw-semibold">
                      <%= item.qtyNeeded %>
                    </td>
                    <td class="text-center py-3">
                      <% if (item.qtyMissing > 0) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-bold px-2.5 py-1">
                          <%= item.qtyMissing %> missing
                        </span>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-bold px-2.5 py-1">
                          ✓ Covered
                        </span>
                      <% } %>
                    </td>
                    <td class="pe-4 py-3">
                      <% if (item.poState === 'draft' || item.poState === 'to approve') { %>
                        <span class="badge bg-danger text-white rounded-pill fw-bold px-2.5 py-1" title="Purchase Order requires approval before supplier can deliver">
                          ⚠️ Needs PO Approval
                        </span>
                      <% } else if (item.qtyMissing > 0) { %>
                        <span class="badge bg-warning text-dark rounded-pill fw-bold px-2.5 py-1">
                          🚚 Awaiting Delivery
                        </span>
                      <% } else { %>
                        <span class="badge bg-success text-white rounded-pill fw-bold px-2.5 py-1">
                          ✓ Received in Stock
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Unallocated / Owner Unknown Logged Today (if any) -->
  <% if (report.unknownOwnerLogs && report.unknownOwnerLogs.length > 0) { %>
    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" style="border: 1px solid #fde047 !important; background: #fefce8;">
      <div class="card-body p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-2.5">
          <span class="fs-4">❓</span>
          <div>
            <div class="fw-bold text-dark" style="font-size: 0.95rem;">
              <%= report.unknownOwnerTotalSheets %> boards logged today with Owner Unknown (Pending Client Matching)
            </div>
            <div class="text-secondary small">
              Operators logged these at the gate without an assigned customer. Any staff member can match them to an active order.
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/shop-floor/boards#recentBoardLogsSection" class="btn btn-sm btn-warning rounded-pill fw-bold px-3 py-1.5 shadow-sm">
            🔗 Match Client Now
          </a>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Search & Filter Controls -->
  <div class="card border-0 rounded-4 shadow-sm p-3 mb-4 bg-white" style="border: 1px solid #e2e8f0 !important;">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-5">
        <div class="input-group input-group-sm rounded-pill border overflow-hidden" style="border-color: #cbd5e1 !important;">
          <span class="input-group-text bg-white border-0 pe-1 text-muted">🔍</span>
          <input
            type="text"
            id="reportSearchInput"
            class="form-control border-0 ps-1"
            placeholder="Filter by client name, board material, PO reference..."
            style="font-size: 0.88rem; outline: none; box-shadow: none;"
          >
        </div>
      </div>
      <div class="col-12 col-md-7">
        <div class="d-flex flex-wrap justify-content-md-end gap-1.5" id="reportFilterGroup">
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 active fw-semibold btn-filter" data-filter="all">All Clients (<%= report.clients.length %>)</button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold btn-filter" data-filter="purchased">PO Purchased Only (<%= poClients.length %>)</button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold btn-filter" data-filter="missing">With Deficit (<%= report.clients.filter(c => c.totalBoardsNotYetLogged > 0).length %>)</button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold btn-filter" data-filter="logged-today">Logged Today (<%= report.clients.filter(c => c.totalLoggedToday > 0).length %>)</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-by-Client Breakdown Cards -->
  <div class="d-flex flex-column gap-3" id="clientCardsContainer">
    <% if (report.clients.length === 0) { %>
      <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white" style="border: 1px solid #e2e8f0 !important;">
        <h3 class="h5 fw-bold text-dark mb-1">No confirmed cutting orders or board logs found for this date</h3>
        <p class="text-secondary small mb-0">Select another date from the date selector above or click refresh.</p>
      </div>
    <% } %>

    <% report.clients.forEach(client => { 
         const hasMissing = client.totalBoardsNotYetLogged > 0;
         const hasPurchased = client.purchased.items.length > 0;
         const hasLogsToday = client.totalLoggedToday > 0;
    %>
      <div class="client-report-card card border-0 rounded-4 shadow-sm overflow-hidden bg-white"
           data-client-name="<%= client.clientName.toLowerCase() %>"
           data-has-missing="<%= hasMissing ? 'true' : 'false' %>"
           data-has-purchased="<%= hasPurchased ? 'true' : 'false' %>"
           data-has-logs-today="<%= hasLogsToday ? 'true' : 'false' %>"
           style="border: 1px solid #cbd5e1 !important; border-left: 5px solid <%= hasMissing ? '#ea580c' : '#16a34a' %> !important;">
        
        <!-- Client Card Header -->
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h3 class="h6 fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                <%= client.clientName %>
              </h3>
              <% if (hasPurchased) { %>
                <span class="badge bg-primary text-white rounded-pill px-2 py-0.5 fw-bold" style="font-size: 0.68rem;">🛒 HAS PO PURCHASES</span>
              <% } %>
              <% if (hasLogsToday) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">✓ <%= client.totalLoggedToday %> Logged Today</span>
              <% } %>
            </div>
            <div class="text-muted small mt-1" style="font-size: 0.78rem;">
              Confirmed MOs: <strong><%= client.confirmedMoCount %></strong> · Total Needed: <strong><%= client.totalBoardsNeeded %></strong> · Reserved: <strong><%= client.totalBoardsReserved %></strong>
            </div>
          </div>

          <div class="d-flex align-items-center gap-2">
            <% if (hasMissing) { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-bold px-3 py-1.5" style="font-size: 0.82rem;">
                Deficit: <%= client.totalBoardsNotYetLogged %> Boards Missing
              </span>
            <% } else { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-bold px-3 py-1.5" style="font-size: 0.82rem;">
                ✓ 100% Fully Logged &amp; Covered
              </span>
            <% } %>
          </div>
        </div>

        <!-- Required Components Breakdown -->
        <div class="card-body p-4 pt-1">
          <% if (client.requiredComponents.length > 0) { %>
            <div class="table-responsive mb-3">
              <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="table-light" style="font-size: 0.72rem; text-transform: uppercase; color: #64748b;">
                  <tr>
                    <th class="py-2">MO &amp; SO Reference</th>
                    <th class="py-2">Required Board Component</th>
                    <th class="py-2">Supply Type</th>
                    <th class="text-center py-2">Needed</th>
                    <th class="text-center py-2">Reserved</th>
                    <th class="text-center py-2">Deficit (Missing)</th>
                  </tr>
                </thead>
                <tbody>
                  <% client.requiredComponents.forEach(comp => { %>
                    <tr>
                      <td class="py-2">
                        <strong class="text-dark"><%= comp.moName %></strong>
                        <% if (comp.soName) { %><span class="text-muted small">(<%= comp.soName %>)</span><% } %>
                      </td>
                      <td class="py-2">
                        <span class="fw-semibold text-dark"><%= comp.productName %></span>
                      </td>
                      <td class="py-2">
                        <% if (comp.isPurchase) { %>
                          <span class="badge bg-primary text-white rounded-pill fw-bold px-2 py-0.5" style="font-size: 0.68rem;">🛒 PO Purchase</span>
                          <% if (comp.purchaseDetails) { %>
                            <span class="text-muted small ms-1">(<%= comp.purchaseDetails.poName %> · <%= comp.purchaseDetails.supplierName %>)</span>
                          <% } %>
                        <% } else { %>
                          <span class="badge text-white rounded-pill fw-bold px-2 py-0.5" style="background-color: #059669; font-size: 0.68rem;">📦 Client Supply</span>
                        <% } %>
                      </td>
                      <td class="text-center py-2 fw-semibold"><%= comp.qtyNeeded %></td>
                      <td class="text-center py-2 text-success fw-semibold"><%= comp.qtyReserved %></td>
                      <td class="text-center py-2">
                        <% if (comp.qtyMissing > 0) { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-bold px-2 py-0.5">
                            <%= comp.qtyMissing %> missing
                          </span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success rounded-pill fw-semibold px-2 py-0.5">
                            ✓ OK
                          </span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>

          <!-- Logged Today entries for this client -->
          <% if (client.loggedEntriesToday.length > 0) { %>
            <div class="p-2.5 rounded-3 border bg-light mt-2">
              <div class="small fw-bold text-dark mb-1.5 d-flex align-items-center gap-1.5" style="font-size: 0.78rem;">
                <span>📥</span> Logged on <%= report.reportDate %> for this client (<%= client.totalLoggedToday %> sheets total):
              </div>
              <div class="d-flex flex-wrap gap-2">
                <% client.loggedEntriesToday.forEach(log => { %>
                  <div class="bg-white border rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2 shadow-sm" style="font-size: 0.76rem;">
                    <strong class="text-dark"><%= log.quantity %> × <%= log.productName %></strong>
                    <% if (log.isPurchase) { %>
                      <span class="badge bg-primary text-white rounded-pill" style="font-size: 0.65rem;">PO</span>
                    <% } else { %>
                      <span class="badge bg-success text-white rounded-pill" style="font-size: 0.65rem;">Client</span>
                    <% } %>
                    <% if (log.time) { %><span class="text-muted">@ <%= log.time %></span><% } %>
                    <% if (log.vehicle) { %><span class="text-muted">(<%= log.vehicle %>)</span><% } %>
                    <% if (log.actorName) { %><span class="text-secondary">by <%= log.actorName %></span><% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<script>
  (function() {
    var searchInput = document.getElementById('reportSearchInput');
    var filterButtons = document.querySelectorAll('.btn-filter');
    var cards = document.querySelectorAll('.client-report-card');
    var currentFilter = 'all';

    function applyFilters() {
      var query = (searchInput ? searchInput.value : '').toLowerCase().trim();

      cards.forEach(function(card) {
        var clientName = card.getAttribute('data-client-name') || '';
        var hasMissing = card.getAttribute('data-has-missing') === 'true';
        var hasPurchased = card.getAttribute('data-has-purchased') === 'true';
        var hasLogsToday = card.getAttribute('data-has-logs-today') === 'true';
        var cardText = card.textContent.toLowerCase();

        var matchesQuery = !query || cardText.indexOf(query) !== -1;
        var matchesFilter = true;

        if (currentFilter === 'purchased') {
          matchesFilter = hasPurchased;
        } else if (currentFilter === 'missing') {
          matchesFilter = hasMissing;
        } else if (currentFilter === 'logged-today') {
          matchesFilter = hasLogsToday;
        }

        if (matchesQuery && matchesFilter) {
          card.classList.remove('d-none');
        } else {
          card.classList.add('d-none');
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    filterButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterButtons.forEach(function(b) {
          b.classList.remove('active', 'btn-dark');
          b.classList.add('text-secondary');
        });
        btn.classList.add('active', 'btn-dark');
        btn.classList.remove('text-secondary');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });
  })();
</script>

<%- include('partials/footer') %>

