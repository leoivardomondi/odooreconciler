{
  "name": "SHOP FLOOR",
  "short_name": "SHOP FLOOR",
  "description": "Urban Vibe Shop Floor app for managing work orders, operations, and factory production.",
  "id": "/shop-floor-app",
  "start_url": "/public/shop-floor",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f0f2f5",
  "theme_color": "#714B67",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/public/icons/odoo-shop-floor-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/public/icons/odoo-shop-floor-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/public/icons/odoo-shop-floor-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/public/icons/odoo-shop-floor-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "All Operations",
      "short_name": "Operations",
      "url": "/public/shop-floor",
      "icons": [{ "src": "/public/icons/odoo-shop-floor-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Board Logs",
      "short_name": "Board Logs",
      "url": "/public/board-logs",
      "icons": [{ "src": "/public/icons/odoo-shop-floor-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
