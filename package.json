{
  "name": "odoo-job-summary-extractor-node",
  "version": "1.0.0",
  "description": "Production-ready Node.js + TypeScript web app for extracting Odoo Job Summary PDF data and writing it back to Odoo 19.",
  "main": "server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch server.ts",
    "start": "node server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-force-exit src/**/*.test.ts",
    "verify": "npm run check && npm run build && npm test",
    "export:mysql-dump": "tsx scripts/export-sqlite-to-mysql.ts"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@napi-rs/canvas": "^0.1.100",
    "@types/multer": "^2.1.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.9.0",
    "compression": "^1.8.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.2",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.19.1",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
